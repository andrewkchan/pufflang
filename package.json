{
  "name": "pufflang-selfhost",
  "version": "0.1.0",
  "private": true,
  "description": "Self-hosted Puffscript toolchain targeting LLVM IR",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "jest",
    "dev": "ts-node src/cli.ts",
    "stage1": "ts-node src/cli-stage1.ts"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/tests"
    ],
    "moduleFileExtensions": [
      "ts",
      "tsx",
      "js"
    ]
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^20.17.6",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.3",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.3"
  }
}
