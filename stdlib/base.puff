struct Buffer { data byte~, length int }

struct VecByte { data byte~, length int, cap int }
struct PopByte { vec VecByte, value byte }

struct VecInt { data int~, length int, cap int }
struct PopInt { vec VecInt, value int }

// Generic byte-backed vector for arbitrary element size.
struct Vec { data byte~, length int, cap int, elemSize int }

struct String { data byte~, length int }
struct StringBuilder { buf VecByte }

// --- VecByte helpers ---
def vecbyte_new(cap int) VecByte {
  var c = cap;
  if (c < 1) { c = 1; }
  var data = __malloc__(c);
  return VecByte{data, 0, c};
}

def vecbyte_reserve(v VecByte, need int) VecByte {
  if (need <= v.cap) { return v; }
  var newCap = v.cap * 2;
  if (newCap < need) { newCap = need; }
  var newData = __malloc__(newCap);
  var i = 0;
  while (i < v.length) {
    (newData + i)~ = (v.data + i)~;
    i = i + 1;
  }
  __free__(v.data);
  return VecByte{newData, v.length, newCap};
}

def vecbyte_push(v VecByte, x byte) VecByte {
  var out = vecbyte_reserve(v, v.length + 1);
  (out.data + out.length)~ = x;
  out.length = out.length + 1;
  return out;
}

def vecbyte_pop(v VecByte) PopByte {
  var out = v;
  out.length = out.length - 1;
  var val = (out.data + out.length)~;
  return PopByte{out, val};
}

// --- VecInt helpers ---
def vecint_new(cap int) VecInt {
  var c = cap;
  if (c < 1) { c = 1; }
  var data = int~(__malloc__(c * 4));
  return VecInt{data, 0, c};
}

def vecint_reserve(v VecInt, need int) VecInt {
  if (need <= v.cap) { return v; }
  var newCap = v.cap * 2;
  if (newCap < need) { newCap = need; }
  var newData = int~(__malloc__(newCap * 4));
  var src = byte~(v.data);
  var dst = byte~(newData);
  var i = 0;
  while (i < v.length) {
    var off = i * 4;
    (int~(dst + off))~ = (int~(src + off))~;
    i = i + 1;
  }
  __free__(byte~(v.data));
  return VecInt{newData, v.length, newCap};
}

def vecint_push(v VecInt, x int) VecInt {
  var out = vecint_reserve(v, v.length + 1);
  var base = byte~(out.data);
  var off = out.length * 4;
  (int~(base + off))~ = x;
  out.length = out.length + 1;
  return out;
}

def vecint_pop(v VecInt) PopInt {
  var out = v;
  out.length = out.length - 1;
  var base = byte~(out.data);
  var off = out.length * 4;
  var val = (int~(base + off))~;
  return PopInt{out, val};
}

def vecint_get(v VecInt, idx int) int {
  var base = byte~(v.data);
  var off = idx * 4;
  return (int~(base + off))~;
}

// Set element at idx for VecInt.
def vecint_set(v VecInt, idx int, value int) VecInt {
  var base = byte~(v.data);
  var off = idx * 4;
  (int~(base + off))~ = value;
  return v;
}

// --- VecStr helpers (store String structs) ---
struct VecStr { data byte~, length int, cap int }
struct PopStr { vec VecStr, value String }

def vecstr_new(cap int) VecStr {
  var c = cap;
  if (c < 1) { c = 1; }
  var data = __malloc__(c * 8); // String is two ints (ptr + length)
  return VecStr{data, 0, c};
}

def vecstr_reserve(v VecStr, need int) VecStr {
  if (need <= v.cap) { return v; }
  var newCap = v.cap * 2;
  if (newCap < need) { newCap = need; }
  var newData = __malloc__(newCap * 8);
  var i = 0;
  while (i < v.length * 8) {
    (newData + i)~ = (v.data + i)~;
    i = i + 1;
  }
  __free__(v.data);
  return VecStr{newData, v.length, newCap};
}

def vecstr_push(v VecStr, s String) VecStr {
  var out = vecstr_reserve(v, v.length + 1);
  var dest = out.data + (out.length * 8);
  var i = 0;
  while (i < 8) {
    (dest + i)~ = (byte~(&s) + i)~;
    i = i + 1;
  }
  out.length = out.length + 1;
  return out;
}

def vecstr_pop(v VecStr) PopStr {
  var out = v;
  out.length = out.length - 1;
  var dest = out.data + (out.length * 8);
  var s = String{__malloc__(1), 0};
  var i = 0;
  while (i < 8) {
    (byte~(&s) + i)~ = (dest + i)~;
    i = i + 1;
  }
  return PopStr{out, s};
}

def vecstr_get(v VecStr, idx int) String {
  var dest = v.data + (idx * 8);
  var s = String{__malloc__(1), 0};
  var i = 0;
  while (i < 8) {
    (byte~(&s) + i)~ = (dest + i)~;
    i = i + 1;
  }
  return s;
}

// --- Generic Vec helpers ---
def vec_new(elemSize int, cap int) Vec {
  var c = cap;
  if (c < 1) { c = 1; }
  var data = __malloc__(elemSize * c);
  return Vec{data, 0, c, elemSize};
}

def vec_reserve(v Vec, need int) Vec {
  if (need <= v.cap) { return v; }
  var newCap = v.cap * 2;
  if (newCap < need) { newCap = need; }
  var newData = __malloc__(newCap * v.elemSize);
  var i = 0;
  while (i < v.length * v.elemSize) {
    (newData + i)~ = (v.data + i)~;
    i = i + 1;
  }
  __free__(v.data);
  return Vec{newData, v.length, newCap, v.elemSize};
}

// Copy elemSize bytes from src into vector end; return updated vector.
def vec_push(v Vec, src byte~) Vec {
  var out = vec_reserve(v, v.length + 1);
  var i = 0;
  var base = out.data + (out.length * out.elemSize);
  while (i < out.elemSize) {
    (base + i)~ = (src + i)~;
    i = i + 1;
  }
  out.length = out.length + 1;
  return out;
}

// Return pointer to element index (no bounds checks).
def vec_get_ptr(v Vec, idx int) byte~ {
  return v.data + (idx * v.elemSize);
}

// Set element at idx by copying elemSize bytes from src.
def vec_set(v Vec, idx int, src byte~) Vec {
  var dest = vec_get_ptr(v, idx);
  var i = 0;
  while (i < v.elemSize) {
    (dest + i)~ = (src + i)~;
    i = i + 1;
  }
  return v;
}

// --- StringBuilder ---
def sb_new() StringBuilder {
  return StringBuilder{vecbyte_new(16)};
}

def sb_append_byte(sb StringBuilder, b byte) StringBuilder {
  var buf = vecbyte_push(sb.buf, b);
  return StringBuilder{buf};
}

def sb_append_bytes(sb StringBuilder, data byte~, n int) StringBuilder {
  var out = sb;
  var i = 0;
  while (i < n) {
    out = sb_append_byte(out, (data + i)~);
    i = i + 1;
  }
  return out;
}

def sb_to_string(sb StringBuilder) String { return String{sb.buf.data, sb.buf.length}; }

def sb_append_string(sb StringBuilder, s String) StringBuilder {
  return sb_append_bytes(sb, s.data, s.length);
}

def sb_clear(sb StringBuilder) StringBuilder {
  var out = sb;
  out.buf.length = 0;
  return out;
}

def sb_append_cstr(sb StringBuilder, s byte~) StringBuilder {
  var n = cstr_len(s);
  return sb_append_bytes(sb, s, n);
}

// Append signed int in decimal.
def sb_append_int(sb StringBuilder, value int) StringBuilder {
  if (value == 0) { return sb_append_byte(sb, byte(48)); }
  var neg = 0;
  var n = value;
  if (n < 0) {
    neg = 1;
    n = 0 - n;
  }
  var tmp = vecbyte_new(16);
  while (n > 0) {
    var digit = n % 10;
    tmp = vecbyte_push(tmp, byte(48 + digit));
    n = n / 10;
  }
  if (neg == 1) {
    tmp = vecbyte_push(tmp, byte(45)); // '-'
  }
  var i = tmp.length - 1;
  var out = sb;
  while (i >= 0) {
    out = sb_append_byte(out, (tmp.data + i)~);
    i = i - 1;
  }
  return out;
}

// Append unsigned int as lowercase hex, zero-padded to width (up to 8).
def sb_append_hex(sb StringBuilder, value int, width int) StringBuilder {
  var tmp = vecbyte_new(16);
  var n = value;
  while (n != 0) {
    var nib = n & 15;
    var c = 0;
    if (nib < 10) { c = 48 + nib; } else { c = 87 + nib; } // 'a' = 97, 97-10=87
    tmp = vecbyte_push(tmp, byte(c));
    n = n >> 4;
  }
  if (tmp.length == 0) {
    tmp = vecbyte_push(tmp, byte(48)); // 0
  }
  while (tmp.length < width) {
    tmp = vecbyte_push(tmp, byte(48));
  }
  var i = tmp.length - 1;
  var out = sb;
  while (i >= 0) {
    out = sb_append_byte(out, (tmp.data + i)~);
    i = i - 1;
  }
  return out;
}

// --- String helpers ---
// C-string length (walk until NUL).
def cstr_len(s byte~) int {
  var i = 0;
  while ((s + i)~ != byte(0)) { i = i + 1; }
  return i;
}

// Clone a C-string (up to NUL).
def cstr_clone(s byte~) String {
  var n = cstr_len(s);
  return str_clone(s, n);
}

def str_eq(a byte~, alen int, b byte~, blen int) int {
  if (alen != blen) { return 0; }
  var i = 0;
  while (i < alen) {
    if ((a + i)~ != (b + i)~) { return 0; }
    i = i + 1;
  }
  return 1;
}

def str_clone(src byte~, n int) String {
  var data = __malloc__(n);
  var i = 0;
  while (i < n) {
    (data + i)~ = (src + i)~;
    i = i + 1;
  }
  return String{data, n};
}

def str_starts_with(a byte~, alen int, b byte~, blen int) int {
  if (blen > alen) { return 0; }
  var i = 0;
  while (i < blen) {
    if ((a + i)~ != (b + i)~) { return 0; }
    i = i + 1;
  }
  return 1;
}

// Returns first index of needle in haystack, or -1.
def str_index_of(hay byte~, hlen int, needle byte~, nlen int) int {
  if (nlen == 0) { return 0; }
  if (nlen > hlen) { return -1; }
  var max = hlen - nlen;
  var i = 0;
  while (i <= max) {
    var j = 0;
    var match = 1;
    while (j < nlen) {
      if ((hay + i + j)~ != (needle + j)~) { match = 0; break; }
      j = j + 1;
    }
    if (match == 1) { return i; }
    i = i + 1;
  }
  return -1;
}

def str_contains(hay byte~, hlen int, needle byte~, nlen int) int {
  var idx = str_index_of(hay, hlen, needle, nlen);
  if (idx >= 0) { return 1; }
  return 0;
}

// Slice without copying; clamps count to bounds.
def str_slice(src byte~, slen int, start int, count int) String {
  if (start < 0) { start = 0; }
  if (start > slen) { start = slen; }
  var maxCount = slen - start;
  if (count < 0) { count = 0; }
  if (count > maxCount) { count = maxCount; }
  return String{src + start, count};
}

// Trim ASCII whitespace (space, tab, CR, LF) from both ends; zero-copy.
def str_trim_ascii(ws byte~, n int) String {
  var start = 0;
  while (start < n) {
    var c = (ws + start)~;
    if (c != byte(32) && c != byte(9) && c != byte(10) && c != byte(13)) { break; }
    start = start + 1;
  }
  var end = n;
  while (end > start) {
    var c2 = (ws + end - 1)~;
    if (c2 != byte(32) && c2 != byte(9) && c2 != byte(10) && c2 != byte(13)) { break; }
    end = end - 1;
  }
  return String{ws + start, end - start};
}

// --- argv/env/time wrappers ---
def argv_count() int { return __argc__(); }

def argv_at(idx int) String {
  var p = __argv_at__(idx);
  return cstr_clone(p);
}

def getenv_clone(key byte~) String {
  var p = __getenv__(key);
  return cstr_clone(p);
}

def time_seconds() int {
  // time(NULL) equivalent; storage can be null but allocate scratch to satisfy type
  var scratch = __malloc__(8);
  return __time__(scratch);
}

// --- File helpers ---
def write_file_all(path byte~, data byte~, length int) int {
  var fd = __open__(path, 577, 420); // O_WRONLY|O_CREAT|O_TRUNC, 0644
  if (fd < 0) { return -1; }
  var written = 0;
  while (written < length) {
    var n = __write__(fd, data + written, length - written);
    if (n <= 0) { __close__(fd); return -1; }
    written = written + n;
  }
  __close__(fd);
  return written;
}

def read_file_all(path byte~) Buffer {
  var fd = __open__(path, 0, 0); // O_RDONLY
  if (fd < 0) {
    var dummy = __malloc__(1);
    return Buffer{dummy, 0};
  }
  var tmp = __malloc__(1024);
  var buf = __malloc__(1024);
  var cap = 1024;
  var length = 0;
  while (true) {
    var n = __read__(fd, tmp, 1024);
    if (n <= 0) { break; }
    while (length + n > cap) {
      var newCap = cap * 2;
      var newBuf = __malloc__(newCap);
      var i = 0;
      while (i < length) {
        (newBuf + i)~ = (buf + i)~;
        i = i + 1;
      }
      __free__(buf);
      buf = newBuf;
      cap = newCap;
    }
    var j = 0;
    while (j < n) {
      (buf + length + j)~ = (tmp + j)~;
      j = j + 1;
    }
    length = length + n;
  }
  __close__(fd);
  __free__(tmp);
  return Buffer{buf, length};
}

// --- Map (int -> int) with open addressing ---
struct Map { data byte~, cap int, length int }
var MAP_EMPTY int = -2147483648;

def map_new(cap int) Map {
  var c = cap;
  if (c < 8) { c = 8; }
  // ensure power of two
  var pow = 8;
  while (pow < c) { pow = pow * 2; }
  c = pow;
  var bytes = c * 8; // each entry: key(int), value(int)
  var data = __malloc__(bytes);
  var i = 0;
  while (i < c) {
    var off = i * 8;
    (int~(data + off))~ = MAP_EMPTY;
    (int~(data + off + 4))~ = 0;
    i = i + 1;
  }
  return Map{data, c, 0};
}

def map_hash(k int, mask int) int {
  // Knuth multiplicative hash
  var h = k * 2654435761;
  return h & mask;
}

def map_resize(m Map, newCap int) Map {
  var newMap = map_new(newCap);
  var i = 0;
  while (i < m.cap) {
    var off = i * 8;
    var key = (int~(m.data + off))~;
    if (key != MAP_EMPTY) {
      var val = (int~(m.data + off + 4))~;
      newMap = map_put(newMap, key, val);
    }
    i = i + 1;
  }
  __free__(m.data);
  return newMap;
}

def map_load_too_high(m Map) int {
  // load factor > 0.7 -> len * 10 >= cap * 7
  if (m.length * 10 >= m.cap * 7) { return 1; }
  return 0;
}

def map_put(m Map, key int, value int) Map {
  var mask = m.cap - 1;
  var idx = map_hash(key, mask);
  while (true) {
    var off = idx * 8;
    var k = (int~(m.data + off))~;
    if (k == MAP_EMPTY || k == key) {
      var newLen = m.length;
      if (k == MAP_EMPTY) { newLen = newLen + 1; }
      (int~(m.data + off))~ = key;
      (int~(m.data + off + 4))~ = value;
      var out = Map{m.data, m.cap, newLen};
      if (map_load_too_high(out) == 1) {
        return map_resize(out, m.cap * 2);
      }
      return out;
    }
    idx = (idx + 1) & mask;
  }
  return m; // unreachable
}

def map_get(m Map, key int) int {
  var mask = m.cap - 1;
  var idx = map_hash(key, mask);
  var start = idx;
  while (true) {
    var off = idx * 8;
    var k = (int~(m.data + off))~;
    if (k == MAP_EMPTY) { return MAP_EMPTY; }
    if (k == key) { return (int~(m.data + off + 4))~; }
    idx = (idx + 1) & mask;
    if (idx == start) { return MAP_EMPTY; }
  }
  return MAP_EMPTY;
}

def map_has(m Map, key int) int {
  var v = map_get(m, key);
  if (v == MAP_EMPTY) { return 0; }
  return 1;
}

def map_delete(m Map, key int) Map {
  var mask = m.cap - 1;
  var idx = map_hash(key, mask);
  var start = idx;
  while (true) {
    var off = idx * 8;
    var k = (int~(m.data + off))~;
    if (k == MAP_EMPTY) { return m; }
    if (k == key) {
      (int~(m.data + off))~ = MAP_EMPTY;
      (int~(m.data + off + 4))~ = 0;
      var out = Map{m.data, m.cap, m.length - 1};
      var next = (idx + 1) & mask;
      while (true) {
        var off2 = next * 8;
        var k2 = (int~(m.data + off2))~;
        if (k2 == MAP_EMPTY) { break; }
        var v2 = (int~(m.data + off2 + 4))~;
        (int~(m.data + off2))~ = MAP_EMPTY;
        (int~(m.data + off2 + 4))~ = 0;
        out = map_put(out, k2, v2);
        next = (next + 1) & mask;
      }
      return out;
    }
    idx = (idx + 1) & mask;
    if (idx == start) { return m; }
  }
  return m;
}

// --- MapStr (string -> int) with open addressing ---
struct MapStr { keys Vec, values VecInt, states VecInt, cap int, length int }
var MAPSTR_EMPTY int = 0;
var MAPSTR_FILLED int = 1;
var MAPSTR_TOMB int = 2;

def mapstr_new(cap int) MapStr {
  var c = cap;
  if (c < 8) { c = 8; }
  var pow = 8;
  while (pow < c) { pow = pow * 2; }
  c = pow;
  var keys = vec_new(8, c);
  keys.length = c;
  var values = vecint_new(c);
  values.length = c;
  var states = vecint_new(c);
  states.length = c;
  var i = 0;
  while (i < c) {
    states = vecint_set(states, i, MAPSTR_EMPTY);
    // zero out key + value slots
    var kptr = vec_get_ptr(keys, i);
    var j = 0;
    while (j < 8) { (kptr + j)~ = byte(0); j = j + 1; }
    values = vecint_set(values, i, 0);
    i = i + 1;
  }
  return MapStr{keys, values, states, c, 0};
}

def mapstr_hash(key String, mask int) int {
  // djb2
  var h = 5381;
  var i = 0;
  while (i < key.length) {
    h = ((h << 5) + h) + int((key.data + i)~);
    i = i + 1;
  }
  return h & mask;
}

def mapstr_key_at(m MapStr, idx int) String {
  var ptr = vec_get_ptr(m.keys, idx);
  var out = String{ptr, 0};
  var i = 0;
  while (i < 8) {
    (byte~(&out) + i)~ = (ptr + i)~;
    i = i + 1;
  }
  return out;
}

def mapstr_set_slot(m MapStr, idx int, key String, value int) MapStr {
  m.keys = vec_set(m.keys, idx, byte~(&key));
  m.values = vecint_set(m.values, idx, value);
  m.states = vecint_set(m.states, idx, MAPSTR_FILLED);
  return m;
}

def mapstr_load_too_high(m MapStr) int {
  if (m.length * 10 >= m.cap * 7) { return 1; }
  return 0;
}

def mapstr_resize(m MapStr, newCap int) MapStr {
  var newMap = mapstr_new(newCap);
  var i = 0;
  while (i < m.cap) {
    var state = vecint_get(m.states, i);
    if (state == MAPSTR_FILLED) {
      var k = mapstr_key_at(m, i);
      var v = vecint_get(m.values, i);
      newMap = mapstr_put(newMap, k, v);
    }
    i = i + 1;
  }
  return newMap;
}

def mapstr_put(m MapStr, key String, value int) MapStr {
  var out = m;
  if (mapstr_load_too_high(out) == 1) {
    out = mapstr_resize(out, out.cap * 2);
  }
  var kclone = str_clone(key.data, key.length);
  var mask = out.cap - 1;
  var idx = mapstr_hash(kclone, mask);
  var firstTomb = -1;
  while (true) {
    var state = vecint_get(out.states, idx);
    if (state == MAPSTR_EMPTY) {
      var useIdx = idx;
      if (firstTomb != -1) { useIdx = firstTomb; }
      out = mapstr_set_slot(out, useIdx, kclone, value);
      out.length = out.length + 1;
      return out;
    }
    if (state == MAPSTR_TOMB) {
      if (firstTomb == -1) { firstTomb = idx; }
    } else { // filled
      var existing = mapstr_key_at(out, idx);
      if (str_eq(existing.data, existing.length, key.data, key.length) == 1) {
        out = mapstr_set_slot(out, idx, kclone, value);
        return out;
      }
    }
    idx = (idx + 1) & mask;
  }
  return out;
}

def mapstr_get(m MapStr, key String) int {
  var mask = m.cap - 1;
  var idx = mapstr_hash(key, mask);
  var start = idx;
  while (true) {
    var state = vecint_get(m.states, idx);
    if (state == MAPSTR_EMPTY) { return MAP_EMPTY; }
    if (state == MAPSTR_FILLED) {
      var existing = mapstr_key_at(m, idx);
      if (str_eq(existing.data, existing.length, key.data, key.length) == 1) {
        return vecint_get(m.values, idx);
      }
    }
    idx = (idx + 1) & mask;
    if (idx == start) { return MAP_EMPTY; }
  }
  return MAP_EMPTY;
}

def mapstr_has(m MapStr, key String) int {
  var v = mapstr_get(m, key);
  if (v == MAP_EMPTY) { return 0; }
  return 1;
}

def mapstr_delete(m MapStr, key String) MapStr {
  var mask = m.cap - 1;
  var idx = mapstr_hash(key, mask);
  var start = idx;
  while (true) {
    var state = vecint_get(m.states, idx);
    if (state == MAPSTR_EMPTY) { return m; }
    if (state == MAPSTR_FILLED) {
      var existing = mapstr_key_at(m, idx);
      if (str_eq(existing.data, existing.length, key.data, key.length) == 1) {
        m.states = vecint_set(m.states, idx, MAPSTR_TOMB);
        m.length = m.length - 1;
        return m;
      }
    }
    idx = (idx + 1) & mask;
    if (idx == start) { return m; }
  }
  return m;
}
