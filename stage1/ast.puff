// Stage1 core AST/type scaffolding using index-based arenas.
// This keeps allocations simple for Puffscript and mirrors Stage0 semantics at a coarse level.

// ---- Type system ----
var TYPECATEGORY_ARRAY int = 0;
var TYPECATEGORY_BOOL int = 1;
var TYPECATEGORY_BYTE int = 2;
var TYPECATEGORY_ERROR int = 3;
var TYPECATEGORY_FLOAT int = 4;
var TYPECATEGORY_INT int = 5;
var TYPECATEGORY_POINTER int = 6;
var TYPECATEGORY_STRUCT int = 7;
var TYPECATEGORY_VOID int = 8;

struct Type { category int, element int, length int, structId int }

struct TypeTable { types Vec }

// Create a new type table with builtin scalar types pre-seeded.
def typetable_new() TypeTable {
  var v = vec_new(16, 16); // reserve space for builtin + composites
  v.length = 0;
  v = typetable_push_raw(v, Type{TYPECATEGORY_ARRAY, -1, 0, -1}); // id 0 placeholder (unused)
  v = typetable_push_raw(v, Type{TYPECATEGORY_BOOL, -1, 0, -1});  // id 1
  v = typetable_push_raw(v, Type{TYPECATEGORY_BYTE, -1, 0, -1});  // id 2
  v = typetable_push_raw(v, Type{TYPECATEGORY_ERROR, -1, 0, -1}); // id 3
  v = typetable_push_raw(v, Type{TYPECATEGORY_FLOAT, -1, 0, -1}); // id 4
  v = typetable_push_raw(v, Type{TYPECATEGORY_INT, -1, 0, -1});   // id 5
  v = typetable_push_raw(v, Type{TYPECATEGORY_POINTER, -1, 0, -1}); // id 6 placeholder
  v = typetable_push_raw(v, Type{TYPECATEGORY_STRUCT, -1, 0, -1}); // id 7 placeholder
  v = typetable_push_raw(v, Type{TYPECATEGORY_VOID, -1, 0, -1}); // id 8
  return TypeTable{v};
}

// Push helper storing a Type into Vec (elemSize = 16 bytes).
def typetable_push_raw(v Vec, t Type) Vec {
  var out = vec_reserve(v, v.length + 1);
  var dest = vec_get_ptr(out, out.length);
  // copy 16 bytes manually (4 ints)
  (int~(dest))~ = t.category;
  (int~(dest + 4))~ = t.element;
  (int~(dest + 8))~ = t.length;
  (int~(dest + 12))~ = t.structId;
  out.length = out.length + 1;
  return out;
}

// Allocate pointer type; returns type id.
def typetable_make_pointer(tt TypeTable, elemId int) TypeTable {
  var t = Type{TYPECATEGORY_POINTER, elemId, 0, -1};
  var v = typetable_push_raw(tt.types, t);
  return TypeTable{v};
}

// Allocate array type; returns updated table.
def typetable_make_array(tt TypeTable, elemId int, length int) TypeTable {
  var t = Type{TYPECATEGORY_ARRAY, elemId, length, -1};
  var v = typetable_push_raw(tt.types, t);
  return TypeTable{v};
}

// Allocate struct type; structId is an index into a struct table maintained elsewhere.
def typetable_make_struct(tt TypeTable, structId int) TypeTable {
  var t = Type{TYPECATEGORY_STRUCT, -1, 0, structId};
  var v = typetable_push_raw(tt.types, t);
  return TypeTable{v};
}

def typetable_get(tt TypeTable, id int) Type {
  var ptr = vec_get_ptr(tt.types, id);
  var cat = (int~(ptr))~;
  var elem = (int~(ptr + 4))~;
  var lengthVal = (int~(ptr + 8))~;
  var sid = (int~(ptr + 12))~;
  return Type{cat, elem, lengthVal, sid};
}

def type_is_numeric(tt TypeTable, id int) int {
  var t = typetable_get(tt, id);
  if (t.category == TYPECATEGORY_INT) { return 1; }
  if (t.category == TYPECATEGORY_FLOAT) { return 1; }
  if (t.category == TYPECATEGORY_BYTE) { return 1; }
  return 0;
}

// Basic equality (ignores resolved struct identity beyond structId).
def type_equals(tt TypeTable, a int, b int) int {
  if (a == b) { return 1; }
  var ta = typetable_get(tt, a);
  var tb = typetable_get(tt, b);
  if (ta.category != tb.category) { return 0; }
  if (ta.category == TYPECATEGORY_ARRAY) {
    if (ta.length != tb.length) { return 0; }
    return type_equals(tt, ta.element, tb.element);
  }
  if (ta.category == TYPECATEGORY_POINTER) {
    return type_equals(tt, ta.element, tb.element);
  }
  if (ta.category == TYPECATEGORY_STRUCT) {
    if (ta.structId == tb.structId) { return 1; }
    return 0;
  }
  return 1;
}

// ---- Node arena ----
// Node fields are generic; interpretation depends on kind.
// ints are indices into other tables (nodes, strings, symbols, types).
struct Node { kind int, a int, b int, c int, d int, value int, typeId int }
struct NodeArena { nodes Vec }

def nodearena_new(cap int) NodeArena {
  var v = vec_new(32, cap);
  v.length = 0;
  return NodeArena{v};
}

def nodearena_push(arena NodeArena, n Node) NodeArena {
  var out = vec_reserve(arena.nodes, arena.nodes.length + 1);
  var dest = vec_get_ptr(out, out.length);
  (int~(dest))~ = n.kind;
  (int~(dest + 4))~ = n.a;
  (int~(dest + 8))~ = n.b;
  (int~(dest + 12))~ = n.c;
  (int~(dest + 16))~ = n.d;
  (int~(dest + 20))~ = n.value;
  (int~(dest + 24))~ = n.typeId;
  (int~(dest + 28))~ = 0; // padding / future use
  out.length = out.length + 1;
  return NodeArena{out};
}

def nodearena_get(arena NodeArena, idx int) Node {
  var ptr = vec_get_ptr(arena.nodes, idx);
  var k = (int~(ptr))~;
  var a = (int~(ptr + 4))~;
  var b = (int~(ptr + 8))~;
  var c = (int~(ptr + 12))~;
  var d = (int~(ptr + 16))~;
  var v = (int~(ptr + 20))~;
  var t = (int~(ptr + 24))~;
  return Node{k, a, b, c, d, v, t};
}

// ---- Node kinds (subset; expand as parser grows) ----
var NODE_LITERAL int = 1;
var NODE_VARIABLE int = 2;
var NODE_BINARY int = 3;
var NODE_CALL int = 4;
var NODE_RETURN int = 5;
var NODE_VAR_STMT int = 6;
var NODE_FUNCTION int = 7;
var NODE_BLOCK int = 8;

// ---- Symbol/scoping scaffolding ----
var SYMKIND_VAR int = 1;
var SYMKIND_PARAM int = 2;
var SYMKIND_FUNCTION int = 3;
var SYMKIND_FUNCTION_OVERLOAD int = 4;
var SYMKIND_STRUCT int = 5;

struct SymInfo { kind int, arityA int, arityB int, typeId int }
struct ScopeResult { scope Scope, err int }

struct Scope {
  names VecStr,   // identifiers
  kinds VecInt,   // SYMKIND_* per name
  arityA VecInt,  // primary arity for functions (or -1)
  arityB VecInt,  // secondary arity for overload (or -1)
  typeIds VecInt, // var type or function return type (or -1)
  parent byte~,   // parent Scope*
  hasParent int
}

def scope_new(parent byte~, hasParent int) Scope {
  return Scope{
    vecstr_new(8),
    vecint_new(8),
    vecint_new(8),
    vecint_new(8),
    vecint_new(8),
    parent,
    hasParent
  };
}

// Root scope convenience constructor (no parent lookup).
def scope_new_root() Scope {
  var dummy = __malloc__(32);
  return scope_new(dummy, 0);
}

// Create a child scope referencing a parent scope (byte pointer to parent).
def scope_child(parent byte~) Scope {
  return scope_new(parent, 1);
}

// Lookup in current scope; returns index or -1.
def scope_lookup_index_current(s Scope, name String) int {
  var i = s.names.length;
  while (i > 0) {
    i = i - 1;
    var n = vecstr_get(s.names, i);
    if (str_eq(n.data, n.length, name.data, name.length) == 1) { return i; }
  }
  return -1;
}

// Define a variable symbol; returns updated scope (duplicate ignored).
def scope_define_var(s Scope, name String, typeId int) ScopeResult {
  var idx = scope_lookup_index_current(s, name);
  if (idx != -1) { return ScopeResult{s, 1}; }
  s.names = vecstr_push(s.names, str_clone(name.data, name.length));
  s.kinds = vecint_push(s.kinds, SYMKIND_VAR);
  s.arityA = vecint_push(s.arityA, -1);
  s.arityB = vecint_push(s.arityB, -1);
  s.typeIds = vecint_push(s.typeIds, typeId);
  return ScopeResult{s, 0};
}

// Define function with arity; handles overload aggregation (max 2). Duplicate arity ignored.
def scope_define_function(s Scope, name String, arity int, returnType int, isExported int, isImported int) ScopeResult {
  var idx = scope_lookup_index_current(s, name);
  if (idx == -1) {
    s.names = vecstr_push(s.names, str_clone(name.data, name.length));
    s.kinds = vecint_push(s.kinds, SYMKIND_FUNCTION);
    s.arityA = vecint_push(s.arityA, arity);
    s.arityB = vecint_push(s.arityB, -1);
    s.typeIds = vecint_push(s.typeIds, returnType);
    return ScopeResult{s, 0};
  }
  var kind = vecint_get(s.kinds, idx);
  if (kind != SYMKIND_FUNCTION && kind != SYMKIND_FUNCTION_OVERLOAD) { return ScopeResult{s, 1}; }
  var a = vecint_get(s.arityA, idx);
  var b = vecint_get(s.arityB, idx);
  if (a == arity || b == arity) { return ScopeResult{s, 1}; }
  if (b == -1) {
    vecint_set(s.arityB, idx, arity);
    vecint_set(s.kinds, idx, SYMKIND_FUNCTION_OVERLOAD);
    return ScopeResult{s, 0};
  }
  return ScopeResult{s, 1};
}

// Lookup through parents; returns index in found scope or -1.
def scope_lookup(s Scope, name String) int {
  var idx = scope_lookup_index_current(s, name);
  if (idx != -1) { return idx; }
  return -1;
}

// Get symbol info by index in this scope.
def scope_get_info(s Scope, idx int) SymInfo {
  var kind = vecint_get(s.kinds, idx);
  var a = vecint_get(s.arityA, idx);
  var b = vecint_get(s.arityB, idx);
  var t = vecint_get(s.typeIds, idx);
  return SymInfo{kind, a, b, t};
}

// Lookup symbol (with parents) and return info (kind=0 if not found).
def scope_lookup_info(s Scope, name String) SymInfo {
  var idx = scope_lookup_index_current(s, name);
  if (idx != -1) { return scope_get_info(s, idx); }
  return SymInfo{0, -1, -1, -1};
}

// ---- Mangling helper (arity-based) ----
// If only one overload and exported, keep name; otherwise append "__<arity>".
def mangle_name(name String, arity int, isExported int, overloadCount int) String {
  if (name.length == 4 &&
      (name.data)~ == byte(109) && (name.data + 1)~ == byte(97) && (name.data + 2)~ == byte(105) && (name.data + 3)~ == byte(110)) {
    // "main" always stays unmangled
    return name;
  }
  if (isExported == 1 && overloadCount == 1) { return name; }
  var sb = sb_new();
  sb = sb_append_string(sb, name);
  sb = sb_append_cstr(sb, byte~(&"__"[0]));
  sb = sb_append_int(sb, arity);
  return sb_to_string(sb);
}
