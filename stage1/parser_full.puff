// Stage1 parser for broader language coverage (incremental, statement-first).
// Integrates expression ASTs via parser_expr for all statement expressions.

struct ParseCtx {
  tokens Vec,
  src byte~,
  srcLen int,
  idx int,
  err int,
  arena NodeArena,
  meta ModuleMeta
}

struct Span { start int, end int, err int }

def p_kind(p ParseCtx) int {
  if (p.idx >= p.tokens.length) { return TOKEN_EOF; }
  return token_kind_at(p.tokens, p.idx);
}
def p_advance(p ParseCtx) ParseCtx { return ParseCtx{p.tokens, p.src, p.srcLen, p.idx + 1, p.err, p.arena, p.meta}; }

// Merge nodes from exprArena into target arena; return root adjusted index.
// Parse expression from current position until a terminator (semicolon/right brace/right paren).
// Returns merged expr root node index in module arena, or -1 on error; advances ctx.idx to terminator.
def p_parse_expr_root(p ParseCtx, terminator int, out ParseCtx~) int {
  var start = p.idx;
  var i = p.idx;
  while (i < p.tokens.length) {
    var k = token_kind_at(p.tokens, i);
    if (k == terminator || k == TOKEN_RIGHT_BRACE || k == TOKEN_EOF) { break; }
    i = i + 1;
  }
  var ctx = p;
  var res = parse_expr_ast_slice(ctx.tokens, ctx.src, start, i);
  var rootIdx = -1;
  if (res.err == 1 || res.root == -1) {
    ctx.err = 6000;
  } else {
    // merge nodes with node index offsets (token indices are already absolute via tokOffset)
    var base = ctx.arena.nodes.length;
    var ni = 0;
    while (ni < res.arena.nodes.length) {
      var n = nodearena_get(res.arena, ni);
      var knd = n.kind;
      // adjust node references
      if (knd == NODE_GROUP || knd == NODE_DEREF || knd == NODE_LEN) {
        if (n.a != -1) { n.a = n.a + base; }
      } else if (knd == NODE_UNARY) {
        if (n.b != -1) { n.b = n.b + base; }
      } else if (knd == NODE_UPDATE) {
        if (n.b != -1) { n.b = n.b + base; }
      } else if (knd == NODE_BINARY || knd == NODE_LOGICAL) {
        if (n.a != -1) { n.a = n.a + base; }
        if (n.b != -1) { n.b = n.b + base; }
      } else if (knd == NODE_TERNARY) {
        if (n.a != -1) { n.a = n.a + base; }
        if (n.b != -1) { n.b = n.b + base; }
        if (n.c != -1) { n.c = n.c + base; }
      } else if (knd == NODE_CALL) {
        if (n.a != -1) { n.a = n.a + base; }
        if (n.b != -1) { n.b = n.b + base; }
      } else if (knd == NODE_INDEX) {
        if (n.a != -1) { n.a = n.a + base; }
        if (n.b != -1) { n.b = n.b + base; }
      } else if (knd == NODE_DOT) {
        if (n.a != -1) { n.a = n.a + base; }
      } else if (knd == NODE_LIST) {
        if (n.a != -1) { n.a = n.a + base; }
        if (n.b != -1) { n.b = n.b + base; }
      } else if (knd == NODE_ASSIGN) {
        if (n.a != -1) { n.a = n.a + base; }
        if (n.b != -1) { n.b = n.b + base; }
      }
      ctx.arena = nodearena_push(ctx.arena, n);
      ni = ni + 1;
    }
    rootIdx = res.root + base;
  }
  ctx.idx = i;
  out~ = ctx;
  return rootIdx;
}

// Variant that stops on either terminatorA or terminatorB (if non-negative).

def parse_block(p ParseCtx, out ParseCtx~) int {
  var ctx = p;
  if (p_kind(ctx) != TOKEN_LEFT_BRACE) { ctx.err = 901; out~ = ctx; return -1; }
  ctx = p_advance(ctx); // consume '{'
  var blockStart = ctx.arena.nodes.length;
  while (p_kind(ctx) != TOKEN_RIGHT_BRACE && p_kind(ctx) != TOKEN_EOF && ctx.err == 0) {
    parse_statement(ctx, &ctx);
    if (ctx.err != 0) { break; }
  }
  if (ctx.err != 0) { out~ = ctx; return -1; }
  if (p_kind(ctx) != TOKEN_RIGHT_BRACE) { ctx.err = 902; out~ = ctx; return -1; }
  ctx = p_advance(ctx); // consume '}'
  var blockCount = ctx.arena.nodes.length - blockStart;
  ctx.arena = nodearena_push(ctx.arena, Node{NODE_BLOCK, blockStart, blockCount, 0, 0, 0, -1});
  var blkIdx = ctx.arena.nodes.length - 1;
  out~ = ctx;
  return blkIdx;
}

def parse_statement(p ParseCtx, out ParseCtx~) int {
  var k = p_kind(p);
  if (k == TOKEN_VAR) {
    var ctx = p_advance(p);
    if (p_kind(ctx) != TOKEN_IDENTIFIER) { ctx.err = 201; out~ = ctx; return -1; }
    var nameTok = ctx.idx;
    ctx = p_advance(ctx);
    var vtypeStartByte = -1;
    var vtypeLen = 0;
    if (p_kind(ctx) != TOKEN_EQUAL) {
      var typeTokStart = ctx.idx;
      var tRes = parse_type(ctx.tokens, ctx.src, ctx.idx);
      if (tRes.ok == 0) { ctx.err = 202; out~ = ctx; return -1; }
      vtypeStartByte = token_start_at(ctx.tokens, typeTokStart);
      var tEndByte = span_end_byte(ctx, tRes.next);
      vtypeLen = tEndByte - vtypeStartByte;
      ctx.idx = tRes.next;
    }
    if (p_kind(ctx) != TOKEN_EQUAL) { ctx.err = 202; out~ = ctx; return -1; }
    ctx = p_advance(ctx);
    var exprRoot = p_parse_expr_root(ctx, TOKEN_SEMICOLON, &ctx);
    if (ctx.err != 0) { out~ = ctx; return -1; }
    if (p_kind(ctx) != TOKEN_SEMICOLON) { ctx.err = 203; out~ = ctx; return -1; }
    ctx = p_advance(ctx);
    ctx.arena = nodearena_push(ctx.arena, Node{NODE_VAR_STMT, nameTok, exprRoot, 0, 0, 0, -1});
    var varIdx = ctx.arena.nodes.length - 1;
    ctx.meta.varNodeIndex = vecint_push(ctx.meta.varNodeIndex, varIdx);
    ctx.meta.varTypeStartByte = vecint_push(ctx.meta.varTypeStartByte, vtypeStartByte);
    ctx.meta.varTypeLen = vecint_push(ctx.meta.varTypeLen, vtypeLen);
    out~ = ctx;
    return ctx.arena.nodes.length - 1;
  }
  if (k == TOKEN_RETURN) {
    var ctx = p_advance(p);
    var exprRoot2 = p_parse_expr_root(ctx, TOKEN_SEMICOLON, &ctx);
    if (ctx.err != 0) { out~ = ctx; return -1; }
    if (p_kind(ctx) != TOKEN_SEMICOLON) { ctx.err = 204; out~ = ctx; return -1; }
    ctx = p_advance(ctx);
    ctx.arena = nodearena_push(ctx.arena, Node{NODE_RETURN, exprRoot2, 0, 0, 0, 0, -1});
    out~ = ctx;
    return ctx.arena.nodes.length - 1;
  }
  if (k == TOKEN_PRINT) {
    var ctx = p_advance(p);
    var exprRoot3 = p_parse_expr_root(ctx, TOKEN_SEMICOLON, &ctx);
    if (ctx.err != 0) { out~ = ctx; return -1; }
    if (p_kind(ctx) != TOKEN_SEMICOLON) { ctx.err = 205; out~ = ctx; return -1; }
    ctx = p_advance(ctx);
    ctx.arena = nodearena_push(ctx.arena, Node{NODE_PRINT, exprRoot3, 0, 0, 0, 0, -1});
    out~ = ctx;
    return ctx.arena.nodes.length - 1;
  }
  if (k == TOKEN_IF) {
    var ctx = p_advance(p);
    if (p_kind(ctx) != TOKEN_LEFT_PAREN) { ctx.err = 301; out~ = ctx; return -1; }
    ctx = p_advance(ctx);
    var condRoot = p_parse_expr_root(ctx, TOKEN_RIGHT_PAREN, &ctx);
    if (ctx.err != 0) { out~ = ctx; return -1; }
    if (p_kind(ctx) != TOKEN_RIGHT_PAREN) { ctx.err = 302; out~ = ctx; return -1; }
    ctx = p_advance(ctx);
    var thenIdx = -1;
    if (p_kind(ctx) == TOKEN_LEFT_BRACE) {
      thenIdx = parse_block(ctx, &ctx);
    } else {
      thenIdx = parse_statement(ctx, &ctx);
    }
    var elseIdx = -1;
    if (ctx.err == 0 && p_kind(ctx) == TOKEN_ELSE) {
      ctx = p_advance(ctx);
      if (p_kind(ctx) == TOKEN_LEFT_BRACE) {
        elseIdx = parse_block(ctx, &ctx);
      } else {
        elseIdx = parse_statement(ctx, &ctx);
      }
    }
    ctx.arena = nodearena_push(ctx.arena, Node{NODE_IF, condRoot, thenIdx, elseIdx, 0, 0, -1});
    out~ = ctx;
    return ctx.arena.nodes.length - 1;
  }
  if (k == TOKEN_WHILE) {
    var ctx = p_advance(p);
    if (p_kind(ctx) != TOKEN_LEFT_PAREN) { ctx.err = 401; out~ = ctx; return -1; }
    ctx = p_advance(ctx);
    var condRoot2 = p_parse_expr_root(ctx, TOKEN_RIGHT_PAREN, &ctx);
    if (ctx.err != 0) { out~ = ctx; return -1; }
    if (p_kind(ctx) != TOKEN_RIGHT_PAREN) { ctx.err = 402; out~ = ctx; return -1; }
    ctx = p_advance(ctx);
    var bodyIdx = -1;
    if (p_kind(ctx) == TOKEN_LEFT_BRACE) {
      bodyIdx = parse_block(ctx, &ctx);
    } else {
      bodyIdx = parse_statement(ctx, &ctx);
    }
    ctx.arena = nodearena_push(ctx.arena, Node{NODE_WHILE, condRoot2, bodyIdx, 0, 0, 0, -1});
    out~ = ctx;
    return ctx.arena.nodes.length - 1;
  }
  if (k == TOKEN_FOR) {
    var ctx = p_advance(p);
    if (p_kind(ctx) != TOKEN_LEFT_PAREN) { ctx.err = 701; out~ = ctx; return -1; }
    ctx = p_advance(ctx);
    var initRoot = -1;
    if (p_kind(ctx) != TOKEN_SEMICOLON) { initRoot = p_parse_expr_root(ctx, TOKEN_SEMICOLON, &ctx); }
    if (ctx.err != 0) { out~ = ctx; return -1; }
    if (p_kind(ctx) != TOKEN_SEMICOLON) { ctx.err = 702; out~ = ctx; return -1; }
    ctx = p_advance(ctx); // consume ';'
    var condRoot3 = -1;
    if (p_kind(ctx) != TOKEN_SEMICOLON) { condRoot3 = p_parse_expr_root(ctx, TOKEN_SEMICOLON, &ctx); }
    if (ctx.err != 0) { out~ = ctx; return -1; }
    if (p_kind(ctx) != TOKEN_SEMICOLON) { ctx.err = 703; out~ = ctx; return -1; }
    ctx = p_advance(ctx); // consume ';'
    var stepRoot = -1;
    if (p_kind(ctx) != TOKEN_RIGHT_PAREN) { stepRoot = p_parse_expr_root(ctx, TOKEN_RIGHT_PAREN, &ctx); }
    if (ctx.err != 0) { out~ = ctx; return -1; }
    if (p_kind(ctx) != TOKEN_RIGHT_PAREN) { ctx.err = 704; out~ = ctx; return -1; }
    ctx = p_advance(ctx); // consume ')'
    var bodyIdx = -1;
    if (p_kind(ctx) == TOKEN_LEFT_BRACE) {
      bodyIdx = parse_block(ctx, &ctx);
    } else {
      bodyIdx = parse_statement(ctx, &ctx);
    }
    ctx.arena = nodearena_push(ctx.arena, Node{NODE_FOR, initRoot, condRoot3, stepRoot, bodyIdx, 0, -1});
    out~ = ctx;
    return ctx.arena.nodes.length - 1;
  }
  if (k == TOKEN_BREAK) {
    var ctx = p_advance(p);
    var exprRoot4 = -1;
    if (p_kind(ctx) != TOKEN_SEMICOLON) { exprRoot4 = p_parse_expr_root(ctx, TOKEN_SEMICOLON, &ctx); }
    if (ctx.err != 0) { out~ = ctx; return -1; }
    if (p_kind(ctx) != TOKEN_SEMICOLON) { ctx.err = 801; out~ = ctx; return -1; }
    ctx = p_advance(ctx);
    ctx.arena = nodearena_push(ctx.arena, Node{NODE_BREAK, exprRoot4, 0, 0, 0, 0, -1});
    out~ = ctx;
    return ctx.arena.nodes.length - 1;
  }
  if (k == TOKEN_CONTINUE) {
    var ctx = p_advance(p);
    var exprRoot5 = -1;
    if (p_kind(ctx) != TOKEN_SEMICOLON) { exprRoot5 = p_parse_expr_root(ctx, TOKEN_SEMICOLON, &ctx); }
    if (ctx.err != 0) { out~ = ctx; return -1; }
    if (p_kind(ctx) != TOKEN_SEMICOLON) { ctx.err = 802; out~ = ctx; return -1; }
    ctx = p_advance(ctx);
    ctx.arena = nodearena_push(ctx.arena, Node{NODE_CONTINUE, exprRoot5, 0, 0, 0, 0, -1});
    out~ = ctx;
    return ctx.arena.nodes.length - 1;
  }
  // simple assignment: IDENTIFIER '=' expr ';'
  if (k == TOKEN_IDENTIFIER && (p.idx + 1) < p.tokens.length) {
    var nextKind = token_kind_at(p.tokens, p.idx + 1);
    if (nextKind == TOKEN_EQUAL) {
      var ctx = p_advance(p); // at '='
      var nameTok = p.idx;
      ctx = p_advance(ctx); // past '='
      var exprRoot6 = p_parse_expr_root(ctx, TOKEN_SEMICOLON, &ctx);
      if (ctx.err != 0) { out~ = ctx; return -1; }
      if (p_kind(ctx) != TOKEN_SEMICOLON) { ctx.err = 601; out~ = ctx; return -1; }
      ctx = p_advance(ctx);
      ctx.arena = nodearena_push(ctx.arena, Node{NODE_ASSIGN, nameTok, exprRoot6, 0, 0, 0, -1});
      out~ = ctx;
      return ctx.arena.nodes.length - 1;
    }
  }
  if (k == TOKEN_LEFT_BRACE) {
    return parse_block(p, out);
  }
  // fallback: expression statement
  var ctx = p;
  var exprRoot7 = p_parse_expr_root(ctx, TOKEN_SEMICOLON, &ctx);
  if (ctx.err != 0) { out~ = ctx; return -1; }
  if (p_kind(ctx) != TOKEN_SEMICOLON) { ctx.err = 501; out~ = ctx; return -1; }
  ctx = p_advance(ctx);
  ctx.arena = nodearena_push(ctx.arena, Node{NODE_EXPR_STMT, exprRoot7, 0, 0, 0, 0, -1});
  out~ = ctx;
  return ctx.arena.nodes.length - 1;
}

struct ModuleMeta {
  // Function params: parallel arrays over all params in parse order.
  paramTypeStartByte VecInt,
  paramTypeLen VecInt,
  paramDefaultRoot VecInt,
  // Function-level: aligned with encountered function nodes.
  fnParamMetaStart VecInt,
  fnParamCount VecInt,
  fnReturnTypeStartByte VecInt,
  fnReturnTypeLen VecInt,
  fnNodeIndex VecInt,
  // Var statements: optional type annotations.
  varNodeIndex VecInt,
  varTypeStartByte VecInt,
  varTypeLen VecInt,
  // Struct fields: parallel arrays over all fields in parse order.
  structNodeIndex VecInt,
  structFieldMetaStart VecInt,
  structFieldCount VecInt,
  structFieldTypeStartByte VecInt,
  structFieldTypeLen VecInt,
  structFieldNameTok VecInt
}

def modulemeta_new() ModuleMeta {
  return ModuleMeta{
    vecint_new(8), vecint_new(8), vecint_new(8),
    vecint_new(4), vecint_new(4), vecint_new(4), vecint_new(4), vecint_new(4),
    vecint_new(8), vecint_new(8), vecint_new(8),
    vecint_new(4), vecint_new(4), vecint_new(4), vecint_new(8), vecint_new(8),
    vecint_new(8)
  };
}

def span_end_byte(p ParseCtx, nextTok int) int {
  if (nextTok < p.tokens.length) { return token_start_at(p.tokens, nextTok); }
  return p.srcLen;
}

def span_string(src byte~, start int, lengthVal int) String {
  if (start < 0 || lengthVal <= 0) { return String{src, 0}; }
  return String{src + start, lengthVal};
}

def type_span_to_string(res ParseModuleResult, start int, lengthVal int) String {
  if (start < 0 || lengthVal <= 0) { return String{res.src, 0}; }
  return parse_type_to_string(res.src + start, lengthVal);
}

def tm_vecint_find(v VecInt, target int) int {
  var i = 0;
  while (i < v.length) {
    if (vecint_get(v, i) == target) { return i; }
    i = i + 1;
  }
  return -1;
}

struct ParseModuleResult { arena NodeArena, root int, err int, tokens Vec, src byte~, meta ModuleMeta }

// Compare identifier tokens by lexeme equality (assumes both are identifiers).
def tok_eq(tokens Vec, src byte~, a int, b int) int {
  if (a == b) { return 1; }
  var la = token_length_at(tokens, a);
  var lb = token_length_at(tokens, b);
  if (la != lb) { return 0; }
  var sa = token_start_at(tokens, a);
  var sb = token_start_at(tokens, b);
  var i = 0;
  while (i < la) {
    if ((src + sa + i)~ != (src + sb + i)~) { return 0; }
    i = i + 1;
  }
  return 1;
}

// Precheck for duplicate functions: reject duplicate names (overloads not yet supported)
def precheck_fn_dups(tokens Vec, src byte~) int {
  var names = vecint_new(8);
  var i = 0;
  while (i < tokens.length) {
    var k = token_kind_at(tokens, i);
    if (k == TOKEN_DEF) {
      var nameTok = i + 1;
      if (nameTok < tokens.length && token_kind_at(tokens, nameTok) == TOKEN_IDENTIFIER) {
        var dup = 0;
        var j = 0;
        while (j < names.length) {
          var prev = vecint_get(names, j);
          if (tok_eq(tokens, src, prev, nameTok) == 1) { dup = 1; break; }
          j = j + 1;
        }
        if (dup == 1) { return 0; }
        names = vecint_push(names, nameTok);
      }
    }
    i = i + 1;
  }
  return 1;
}

def parse_module(tokens Vec, src byte~, n int) ParseModuleResult {
  var ctx = ParseCtx{tokens, src, n, 0, 0, nodearena_new(128), modulemeta_new()};
  var rootStart = ctx.arena.nodes.length;
  while (p_kind(ctx) != TOKEN_EOF && ctx.err == 0) {
    var isExport = 0;
    if (p_kind(ctx) == TOKEN_EXPORT) {
      isExport = 1;
      ctx = p_advance(ctx);
    }
    var isImport = 0;
    if (p_kind(ctx) == TOKEN_IMPORT) {
      isImport = 1;
      ctx = p_advance(ctx);
    }
    if (p_kind(ctx) != TOKEN_DEF) {
      // top-level var
      if (p_kind(ctx) == TOKEN_VAR) {
        var vctx = p_advance(ctx);
        if (p_kind(vctx) != TOKEN_IDENTIFIER) { ctx.err = 4010; break; }
        var nameTok = vctx.idx;
        vctx = p_advance(vctx);
        var vtypeStartByte = -1;
        var vtypeLen = 0;
        if (p_kind(vctx) != TOKEN_EQUAL) {
          var vtStartTok = vctx.idx;
          var vtRes = parse_type(vctx.tokens, vctx.src, vctx.idx);
          if (vtRes.ok == 0) { ctx.err = 4011; break; }
          vtypeStartByte = token_start_at(vctx.tokens, vtStartTok);
          var vtEndByte = span_end_byte(vctx, vtRes.next);
          vtypeLen = vtEndByte - vtypeStartByte;
          vctx.idx = vtRes.next;
        }
        if (p_kind(vctx) != TOKEN_EQUAL) { ctx.err = 4011; break; }
        vctx = p_advance(vctx);
        var vroot = p_parse_expr_root(vctx, TOKEN_SEMICOLON, &vctx);
        if (vctx.err != 0) { ctx = vctx; break; }
        if (p_kind(vctx) != TOKEN_SEMICOLON) { ctx.err = 4012; break; }
        vctx = p_advance(vctx);
        vctx.arena = nodearena_push(vctx.arena, Node{NODE_VAR_STMT, nameTok, vroot, 0, 0, 0, -1});
        var vIdx = vctx.arena.nodes.length - 1;
        vctx.meta.varNodeIndex = vecint_push(vctx.meta.varNodeIndex, vIdx);
        vctx.meta.varTypeStartByte = vecint_push(vctx.meta.varTypeStartByte, vtypeStartByte);
        vctx.meta.varTypeLen = vecint_push(vctx.meta.varTypeLen, vtypeLen);
        ctx = vctx;
        continue;
      }
      if (p_kind(ctx) == TOKEN_STRUCT) {
        ctx = p_advance(ctx);
        if (p_kind(ctx) != TOKEN_IDENTIFIER) { ctx.err = 3010; break; }
        var nameTok = ctx.idx;
        ctx = p_advance(ctx);
        if (p_kind(ctx) != TOKEN_LEFT_BRACE) { ctx.err = 3011; break; }
        ctx = p_advance(ctx);
        var fieldCount = 0;
        var fieldStartTok = -1;
        var fieldMetaStart = ctx.meta.structFieldTypeStartByte.length;
        while (p_kind(ctx) != TOKEN_RIGHT_BRACE && p_kind(ctx) != TOKEN_EOF && ctx.err == 0) {
          if (fieldCount > 0) {
            if (p_kind(ctx) != TOKEN_COMMA) { ctx.err = 3012; break; }
            ctx = p_advance(ctx);
          }
          if (p_kind(ctx) != TOKEN_IDENTIFIER) { ctx.err = 3010; break; }
          if (fieldStartTok == -1) { fieldStartTok = ctx.idx; }
          ctx.meta.structFieldNameTok = vecint_push(ctx.meta.structFieldNameTok, ctx.idx);
          ctx = p_advance(ctx);
          var fTypeStartTok = ctx.idx;
          var fTypeRes = parse_type(ctx.tokens, ctx.src, ctx.idx);
          if (fTypeRes.ok == 0) { ctx.err = 3010; break; }
          var fStartByte = token_start_at(ctx.tokens, fTypeStartTok);
          var fEndByte = span_end_byte(ctx, fTypeRes.next);
          var fLen = fEndByte - fStartByte;
          ctx.idx = fTypeRes.next;
          ctx.meta.structFieldTypeStartByte = vecint_push(ctx.meta.structFieldTypeStartByte, fStartByte);
          ctx.meta.structFieldTypeLen = vecint_push(ctx.meta.structFieldTypeLen, fLen);
          fieldCount = fieldCount + 1;
        }
        if (ctx.err != 0) { break; }
        if (p_kind(ctx) != TOKEN_RIGHT_BRACE) { ctx.err = 3012; break; }
        ctx = p_advance(ctx);
        ctx.arena = nodearena_push(ctx.arena, Node{NODE_STRUCT_DECL, fieldCount, isExport, nameTok, fieldStartTok, 0, -1});
        var structIdx = ctx.arena.nodes.length - 1;
        ctx.meta.structNodeIndex = vecint_push(ctx.meta.structNodeIndex, structIdx);
        ctx.meta.structFieldMetaStart = vecint_push(ctx.meta.structFieldMetaStart, fieldMetaStart);
        ctx.meta.structFieldCount = vecint_push(ctx.meta.structFieldCount, fieldCount);
        continue;
      }
      ctx = p_advance(ctx);
      continue;
    }
    ctx = p_advance(ctx);
    if (p_kind(ctx) != TOKEN_IDENTIFIER) { ctx.err = 102; break; }
    var nameTok = ctx.idx;
    ctx = p_advance(ctx);
    if (p_kind(ctx) != TOKEN_LEFT_PAREN) { ctx.err = 103; break; }
    ctx = p_advance(ctx);
  var paramsStart = ctx.idx;
  var paramCount = 0;
  var paramMetaStart = ctx.meta.paramTypeStartByte.length;
  while (p_kind(ctx) != TOKEN_RIGHT_PAREN && p_kind(ctx) != TOKEN_EOF && ctx.err == 0) {
    if (p_kind(ctx) != TOKEN_IDENTIFIER) { ctx.err = 104; break; }
    ctx = p_advance(ctx);
    // type is required for parameters
    var typeTokStart = ctx.idx;
    var tRes = parse_type(ctx.tokens, ctx.src, ctx.idx);
    if (tRes.ok == 0) { ctx.err = 104; break; }
    var tStartByte = token_start_at(ctx.tokens, typeTokStart);
    var tEndByte = span_end_byte(ctx, tRes.next);
    var tLen = tEndByte - tStartByte;
    ctx.idx = tRes.next;
    // optional default value
    var defRoot = -1;
    if (p_kind(ctx) == TOKEN_EQUAL) {
      ctx = p_advance(ctx);
      defRoot = -2; // sentinel indicating default exists
      while (p_kind(ctx) != TOKEN_COMMA && p_kind(ctx) != TOKEN_RIGHT_PAREN && p_kind(ctx) != TOKEN_EOF && p_kind(ctx) != TOKEN_RIGHT_BRACE) {
        ctx = p_advance(ctx);
      }
    }
    ctx.meta.paramTypeStartByte = vecint_push(ctx.meta.paramTypeStartByte, tStartByte);
    ctx.meta.paramTypeLen = vecint_push(ctx.meta.paramTypeLen, tLen);
    ctx.meta.paramDefaultRoot = vecint_push(ctx.meta.paramDefaultRoot, defRoot);
    paramCount = paramCount + 1;
    if (p_kind(ctx) == TOKEN_COMMA) {
      ctx = p_advance(ctx);
      continue;
    }
    if (p_kind(ctx) != TOKEN_RIGHT_PAREN) { ctx.err = 105; break; }
  }
    if (ctx.err != 0) { break; }
    if (p_kind(ctx) != TOKEN_RIGHT_PAREN) { ctx.err = 105; break; }
    ctx = p_advance(ctx);
  var retStartByte = -1;
  var retLen = 0;
  if (p_kind(ctx) != TOKEN_LEFT_BRACE && p_kind(ctx) != TOKEN_SEMICOLON) {
    var retTokStart = ctx.idx;
    var retRes = parse_type(ctx.tokens, ctx.src, ctx.idx);
    if (retRes.ok == 0) { ctx.err = 108; break; }
    retStartByte = token_start_at(ctx.tokens, retTokStart);
    var retEndByte = span_end_byte(ctx, retRes.next);
    retLen = retEndByte - retStartByte;
    ctx.idx = retRes.next;
  }
    if (isImport == 1) {
      if (p_kind(ctx) != TOKEN_SEMICOLON) { ctx.err = 107; break; }
      ctx = p_advance(ctx);
      ctx.arena = nodearena_push(ctx.arena, Node{NODE_FUNCTION, -1, paramsStart, nameTok, paramCount, isExport, 1});
    var fnIdxImp = ctx.arena.nodes.length - 1;
    ctx.meta.fnParamMetaStart = vecint_push(ctx.meta.fnParamMetaStart, paramMetaStart);
    ctx.meta.fnParamCount = vecint_push(ctx.meta.fnParamCount, paramCount);
    ctx.meta.fnReturnTypeStartByte = vecint_push(ctx.meta.fnReturnTypeStartByte, retStartByte);
    ctx.meta.fnReturnTypeLen = vecint_push(ctx.meta.fnReturnTypeLen, retLen);
    ctx.meta.fnNodeIndex = vecint_push(ctx.meta.fnNodeIndex, fnIdxImp);
      continue;
    }
    if (p_kind(ctx) != TOKEN_LEFT_BRACE) { ctx.err = 106; break; }
    var bodyIdx = parse_block(ctx, &ctx);
    if (ctx.err != 0) { break; }
    ctx.arena = nodearena_push(ctx.arena, Node{NODE_FUNCTION, bodyIdx, paramsStart, nameTok, paramCount, isExport, 0});
  var fnIdx = ctx.arena.nodes.length - 1;
  ctx.meta.fnParamMetaStart = vecint_push(ctx.meta.fnParamMetaStart, paramMetaStart);
  ctx.meta.fnParamCount = vecint_push(ctx.meta.fnParamCount, paramCount);
  ctx.meta.fnReturnTypeStartByte = vecint_push(ctx.meta.fnReturnTypeStartByte, retStartByte);
  ctx.meta.fnReturnTypeLen = vecint_push(ctx.meta.fnReturnTypeLen, retLen);
  ctx.meta.fnNodeIndex = vecint_push(ctx.meta.fnNodeIndex, fnIdx);
  }
  if (ctx.err != 0) { return ParseModuleResult{ctx.arena, -1, ctx.err, ctx.tokens, src, ctx.meta}; }
  var rootCount = ctx.arena.nodes.length - rootStart;
  ctx.arena = nodearena_push(ctx.arena, Node{NODE_BLOCK, rootStart, rootCount, 0, 0, 0, -1});
  var rootIdx = ctx.arena.nodes.length - 1;
  return ParseModuleResult{ctx.arena, rootIdx, ctx.err, ctx.tokens, src, ctx.meta};
}

// Convenience: parse directly from source.
def parse_module_source(src byte~, n int) ParseModuleResult {
  var toks = scan_tokens(src, n);
  var ok = precheck_fn_dups(toks, src);
  if (ok == 0) { return ParseModuleResult{nodearena_new(0), -1, 9100, toks, src, modulemeta_new()}; }
  return parse_module(toks, src, n);
}

// ----- Debug/summary helpers -----
def node_kind_name(k int) String {
  if (k == NODE_LITERAL) { return String{byte~(&"LITERAL"[0]), 7}; }
  if (k == NODE_VARIABLE) { return String{byte~(&"VARIABLE"[0]), 8}; }
  if (k == NODE_BINARY) { return String{byte~(&"BINARY"[0]), 6}; }
  if (k == NODE_CALL) { return String{byte~(&"CALL"[0]), 4}; }
  if (k == NODE_RETURN) { return String{byte~(&"RETURN"[0]), 6}; }
  if (k == NODE_VAR_STMT) { return String{byte~(&"VAR_STMT"[0]), 8}; }
  if (k == NODE_FUNCTION) { return String{byte~(&"FUNCTION"[0]), 8}; }
  if (k == NODE_BLOCK) { return String{byte~(&"BLOCK"[0]), 5}; }
  if (k == NODE_ASSIGN) { return String{byte~(&"ASSIGN"[0]), 6}; }
  if (k == NODE_GROUP) { return String{byte~(&"GROUP"[0]), 5}; }
  if (k == NODE_UNARY) { return String{byte~(&"UNARY"[0]), 5}; }
  if (k == NODE_UPDATE) { return String{byte~(&"UPDATE"[0]), 6}; }
  if (k == NODE_LOGICAL) { return String{byte~(&"LOGICAL"[0]), 7}; }
  if (k == NODE_TERNARY) { return String{byte~(&"TERNARY"[0]), 7}; }
  if (k == NODE_INDEX) { return String{byte~(&"INDEX"[0]), 5}; }
  if (k == NODE_DEREF) { return String{byte~(&"DEREF"[0]), 5}; }
  if (k == NODE_DOT) { return String{byte~(&"DOT"[0]), 3}; }
  if (k == NODE_LEN) { return String{byte~(&"LEN"[0]), 3}; }
  if (k == NODE_LIST) { return String{byte~(&"LIST"[0]), 4}; }
  if (k == NODE_CAST) { return String{byte~(&"CAST"[0]), 4}; }
  if (k == NODE_PRINT) { return String{byte~(&"PRINT"[0]), 5}; }
  if (k == NODE_EXPR_STMT) { return String{byte~(&"EXPR_STMT"[0]), 9}; }
  if (k == NODE_IF) { return String{byte~(&"IF"[0]), 2}; }
  if (k == NODE_WHILE) { return String{byte~(&"WHILE"[0]), 5}; }
  if (k == NODE_FOR) { return String{byte~(&"FOR"[0]), 3}; }
  if (k == NODE_BREAK) { return String{byte~(&"BREAK"[0]), 5}; }
  if (k == NODE_CONTINUE) { return String{byte~(&"CONTINUE"[0]), 8}; }
  if (k == NODE_STRUCT_DECL) { return String{byte~(&"STRUCT_DECL"[0]), 11}; }
  return String{byte~(&"UNKNOWN"[0]), 7};
}

def tok_string(tokens Vec, idx int, src byte~) String {
  if (idx < 0 || idx >= tokens.length) { return String{src, 0}; }
  var st = token_start_at(tokens, idx);
  var ln = token_length_at(tokens, idx);
  return String{src + st, ln};
}

// Collect parameter identifier names starting at startIdx until right paren.
def param_names_string(tokens Vec, src byte~, startIdx int) String {
  if (startIdx == -1) { return String{src, 0}; }
  var sb = sb_new();
  var i = startIdx;
  var first = 1;
  while (i < tokens.length) {
    var k = token_kind_at(tokens, i);
    if (k == TOKEN_RIGHT_PAREN) { break; }
    if (k == TOKEN_IDENTIFIER) {
      if (first == 0) { sb = sb_append_byte(sb, byte(44)); } // ','
      sb = sb_append_string(sb, tok_string(tokens, i, src));
      first = 0;
    }
    i = i + 1;
  }
  return sb_to_string(sb);
}

// Collect struct field identifier names starting at startIdx until right brace.
def field_names_string(tokens Vec, src byte~, startIdx int) String {
  if (startIdx == -1) { return String{src, 0}; }
  var sb = sb_new();
  var i = startIdx;
  var first = 1;
  while (i < tokens.length) {
    var k = token_kind_at(tokens, i);
    if (k == TOKEN_RIGHT_BRACE) { break; }
    if (k == TOKEN_IDENTIFIER) {
      if (first == 0) { sb = sb_append_byte(sb, byte(44)); } // ','
      sb = sb_append_string(sb, tok_string(tokens, i, src));
      first = 0;
    }
    i = i + 1;
  }
  return sb_to_string(sb);
}

def module_summary(res ParseModuleResult) String {
  if (res.err != 0) {
    var sbErr = sb_new();
    sbErr = sb_append_cstr(sbErr, byte~(&"err"[0]));
    sbErr = sb_append_cstr(sbErr, byte~(&" code="[0]));
    sbErr = sb_append_int(sbErr, res.err);
    sbErr = sb_append_cstr(sbErr, byte~(&" tokens="[0]));
    sbErr = sb_append_int(sbErr, res.tokens.length);
    if (res.tokens.length > 0) {
      sbErr = sb_append_cstr(sbErr, byte~(&" first="[0]));
      sbErr = sb_append_int(sbErr, token_kind_at(res.tokens, 0));
    }
    return sb_to_string(sbErr);
  }
  var sb = sb_new();
  sb = sb_append_cstr(sb, byte~(&"root="[0]));
  sb = sb_append_int(sb, res.root);
  sb = sb_append_cstr(sb, byte~(&" count="[0]));
  sb = sb_append_int(sb, res.arena.nodes.length);
  sb = sb_append_byte(sb, byte(10));
  var i = 0;
  while (i < res.arena.nodes.length) {
    var n = nodearena_get(res.arena, i);
    sb = sb_append_cstr(sb, byte~(&"idx="[0]));
    sb = sb_append_int(sb, i);
    sb = sb_append_cstr(sb, byte~(&" kind="[0]));
    sb = sb_append_string(sb, node_kind_name(n.kind));
    sb = sb_append_cstr(sb, byte~(&" a="[0]));
    sb = sb_append_int(sb, n.a);
    sb = sb_append_cstr(sb, byte~(&" b="[0]));
    sb = sb_append_int(sb, n.b);
    sb = sb_append_cstr(sb, byte~(&" c="[0]));
    sb = sb_append_int(sb, n.c);
    sb = sb_append_cstr(sb, byte~(&" d="[0]));
    sb = sb_append_int(sb, n.d);
    if (n.kind == NODE_VAR_STMT) {
      var name = tok_string(res.tokens, n.a, res.src);
      sb = sb_append_cstr(sb, byte~(&" name="[0]));
      sb = sb_append_string(sb, name);
      sb = sb_append_cstr(sb, byte~(&" expr="[0]));
      sb = sb_append_int(sb, n.b);
    }
    if (n.kind == NODE_ASSIGN) {
      var aname = tok_string(res.tokens, n.a, res.src);
      sb = sb_append_cstr(sb, byte~(&" name="[0]));
      sb = sb_append_string(sb, aname);
      sb = sb_append_cstr(sb, byte~(&" expr="[0]));
      sb = sb_append_int(sb, n.b);
    }
    if (n.kind == NODE_FUNCTION) {
      var fname = tok_string(res.tokens, n.c, res.src);
      sb = sb_append_cstr(sb, byte~(&" name="[0]));
      sb = sb_append_string(sb, fname);
      sb = sb_append_cstr(sb, byte~(&" params="[0]));
      sb = sb_append_int(sb, n.d);
      sb = sb_append_cstr(sb, byte~(&" export="[0]));
      sb = sb_append_int(sb, n.value);
      sb = sb_append_cstr(sb, byte~(&" import="[0]));
      sb = sb_append_int(sb, n.typeId);
      var pnames = param_names_string(res.tokens, res.src, n.b);
      sb = sb_append_cstr(sb, byte~(&" names="[0]));
      sb = sb_append_string(sb, pnames);
    }
    if (n.kind == NODE_IF) {
      sb = sb_append_cstr(sb, byte~(&" cond="[0]));
      sb = sb_append_int(sb, n.a);
      sb = sb_append_cstr(sb, byte~(&" then="[0]));
      sb = sb_append_int(sb, n.c);
      sb = sb_append_cstr(sb, byte~(&" else="[0]));
      sb = sb_append_int(sb, n.d);
    }
    if (n.kind == NODE_WHILE) {
      sb = sb_append_cstr(sb, byte~(&" cond="[0]));
      sb = sb_append_int(sb, n.a);
      sb = sb_append_cstr(sb, byte~(&" body="[0]));
      sb = sb_append_int(sb, n.c);
    }
    if (n.kind == NODE_FOR) {
      sb = sb_append_cstr(sb, byte~(&" init="[0]));
      sb = sb_append_int(sb, n.a);
      sb = sb_append_cstr(sb, byte~(&" cond="[0]));
      sb = sb_append_int(sb, n.b);
      sb = sb_append_cstr(sb, byte~(&" step="[0]));
      sb = sb_append_int(sb, n.c);
      sb = sb_append_cstr(sb, byte~(&" body="[0]));
      sb = sb_append_int(sb, n.d);
    }
    if (n.kind == NODE_STRUCT_DECL) {
      sb = sb_append_cstr(sb, byte~(&" fields="[0]));
      sb = sb_append_int(sb, n.a);
      var sname = tok_string(res.tokens, n.c, res.src);
      sb = sb_append_cstr(sb, byte~(&" name="[0]));
      sb = sb_append_string(sb, sname);
      sb = sb_append_cstr(sb, byte~(&" export="[0]));
      sb = sb_append_int(sb, n.b);
      var fnames = field_names_string(res.tokens, res.src, n.d);
      sb = sb_append_cstr(sb, byte~(&" names="[0]));
      sb = sb_append_string(sb, fnames);
    }
    if (n.kind == NODE_BLOCK) {
      sb = sb_append_cstr(sb, byte~(&" start="[0]));
      sb = sb_append_int(sb, n.a);
      sb = sb_append_cstr(sb, byte~(&" count="[0]));
      sb = sb_append_int(sb, n.b);
    }
    if (n.kind == NODE_RETURN) {
      sb = sb_append_cstr(sb, byte~(&" expr="[0]));
      sb = sb_append_int(sb, n.a);
    }
    if (n.kind == NODE_EXPR_STMT) {
      sb = sb_append_cstr(sb, byte~(&" expr="[0]));
      sb = sb_append_int(sb, n.a);
    }
    if (n.kind == NODE_PRINT) {
      sb = sb_append_cstr(sb, byte~(&" expr="[0]));
      sb = sb_append_int(sb, n.a);
    }
    if (n.kind == NODE_BREAK || n.kind == NODE_CONTINUE) {
      sb = sb_append_cstr(sb, byte~(&" expr="[0]));
      sb = sb_append_int(sb, n.a);
    }
    sb = sb_append_byte(sb, byte(10));
    i = i + 1;
  }
  return sb_to_string(sb);
}

// Emit a compact type-oriented summary for testing parser metadata.
def module_type_summary(res ParseModuleResult) String {
  if (res.err != 0) { return String{byte~(&"err"[0]), 3}; }
  var sb = sb_new();
  var fnIdxs = res.meta.fnNodeIndex;
  var varIdxs = res.meta.varNodeIndex;
  var structIdxs = res.meta.structNodeIndex;

  // functions
  var fi = 0;
  while (fi < res.meta.fnNodeIndex.length) {
    var fnIdx = vecint_get(res.meta.fnNodeIndex, fi);
    var fnNode = nodearena_get(res.arena, fnIdx);
    var name = tok_string(res.tokens, fnNode.c, res.src);
    sb = sb_append_cstr(sb, byte~(&"fn "[0]));
    sb = sb_append_string(sb, name);
    sb = sb_append_cstr(sb, byte~(&" params="[0]));
    var pStart = vecint_get(res.meta.fnParamMetaStart, fi);
    var pCount = vecint_get(res.meta.fnParamCount, fi);
    var pj = 0;
    while (pj < pCount) {
      if (pj > 0) { sb = sb_append_byte(sb, byte(44)); } // ','
      var tStart = vecint_get(res.meta.paramTypeStartByte, pStart + pj);
      var tLen = vecint_get(res.meta.paramTypeLen, pStart + pj);
      var tStr = type_span_to_string(res, tStart, tLen);
      sb = sb_append_string(sb, tStr);
      var dRoot = vecint_get(res.meta.paramDefaultRoot, pStart + pj);
      if (dRoot != -1) { sb = sb_append_cstr(sb, byte~(&"=default"[0])); }
      pj = pj + 1;
    }
    sb = sb_append_cstr(sb, byte~(&" ret="[0]));
    var rStart = vecint_get(res.meta.fnReturnTypeStartByte, fi);
    var rLen = vecint_get(res.meta.fnReturnTypeLen, fi);
    var rStr = type_span_to_string(res, rStart, rLen);
    if (rStr.length == 0) { rStr = String{byte~(&"void"[0]), 4}; }
    sb = sb_append_string(sb, rStr);
    sb = sb_append_cstr(sb, byte~(&" export="[0]));
    sb = sb_append_int(sb, fnNode.value);
    sb = sb_append_cstr(sb, byte~(&" import="[0]));
    sb = sb_append_int(sb, fnNode.typeId);
    sb = sb_append_byte(sb, byte(10));
    fi = fi + 1;
  }
  // vars
  var vi = 0;
  while (vi < res.meta.varNodeIndex.length) {
    var vIdx = vecint_get(res.meta.varNodeIndex, vi);
    var vNode = nodearena_get(res.arena, vIdx);
    var vname = tok_string(res.tokens, vNode.a, res.src);
    sb = sb_append_cstr(sb, byte~(&"var "[0]));
    sb = sb_append_string(sb, vname);
    sb = sb_append_cstr(sb, byte~(&" type="[0]));
    var vtStart = vecint_get(res.meta.varTypeStartByte, vi);
    var vtLen = vecint_get(res.meta.varTypeLen, vi);
    if (vtStart == -1 || vtLen == 0) {
      sb = sb_append_cstr(sb, byte~(&"infer"[0]));
    } else {
      var vtStr = type_span_to_string(res, vtStart, vtLen);
      sb = sb_append_string(sb, vtStr);
    }
    sb = sb_append_byte(sb, byte(10));
    vi = vi + 1;
  }
  // structs
  var si = 0;
  while (si < res.meta.structNodeIndex.length) {
    var sIdx = vecint_get(res.meta.structNodeIndex, si);
    var sNode = nodearena_get(res.arena, sIdx);
    var sname = tok_string(res.tokens, sNode.c, res.src);
    sb = sb_append_cstr(sb, byte~(&"struct "[0]));
    sb = sb_append_string(sb, sname);
    sb = sb_append_cstr(sb, byte~(&" fields="[0]));
    var fStart = vecint_get(res.meta.structFieldMetaStart, si);
    var fCount = vecint_get(res.meta.structFieldCount, si);
    var fj = 0;
    while (fj < fCount) {
      if (fj > 0) { sb = sb_append_byte(sb, byte(44)); }
      var fs = vecint_get(res.meta.structFieldTypeStartByte, fStart + fj);
      var fl = vecint_get(res.meta.structFieldTypeLen, fStart + fj);
      var fStr = type_span_to_string(res, fs, fl);
      sb = sb_append_string(sb, fStr);
      fj = fj + 1;
    }
    sb = sb_append_byte(sb, byte(10));
    si = si + 1;
  }
  return sb_to_string(sb);
}

// Collect type ids for functions, vars, and struct fields using recorded spans.
struct TypeModuleTypes {
  env TypeEnv,
  fnParamTypeStart VecInt,
  fnParamCount VecInt,
  fnReturnTypeId VecInt,
  paramTypeIds VecInt,
  varTypeIds VecInt,
  structFieldTypeStart VecInt,
  structFieldCount VecInt,
  structFieldTypeIds VecInt,
  structTypeIds VecInt,
  structFieldOffsetStart VecInt,
  structFieldOffsets VecInt,
  structFieldNameStart VecInt,
  structFieldNames VecInt,
  fnNodeIndex VecInt,
  varNodeIndex VecInt,
  structNodeIndex VecInt,
  err int
}

def module_type_ids(res ParseModuleResult) TypeModuleTypes {
  var env = typeenv_new();
  var paramTypeIds = vecint_new(8);
  var fnParamTypeStart = vecint_new(4);
  var fnParamCount = vecint_new(4);
  var fnReturnTypeId = vecint_new(4);
  var varTypeIds = vecint_new(4);
  var structFieldTypeIds = vecint_new(8);
  var structTypeIds = vecint_new(4);
  var structFieldOffsets = vecint_new(8);
  var structFieldOffsetStart = vecint_new(4);
  var structFieldNameStart = vecint_new(4);
  var structFieldNames = vecint_new(8);
  var structFieldTypeStart = vecint_new(4);
  var structFieldCount = vecint_new(4);
  var err = 0;
  var fnIdxs = res.meta.fnNodeIndex;
  var varIdxs = res.meta.varNodeIndex;
  var structIdxs = res.meta.structNodeIndex;

  var si = 0;
  while (si < res.meta.structNodeIndex.length) {
    var fStart = vecint_get(res.meta.structFieldMetaStart, si);
    var fCount = vecint_get(res.meta.structFieldCount, si);
    structFieldTypeStart = vecint_push(structFieldTypeStart, structFieldTypeIds.length);
    structFieldCount = vecint_push(structFieldCount, fCount);
    structFieldOffsetStart = vecint_push(structFieldOffsetStart, structFieldOffsets.length);
    structFieldNameStart = vecint_push(structFieldNameStart, structFieldNames.length);
    var fj = 0;
    var fieldTypes = vecint_new(fCount);
    while (fj < fCount) {
      var fs = vecint_get(res.meta.structFieldTypeStartByte, fStart + fj);
      var fl = vecint_get(res.meta.structFieldTypeLen, fStart + fj);
      var fRes = parse_type_to_id(env, res.src + fs, fl);
      if (fRes.err == 1) { err = 1; return TypeModuleTypes{env, fnParamTypeStart, fnParamCount, fnReturnTypeId, paramTypeIds, varTypeIds, structFieldTypeStart, structFieldCount, structFieldTypeIds, structTypeIds, structFieldOffsetStart, structFieldOffsets, structFieldNameStart, structFieldNames, fnIdxs, varIdxs, structIdxs, err}; }
      env = fRes.env;
      fieldTypes = vecint_push(fieldTypes, fRes.typeId);
      fj = fj + 1;
    }
    // define struct type to keep env aligned with structSizes; offsets ignored for now.
    var structNodeIdx = vecint_get(res.meta.structNodeIndex, si);
    var structNode = nodearena_get(res.arena, structNodeIdx);
    var sname = tok_string(res.tokens, structNode.c, res.src);
    var structRes = typeenv_define_struct(env, fieldTypes, sname);
    if (structRes.err == 1) { err = 1; return TypeModuleTypes{env, fnParamTypeStart, fnParamCount, fnReturnTypeId, paramTypeIds, varTypeIds, structFieldTypeStart, structFieldCount, structFieldTypeIds, structTypeIds, structFieldOffsetStart, structFieldOffsets, structFieldNameStart, structFieldNames, fnIdxs, varIdxs, structIdxs, err}; }
    env = structRes.env;
    structTypeIds = vecint_push(structTypeIds, structRes.typeId);
    // append field types to flat vector
    var fk = 0;
    while (fk < fieldTypes.length) {
      structFieldTypeIds = vecint_push(structFieldTypeIds, vecint_get(fieldTypes, fk));
      fk = fk + 1;
    }
    var fo = 0;
    while (fo < structRes.offsets.length) {
      structFieldOffsets = vecint_push(structFieldOffsets, vecint_get(structRes.offsets, fo));
      fo = fo + 1;
    }
    var fn = 0;
    while (fn < fCount) {
      structFieldNames = vecint_push(structFieldNames, vecint_get(res.meta.structFieldNameTok, fStart + fn));
      fn = fn + 1;
    }
    si = si + 1;
  }

  // functions
  var fi = 0;
  while (fi < res.meta.fnNodeIndex.length) {
    var pStart = vecint_get(res.meta.fnParamMetaStart, fi);
    var pCount = vecint_get(res.meta.fnParamCount, fi);
    fnParamTypeStart = vecint_push(fnParamTypeStart, paramTypeIds.length);
    fnParamCount = vecint_push(fnParamCount, pCount);
    var pj = 0;
    while (pj < pCount) {
      var tStart = vecint_get(res.meta.paramTypeStartByte, pStart + pj);
      var tLen = vecint_get(res.meta.paramTypeLen, pStart + pj);
      var tRes = parse_type_to_id(env, res.src + tStart, tLen);
      if (tRes.err == 1) { err = 1; return TypeModuleTypes{env, fnParamTypeStart, fnParamCount, fnReturnTypeId, paramTypeIds, varTypeIds, structFieldTypeStart, structFieldCount, structFieldTypeIds, structTypeIds, structFieldOffsetStart, structFieldOffsets, structFieldNameStart, structFieldNames, fnIdxs, varIdxs, structIdxs, err}; }
      env = tRes.env;
      paramTypeIds = vecint_push(paramTypeIds, tRes.typeId);
      pj = pj + 1;
    }
    var rStart = vecint_get(res.meta.fnReturnTypeStartByte, fi);
    var rLen = vecint_get(res.meta.fnReturnTypeLen, fi);
    var retId = 8; // default void
    if (rLen > 0) {
      var rRes = parse_type_to_id(env, res.src + rStart, rLen);
      if (rRes.err == 1) { err = 1; return TypeModuleTypes{env, fnParamTypeStart, fnParamCount, fnReturnTypeId, paramTypeIds, varTypeIds, structFieldTypeStart, structFieldCount, structFieldTypeIds, structTypeIds, structFieldOffsetStart, structFieldOffsets, structFieldNameStart, structFieldNames, fnIdxs, varIdxs, structIdxs, err}; }
      env = rRes.env;
      retId = rRes.typeId;
    }
    fnReturnTypeId = vecint_push(fnReturnTypeId, retId);
    fi = fi + 1;
  }

  // vars
  var vi = 0;
  while (vi < res.meta.varNodeIndex.length) {
    var vtStart = vecint_get(res.meta.varTypeStartByte, vi);
    var vtLen = vecint_get(res.meta.varTypeLen, vi);
    if (vtStart == -1 || vtLen == 0) {
      varTypeIds = vecint_push(varTypeIds, -1);
    } else {
      var vtRes = parse_type_to_id(env, res.src + vtStart, vtLen);
      if (vtRes.err == 1) { err = 1; return TypeModuleTypes{env, fnParamTypeStart, fnParamCount, fnReturnTypeId, paramTypeIds, varTypeIds, structFieldTypeStart, structFieldCount, structFieldTypeIds, structTypeIds, structFieldOffsetStart, structFieldOffsets, structFieldNameStart, structFieldNames, fnIdxs, varIdxs, structIdxs, err}; }
      env = vtRes.env;
      varTypeIds = vecint_push(varTypeIds, vtRes.typeId);
    }
    vi = vi + 1;
  }

  return TypeModuleTypes{
    env,
    fnParamTypeStart, fnParamCount, fnReturnTypeId, paramTypeIds,
    varTypeIds,
    structFieldTypeStart, structFieldCount, structFieldTypeIds, structTypeIds,
    structFieldOffsetStart, structFieldOffsets, structFieldNameStart, structFieldNames,
    fnIdxs, varIdxs, structIdxs,
    err
  };
}

// Helpers to query ids with bounds checks (return -1 on invalid).
def tm_fn_param_type(tm TypeModuleTypes, fnIdx int, paramIdx int) int {
  if (fnIdx < 0 || fnIdx >= tm.fnParamTypeStart.length) { return -1; }
  var start = vecint_get(tm.fnParamTypeStart, fnIdx);
  var count = vecint_get(tm.fnParamCount, fnIdx);
  if (paramIdx < 0 || paramIdx >= count) { return -1; }
  return vecint_get(tm.paramTypeIds, start + paramIdx);
}

// Return the param start offset for a function (or -1 if invalid).
def tm_fn_param_type_start(tm TypeModuleTypes, fnIdx int) int {
  if (fnIdx < 0 || fnIdx >= tm.fnParamTypeStart.length) { return -1; }
  return vecint_get(tm.fnParamTypeStart, fnIdx);
}

// Return the parameter count for a function (or -1 if invalid).
def tm_fn_param_count(tm TypeModuleTypes, fnIdx int) int {
  if (fnIdx < 0 || fnIdx >= tm.fnParamCount.length) { return -1; }
  return vecint_get(tm.fnParamCount, fnIdx);
}

def tm_fn_return_type(tm TypeModuleTypes, fnIdx int) int {
  if (fnIdx < 0 || fnIdx >= tm.fnReturnTypeId.length) { return -1; }
  return vecint_get(tm.fnReturnTypeId, fnIdx);
}

def tm_var_type(tm TypeModuleTypes, varIdx int) int {
  if (varIdx < 0 || varIdx >= tm.varTypeIds.length) { return -1; }
  return vecint_get(tm.varTypeIds, varIdx);
}

def tm_var_type_by_node(tm TypeModuleTypes, nodeIdx int) int {
  var vi = tm_vecint_find(tm.varNodeIndex, nodeIdx);
  if (vi == -1) { return -1; }
  return tm_var_type(tm, vi);
}

def tm_struct_type(tm TypeModuleTypes, structIdx int) int {
  if (structIdx < 0 || structIdx >= tm.structTypeIds.length) { return -1; }
  return vecint_get(tm.structTypeIds, structIdx);
}

def tm_struct_field_type(tm TypeModuleTypes, structIdx int, fieldIdx int) int {
  if (structIdx < 0 || structIdx >= tm.structFieldTypeStart.length) { return -1; }
  var start = vecint_get(tm.structFieldTypeStart, structIdx);
  var count = vecint_get(tm.structFieldCount, structIdx);
  if (fieldIdx < 0 || fieldIdx >= count) { return -1; }
  return vecint_get(tm.structFieldTypeIds, start + fieldIdx);
}

def tm_struct_field_offset(tm TypeModuleTypes, structIdx int, fieldIdx int) int {
  if (structIdx < 0 || structIdx >= tm.structFieldOffsetStart.length) { return -1; }
  var start = vecint_get(tm.structFieldOffsetStart, structIdx);
  var count = vecint_get(tm.structFieldCount, structIdx);
  if (fieldIdx < 0 || fieldIdx >= count) { return -1; }
  return vecint_get(tm.structFieldOffsets, start + fieldIdx);
}

def tm_struct_field_name_tok(tm TypeModuleTypes, structIdx int, fieldIdx int) int {
  if (structIdx < 0 || structIdx >= tm.structFieldNameStart.length) { return -1; }
  var start = vecint_get(tm.structFieldNameStart, structIdx);
  var count = vecint_get(tm.structFieldCount, structIdx);
  if (fieldIdx < 0 || fieldIdx >= count) { return -1; }
  return vecint_get(tm.structFieldNames, start + fieldIdx);
}

def tm_struct_index_for_type(tm TypeModuleTypes, typeId int) int {
  var i = 0;
  while (i < tm.structTypeIds.length) {
    if (vecint_get(tm.structTypeIds, i) == typeId) { return i; }
    i = i + 1;
  }
  return -1;
}

// ---- Count helpers ----
def count_nodes(arena NodeArena, kind int) int {
  var i = 0;
  var cnt = 0;
  while (i < arena.nodes.length) {
    var n = nodearena_get(arena, i);
    if (n.kind == kind) { cnt = cnt + 1; }
    i = i + 1;
  }
  return cnt;
}

def count_functions(arena NodeArena, importFlag int, exportFlag int) int {
  var i = 0;
  var cnt = 0;
  while (i < arena.nodes.length) {
    var n = nodearena_get(arena, i);
    if (n.kind != NODE_FUNCTION) { i = i + 1; continue; }
    if (importFlag != -1 && n.typeId != importFlag) { i = i + 1; continue; }
    if (exportFlag != -1 && n.value != exportFlag) { i = i + 1; continue; }
    cnt = cnt + 1;
    i = i + 1;
  }
  return cnt;
}

// Returns "funcs=<n> imports=<n> exports=<n> structs=<n> vars=<n>"
def module_counts(res ParseModuleResult) String {
  if (res.err != 0) { return String{byte~(&"err"[0]), 3}; }
  var funcs = count_functions(res.arena, -1, -1);
  var imports = count_functions(res.arena, 1, -1);
  var exports = count_functions(res.arena, -1, 1);
  var structs = count_nodes(res.arena, NODE_STRUCT_DECL);
  var vars = count_nodes(res.arena, NODE_VAR_STMT);
  var sb = sb_new();
  sb = sb_append_cstr(sb, byte~(&"funcs="[0])); sb = sb_append_int(sb, funcs);
  sb = sb_append_cstr(sb, byte~(&" imports="[0])); sb = sb_append_int(sb, imports);
  sb = sb_append_cstr(sb, byte~(&" exports="[0])); sb = sb_append_int(sb, exports);
  sb = sb_append_cstr(sb, byte~(&" structs="[0])); sb = sb_append_int(sb, structs);
  sb = sb_append_cstr(sb, byte~(&" vars="[0])); sb = sb_append_int(sb, vars);
  return sb_to_string(sb);
}
