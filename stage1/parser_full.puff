// Stage1 parser for broader language coverage (incremental, statement-first).
// Expression parsing remains span-based for stability; AST integration will follow.

struct ParseCtx {
  tokens Vec,
  src byte~,
  idx int,
  err int,
  arena NodeArena
}

struct Span { start int, end int, err int }

def p_kind(p ParseCtx) int {
  if (p.idx >= p.tokens.length) { return TOKEN_EOF; }
  return token_kind_at(p.tokens, p.idx);
}
def p_advance(p ParseCtx) ParseCtx { return ParseCtx{p.tokens, p.src, p.idx + 1, p.err, p.arena}; }

// Return a span from current token until a top-level terminator (semicolon/right brace/right paren).
def p_parse_expr_until(p ParseCtx, terminator int, out ParseCtx~) Span {
  var start = p.idx;
  var i = p.idx;
  while (i < p.tokens.length) {
    var k = token_kind_at(p.tokens, i);
    if (k == terminator || k == TOKEN_RIGHT_BRACE || k == TOKEN_EOF) { break; }
    i = i + 1;
  }
  var ctx = p;
  ctx.idx = i;
  out~ = ctx;
  return Span{start, i, 0};
}

def parse_block(p ParseCtx, out ParseCtx~) int {
  var ctx = p;
  if (p_kind(ctx) != TOKEN_LEFT_BRACE) { ctx.err = 901; out~ = ctx; return -1; }
  ctx = p_advance(ctx); // consume '{'
  var blockStart = ctx.arena.nodes.length;
  while (p_kind(ctx) != TOKEN_RIGHT_BRACE && p_kind(ctx) != TOKEN_EOF && ctx.err == 0) {
    parse_statement(ctx, &ctx);
    if (ctx.err != 0) { break; }
  }
  if (ctx.err != 0) { out~ = ctx; return -1; }
  if (p_kind(ctx) != TOKEN_RIGHT_BRACE) { ctx.err = 902; out~ = ctx; return -1; }
  ctx = p_advance(ctx); // consume '}'
  var blockCount = ctx.arena.nodes.length - blockStart;
  ctx.arena = nodearena_push(ctx.arena, Node{NODE_BLOCK, blockStart, blockCount, 0, 0, 0, -1});
  var blkIdx = ctx.arena.nodes.length - 1;
  out~ = ctx;
  return blkIdx;
}

def parse_statement(p ParseCtx, out ParseCtx~) int {
  var k = p_kind(p);
  if (k == TOKEN_VAR) {
    var ctx = p_advance(p);
    if (p_kind(ctx) != TOKEN_IDENTIFIER) { ctx.err = 201; out~ = ctx; return -1; }
    var nameTok = ctx.idx;
    ctx = p_advance(ctx);
    if (p_kind(ctx) != TOKEN_EQUAL) { ctx.err = 202; out~ = ctx; return -1; }
    ctx = p_advance(ctx);
    var span = p_parse_expr_until(ctx, TOKEN_SEMICOLON, &ctx);
    if (p_kind(ctx) != TOKEN_SEMICOLON) { ctx.err = 203; out~ = ctx; return -1; }
    ctx = p_advance(ctx);
    ctx.arena = nodearena_push(ctx.arena, Node{NODE_VAR_STMT, nameTok, span.start, span.end, 0, 0, -1});
    out~ = ctx;
    return ctx.arena.nodes.length - 1;
  }
  if (k == TOKEN_RETURN) {
    var ctx = p_advance(p);
    var span = p_parse_expr_until(ctx, TOKEN_SEMICOLON, &ctx);
    if (p_kind(ctx) != TOKEN_SEMICOLON) { ctx.err = 204; out~ = ctx; return -1; }
    ctx = p_advance(ctx);
    ctx.arena = nodearena_push(ctx.arena, Node{NODE_RETURN, span.start, span.end, 0, 0, 0, -1});
    out~ = ctx;
    return ctx.arena.nodes.length - 1;
  }
  if (k == TOKEN_PRINT) {
    var ctx = p_advance(p);
    var span = p_parse_expr_until(ctx, TOKEN_SEMICOLON, &ctx);
    if (p_kind(ctx) != TOKEN_SEMICOLON) { ctx.err = 205; out~ = ctx; return -1; }
    ctx = p_advance(ctx);
    ctx.arena = nodearena_push(ctx.arena, Node{NODE_PRINT, span.start, span.end, 0, 0, 0, -1});
    out~ = ctx;
    return ctx.arena.nodes.length - 1;
  }
  if (k == TOKEN_IF) {
    var ctx = p_advance(p);
    if (p_kind(ctx) != TOKEN_LEFT_PAREN) { ctx.err = 301; out~ = ctx; return -1; }
    ctx = p_advance(ctx);
    var condSpan = p_parse_expr_until(ctx, TOKEN_RIGHT_PAREN, &ctx);
    if (p_kind(ctx) != TOKEN_RIGHT_PAREN) { ctx.err = 302; out~ = ctx; return -1; }
    ctx = p_advance(ctx);
    var thenIdx = -1;
    if (p_kind(ctx) == TOKEN_LEFT_BRACE) {
      thenIdx = parse_block(ctx, &ctx);
    } else {
      thenIdx = parse_statement(ctx, &ctx);
    }
    var elseIdx = -1;
    if (ctx.err == 0 && p_kind(ctx) == TOKEN_ELSE) {
      ctx = p_advance(ctx);
      if (p_kind(ctx) == TOKEN_LEFT_BRACE) {
        elseIdx = parse_block(ctx, &ctx);
      } else {
        elseIdx = parse_statement(ctx, &ctx);
      }
    }
    ctx.arena = nodearena_push(ctx.arena, Node{NODE_IF, condSpan.start, condSpan.end, thenIdx, elseIdx, 0, -1});
    out~ = ctx;
    return ctx.arena.nodes.length - 1;
  }
  if (k == TOKEN_WHILE) {
    var ctx = p_advance(p);
    if (p_kind(ctx) != TOKEN_LEFT_PAREN) { ctx.err = 401; out~ = ctx; return -1; }
    ctx = p_advance(ctx);
    var condSpan = p_parse_expr_until(ctx, TOKEN_RIGHT_PAREN, &ctx);
    if (p_kind(ctx) != TOKEN_RIGHT_PAREN) { ctx.err = 402; out~ = ctx; return -1; }
    ctx = p_advance(ctx);
    var bodyIdx = -1;
    if (p_kind(ctx) == TOKEN_LEFT_BRACE) {
      bodyIdx = parse_block(ctx, &ctx);
    } else {
      bodyIdx = parse_statement(ctx, &ctx);
    }
    ctx.arena = nodearena_push(ctx.arena, Node{NODE_WHILE, condSpan.start, condSpan.end, bodyIdx, 0, 0, -1});
    out~ = ctx;
    return ctx.arena.nodes.length - 1;
  }
  if (k == TOKEN_FOR) {
    var ctx = p_advance(p);
    if (p_kind(ctx) != TOKEN_LEFT_PAREN) { ctx.err = 701; out~ = ctx; return -1; }
    ctx = p_advance(ctx);
    var initSpan = Span{ctx.idx, ctx.idx, 0};
    if (p_kind(ctx) != TOKEN_SEMICOLON) {
      initSpan = p_parse_expr_until(ctx, TOKEN_SEMICOLON, &ctx);
    }
    if (p_kind(ctx) != TOKEN_SEMICOLON) { ctx.err = 702; out~ = ctx; return -1; }
    ctx = p_advance(ctx); // consume ';'
    var condSpan = Span{ctx.idx, ctx.idx, 0};
    if (p_kind(ctx) != TOKEN_SEMICOLON) {
      condSpan = p_parse_expr_until(ctx, TOKEN_SEMICOLON, &ctx);
    }
    if (p_kind(ctx) != TOKEN_SEMICOLON) { ctx.err = 703; out~ = ctx; return -1; }
    ctx = p_advance(ctx); // consume ';'
    var stepSpan = Span{ctx.idx, ctx.idx, 0};
    if (p_kind(ctx) != TOKEN_RIGHT_PAREN) {
      stepSpan = p_parse_expr_until(ctx, TOKEN_RIGHT_PAREN, &ctx);
    }
    if (p_kind(ctx) != TOKEN_RIGHT_PAREN) { ctx.err = 704; out~ = ctx; return -1; }
    ctx = p_advance(ctx); // consume ')'
    var bodyIdx = -1;
    if (p_kind(ctx) == TOKEN_LEFT_BRACE) {
      bodyIdx = parse_block(ctx, &ctx);
    } else {
      bodyIdx = parse_statement(ctx, &ctx);
    }
    ctx.arena = nodearena_push(ctx.arena, Node{NODE_FOR, initSpan.start, condSpan.start, stepSpan.start, bodyIdx, 0, -1});
    out~ = ctx;
    return ctx.arena.nodes.length - 1;
  }
  if (k == TOKEN_BREAK) {
    var ctx = p_advance(p);
    var span = Span{ctx.idx, ctx.idx, 0};
    if (p_kind(ctx) != TOKEN_SEMICOLON) {
      span = p_parse_expr_until(ctx, TOKEN_SEMICOLON, &ctx);
    }
    if (p_kind(ctx) != TOKEN_SEMICOLON) { ctx.err = 801; out~ = ctx; return -1; }
    ctx = p_advance(ctx);
    ctx.arena = nodearena_push(ctx.arena, Node{NODE_BREAK, span.start, span.end, 0, 0, 0, -1});
    out~ = ctx;
    return ctx.arena.nodes.length - 1;
  }
  if (k == TOKEN_CONTINUE) {
    var ctx = p_advance(p);
    var span = Span{ctx.idx, ctx.idx, 0};
    if (p_kind(ctx) != TOKEN_SEMICOLON) {
      span = p_parse_expr_until(ctx, TOKEN_SEMICOLON, &ctx);
    }
    if (p_kind(ctx) != TOKEN_SEMICOLON) { ctx.err = 802; out~ = ctx; return -1; }
    ctx = p_advance(ctx);
    ctx.arena = nodearena_push(ctx.arena, Node{NODE_CONTINUE, span.start, span.end, 0, 0, 0, -1});
    out~ = ctx;
    return ctx.arena.nodes.length - 1;
  }
  // simple assignment: IDENTIFIER '=' expr ';'
  if (k == TOKEN_IDENTIFIER && (p.idx + 1) < p.tokens.length) {
    var nextKind = token_kind_at(p.tokens, p.idx + 1);
    if (nextKind == TOKEN_EQUAL) {
      var ctx = p_advance(p); // at '='
      var nameTok = p.idx;
      ctx = p_advance(ctx); // past '='
      var span = p_parse_expr_until(ctx, TOKEN_SEMICOLON, &ctx);
      if (p_kind(ctx) != TOKEN_SEMICOLON) { ctx.err = 601; out~ = ctx; return -1; }
      ctx = p_advance(ctx);
      ctx.arena = nodearena_push(ctx.arena, Node{NODE_ASSIGN, nameTok, span.start, span.end, 0, 0, -1});
      out~ = ctx;
      return ctx.arena.nodes.length - 1;
    }
  }
  if (k == TOKEN_LEFT_BRACE) {
    return parse_block(p, out);
  }
  // fallback: expression statement
  var ctx = p;
  var span = p_parse_expr_until(ctx, TOKEN_SEMICOLON, &ctx);
  if (p_kind(ctx) != TOKEN_SEMICOLON) { ctx.err = 501; out~ = ctx; return -1; }
  ctx = p_advance(ctx);
  ctx.arena = nodearena_push(ctx.arena, Node{NODE_EXPR_STMT, span.start, span.end, 0, 0, 0, -1});
  out~ = ctx;
  return ctx.arena.nodes.length - 1;
}

struct ParseModuleResult { arena NodeArena, root int, err int, tokens Vec, src byte~ }

def parse_module(tokens Vec, src byte~, n int) ParseModuleResult {
  var ctx = ParseCtx{tokens, src, 0, 0, nodearena_new(128)};
  var rootStart = ctx.arena.nodes.length;
  while (p_kind(ctx) != TOKEN_EOF && ctx.err == 0) {
    var isExport = 0;
    if (p_kind(ctx) == TOKEN_EXPORT) {
      isExport = 1;
      ctx = p_advance(ctx);
    }
    var isImport = 0;
    if (p_kind(ctx) == TOKEN_IMPORT) {
      isImport = 1;
      ctx = p_advance(ctx);
    }
    if (p_kind(ctx) != TOKEN_DEF) {
      ctx = p_advance(ctx);
      continue;
    }
    ctx = p_advance(ctx);
    if (p_kind(ctx) != TOKEN_IDENTIFIER) { ctx.err = 102; break; }
    var nameTok = ctx.idx;
    ctx = p_advance(ctx);
    if (p_kind(ctx) != TOKEN_LEFT_PAREN) { ctx.err = 103; break; }
    ctx = p_advance(ctx);
    var paramsStart = -1;
    var paramCount = 0;
    while (p_kind(ctx) != TOKEN_RIGHT_PAREN && p_kind(ctx) != TOKEN_EOF && ctx.err == 0) {
      if (p_kind(ctx) != TOKEN_IDENTIFIER) { ctx.err = 104; break; }
      if (paramsStart == -1) { paramsStart = ctx.idx; }
      paramCount = paramCount + 1;
      ctx = p_advance(ctx);
      if (p_kind(ctx) == TOKEN_COMMA) {
        ctx = p_advance(ctx);
        continue;
      }
      if (p_kind(ctx) != TOKEN_RIGHT_PAREN) { ctx.err = 105; break; }
    }
    if (ctx.err != 0) { break; }
    if (p_kind(ctx) != TOKEN_RIGHT_PAREN) { ctx.err = 105; break; }
    ctx = p_advance(ctx);
    if (isImport == 1) {
      if (p_kind(ctx) != TOKEN_SEMICOLON) { ctx.err = 107; break; }
      ctx = p_advance(ctx);
      ctx.arena = nodearena_push(ctx.arena, Node{NODE_FUNCTION, -1, paramsStart, nameTok, paramCount, isExport, 1});
      continue;
    }
    if (p_kind(ctx) != TOKEN_LEFT_BRACE) { ctx.err = 106; break; }
    var bodyIdx = parse_block(ctx, &ctx);
    if (ctx.err != 0) { break; }
    ctx.arena = nodearena_push(ctx.arena, Node{NODE_FUNCTION, bodyIdx, paramsStart, nameTok, paramCount, isExport, 0});
  }
  if (ctx.err != 0) { return ParseModuleResult{ctx.arena, -1, ctx.err, tokens, src}; }
  var rootCount = ctx.arena.nodes.length - rootStart;
  ctx.arena = nodearena_push(ctx.arena, Node{NODE_BLOCK, rootStart, rootCount, 0, 0, 0, -1});
  var rootIdx = ctx.arena.nodes.length - 1;
  return ParseModuleResult{ctx.arena, rootIdx, ctx.err, tokens, src};
}

// Convenience: parse directly from source.
def parse_module_source(src byte~, n int) ParseModuleResult {
  var toks = scan_tokens(src, n);
  return parse_module(toks, src, n);
}

// ----- Debug/summary helpers -----
def node_kind_name(k int) String {
  if (k == NODE_LITERAL) { return String{byte~(&"LITERAL"[0]), 7}; }
  if (k == NODE_VARIABLE) { return String{byte~(&"VARIABLE"[0]), 8}; }
  if (k == NODE_BINARY) { return String{byte~(&"BINARY"[0]), 6}; }
  if (k == NODE_CALL) { return String{byte~(&"CALL"[0]), 4}; }
  if (k == NODE_RETURN) { return String{byte~(&"RETURN"[0]), 6}; }
  if (k == NODE_VAR_STMT) { return String{byte~(&"VAR_STMT"[0]), 8}; }
  if (k == NODE_FUNCTION) { return String{byte~(&"FUNCTION"[0]), 8}; }
  if (k == NODE_BLOCK) { return String{byte~(&"BLOCK"[0]), 5}; }
  if (k == NODE_ASSIGN) { return String{byte~(&"ASSIGN"[0]), 6}; }
  if (k == NODE_GROUP) { return String{byte~(&"GROUP"[0]), 5}; }
  if (k == NODE_UNARY) { return String{byte~(&"UNARY"[0]), 5}; }
  if (k == NODE_UPDATE) { return String{byte~(&"UPDATE"[0]), 6}; }
  if (k == NODE_LOGICAL) { return String{byte~(&"LOGICAL"[0]), 7}; }
  if (k == NODE_TERNARY) { return String{byte~(&"TERNARY"[0]), 7}; }
  if (k == NODE_INDEX) { return String{byte~(&"INDEX"[0]), 5}; }
  if (k == NODE_DEREF) { return String{byte~(&"DEREF"[0]), 5}; }
  if (k == NODE_DOT) { return String{byte~(&"DOT"[0]), 3}; }
  if (k == NODE_LEN) { return String{byte~(&"LEN"[0]), 3}; }
  if (k == NODE_LIST) { return String{byte~(&"LIST"[0]), 4}; }
  if (k == NODE_CAST) { return String{byte~(&"CAST"[0]), 4}; }
  if (k == NODE_PRINT) { return String{byte~(&"PRINT"[0]), 5}; }
  if (k == NODE_EXPR_STMT) { return String{byte~(&"EXPR_STMT"[0]), 9}; }
  if (k == NODE_IF) { return String{byte~(&"IF"[0]), 2}; }
  if (k == NODE_WHILE) { return String{byte~(&"WHILE"[0]), 5}; }
  if (k == NODE_FOR) { return String{byte~(&"FOR"[0]), 3}; }
  if (k == NODE_BREAK) { return String{byte~(&"BREAK"[0]), 5}; }
  if (k == NODE_CONTINUE) { return String{byte~(&"CONTINUE"[0]), 8}; }
  return String{byte~(&"UNKNOWN"[0]), 7};
}

def tok_string(tokens Vec, idx int, src byte~) String {
  if (idx < 0 || idx >= tokens.length) { return String{src, 0}; }
  var st = token_start_at(tokens, idx);
  var ln = token_length_at(tokens, idx);
  return String{src + st, ln};
}

// Collect parameter identifier names starting at startIdx until right paren.
def param_names_string(tokens Vec, src byte~, startIdx int) String {
  if (startIdx == -1) { return String{src, 0}; }
  var sb = sb_new();
  var i = startIdx;
  var first = 1;
  while (i < tokens.length) {
    var k = token_kind_at(tokens, i);
    if (k == TOKEN_RIGHT_PAREN) { break; }
    if (k == TOKEN_IDENTIFIER) {
      if (first == 0) { sb = sb_append_byte(sb, byte(44)); } // ','
      sb = sb_append_string(sb, tok_string(tokens, i, src));
      first = 0;
    }
    i = i + 1;
  }
  return sb_to_string(sb);
}

def module_summary(res ParseModuleResult) String {
  if (res.err != 0) {
    var sbErr = sb_new();
    sbErr = sb_append_cstr(sbErr, byte~(&"err"[0]));
    sbErr = sb_append_cstr(sbErr, byte~(&" code="[0]));
    sbErr = sb_append_int(sbErr, res.err);
    sbErr = sb_append_cstr(sbErr, byte~(&" tokens="[0]));
    sbErr = sb_append_int(sbErr, res.tokens.length);
    if (res.tokens.length > 0) {
      sbErr = sb_append_cstr(sbErr, byte~(&" first="[0]));
      sbErr = sb_append_int(sbErr, token_kind_at(res.tokens, 0));
    }
    return sb_to_string(sbErr);
  }
  var sb = sb_new();
  sb = sb_append_cstr(sb, byte~(&"root="[0]));
  sb = sb_append_int(sb, res.root);
  sb = sb_append_cstr(sb, byte~(&" count="[0]));
  sb = sb_append_int(sb, res.arena.nodes.length);
  sb = sb_append_byte(sb, byte(10));
  var i = 0;
  while (i < res.arena.nodes.length) {
    var n = nodearena_get(res.arena, i);
    sb = sb_append_cstr(sb, byte~(&"idx="[0]));
    sb = sb_append_int(sb, i);
    sb = sb_append_cstr(sb, byte~(&" kind="[0]));
    sb = sb_append_string(sb, node_kind_name(n.kind));
    sb = sb_append_cstr(sb, byte~(&" a="[0]));
    sb = sb_append_int(sb, n.a);
    sb = sb_append_cstr(sb, byte~(&" b="[0]));
    sb = sb_append_int(sb, n.b);
    sb = sb_append_cstr(sb, byte~(&" c="[0]));
    sb = sb_append_int(sb, n.c);
    sb = sb_append_cstr(sb, byte~(&" d="[0]));
    sb = sb_append_int(sb, n.d);
    if (n.kind == NODE_VAR_STMT) {
      var name = tok_string(res.tokens, n.a, res.src);
      sb = sb_append_cstr(sb, byte~(&" name="[0]));
      sb = sb_append_string(sb, name);
    }
  if (n.kind == NODE_ASSIGN) {
    var aname = tok_string(res.tokens, n.a, res.src);
    sb = sb_append_cstr(sb, byte~(&" name="[0]));
    sb = sb_append_string(sb, aname);
  }
    if (n.kind == NODE_FUNCTION) {
      var fname = tok_string(res.tokens, n.c, res.src);
      sb = sb_append_cstr(sb, byte~(&" name="[0]));
      sb = sb_append_string(sb, fname);
      sb = sb_append_cstr(sb, byte~(&" params="[0]));
      sb = sb_append_int(sb, n.d);
      sb = sb_append_cstr(sb, byte~(&" export="[0]));
      sb = sb_append_int(sb, n.value);
      sb = sb_append_cstr(sb, byte~(&" import="[0]));
      sb = sb_append_int(sb, n.typeId);
      var pnames = param_names_string(res.tokens, res.src, n.b);
      sb = sb_append_cstr(sb, byte~(&" names="[0]));
      sb = sb_append_string(sb, pnames);
    }
    if (n.kind == NODE_IF) {
      sb = sb_append_cstr(sb, byte~(&" then="[0]));
      sb = sb_append_int(sb, n.c);
      sb = sb_append_cstr(sb, byte~(&" else="[0]));
      sb = sb_append_int(sb, n.d);
    }
    if (n.kind == NODE_WHILE) {
      sb = sb_append_cstr(sb, byte~(&" body="[0]));
      sb = sb_append_int(sb, n.c);
    }
  if (n.kind == NODE_FOR) {
    sb = sb_append_cstr(sb, byte~(&" body="[0]));
    sb = sb_append_int(sb, n.d);
  }
    if (n.kind == NODE_BLOCK) {
      sb = sb_append_cstr(sb, byte~(&" start="[0]));
      sb = sb_append_int(sb, n.a);
      sb = sb_append_cstr(sb, byte~(&" count="[0]));
      sb = sb_append_int(sb, n.b);
    }
  if (n.kind == NODE_RETURN || n.kind == NODE_EXPR_STMT || n.kind == NODE_PRINT || n.kind == NODE_VAR_STMT || n.kind == NODE_ASSIGN || n.kind == NODE_IF || n.kind == NODE_WHILE || n.kind == NODE_FOR || n.kind == NODE_BREAK || n.kind == NODE_CONTINUE) {
      sb = sb_append_cstr(sb, byte~(&" span="[0]));
      sb = sb_append_int(sb, n.a);
      sb = sb_append_byte(sb, byte(45)); // '-'
      sb = sb_append_int(sb, n.b);
    }
    sb = sb_append_byte(sb, byte(10));
    i = i + 1;
  }
  return sb_to_string(sb);
}
