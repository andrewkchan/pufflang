// Literal type inference helpers for Stage1 expressions.
// Depends on scanner tokens, types.puff, and typeenv (for TypeEnv).

struct LiteralTypeResult { env TypeEnv, typeId int, err int }

// Infer the type id of a literal token at `tokIdx` in `tokens`. For string
// literals, this allocates a new array type (byte[length]) in the TypeTable and
// updates the TypeEnv. For char literals, returns byte. Returns err=1 on
// unsupported/invalid literal.
def literal_type(env TypeEnv, tokens Vec, tokIdx int, src byte~) LiteralTypeResult {
  var kind = token_kind_at(tokens, tokIdx);
  if (kind == TOKEN_TRUE || kind == TOKEN_FALSE) { return LiteralTypeResult{env, 1, 0}; }
  if (kind == TOKEN_NUMBER || kind == TOKEN_NUMBER_HEX) { return LiteralTypeResult{env, 5, 0}; }
  if (kind == TOKEN_NUMBER_DECIMAL) { return LiteralTypeResult{env, 4, 0}; }
  if (kind == TOKEN_SINGLE_QUOTE_STRING) {
    var chLen = token_length_at(tokens, tokIdx) - 2; // strip quotes
    if (chLen != 1) { return LiteralTypeResult{env, -1, 1}; }
    return LiteralTypeResult{env, 2, 0}; // byte
  }
  if (kind == TOKEN_STRING) {
    var strLen = token_length_at(tokens, tokIdx) - 2; // assumes no escapes
    if (strLen < 0) { return LiteralTypeResult{env, -1, 1}; }
    var tt2 = typetable_make_array(env.tt, 2, strLen);
    var newId = tt2.types.length - 1;
    return LiteralTypeResult{TypeEnv{tt2, env.structSizes}, newId, 0};
  }
  return LiteralTypeResult{env, -1, 1};
}
