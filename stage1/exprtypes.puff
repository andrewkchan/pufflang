// Expression type inference for Stage1 using ParseExprAstResult and helper tables.
// Depends on: ast.puff (Node/NodeArena access), parser_expr.puff (NODE kinds and arena),
// typerules.puff (binary/unary typing), literaltypes.puff (literal typing), typeenv.puff.

struct TypeInferResult { env TypeEnv, typeId int, err int }
def infer_node(env TypeEnv, tokens Vec, src byte~, arena NodeArena, idx int) TypeInferResult {
  var n = nodearena_get(arena, idx);
  // literal
  if (n.kind == NODE_LITERAL) {
    var lit = literal_type(env, tokens, n.a, src);
    return TypeInferResult{lit.env, lit.typeId, lit.err};
  }
  // group
  if (n.kind == NODE_GROUP) {
    return infer_node(env, tokens, src, arena, n.a);
  }
  // unary
  if (n.kind == NODE_UNARY) {
    var opTok = n.a;
    var operand = infer_node(env, tokens, src, arena, n.b);
    if (operand.err == 1) { return operand; }
    var k = token_kind_at(tokens, opTok);
    var op = -1;
    if (k == TOKEN_MINUS) { op = UOP_NEG; }
    if (k == TOKEN_BANG) { op = UOP_NOT; }
    if (k == TOKEN_TILDE) { op = UOP_DEREF; }
    var resId = type_unary_result(operand.env.tt, operand.typeId, op);
    if (resId == -1) { return TypeInferResult{operand.env, -1, 1}; }
    return TypeInferResult{operand.env, resId, 0};
  }
  // logical
  if (n.kind == NODE_LOGICAL) {
    var l = infer_node(env, tokens, src, arena, n.a);
    if (l.err == 1) { return l; }
    var r = infer_node(l.env, tokens, src, arena, n.b);
    if (r.err == 1) { return r; }
    var resId = type_binary_logical_result(r.env.tt, l.typeId, r.typeId, 0);
    if (resId == -1) { return TypeInferResult{r.env, -1, 1}; }
    return TypeInferResult{r.env, resId, 0};
  }
  // binary
  if (n.kind == NODE_BINARY) {
    var l = infer_node(env, tokens, src, arena, n.a);
    if (l.err == 1) { return l; }
    var r = infer_node(l.env, tokens, src, arena, n.b);
    if (r.err == 1) { return r; }
    var k = token_kind_at(tokens, n.c);
    var opId = -1;
    var result = -1;
    // arithmetic / pointer / numeric
    if (k == TOKEN_PLUS) { opId = OP_ADD; result = type_binary_arith_result(r.env.tt, l.typeId, r.typeId, opId); }
    if (k == TOKEN_MINUS) { opId = OP_SUB; result = type_binary_arith_result(r.env.tt, l.typeId, r.typeId, opId); }
    if (k == TOKEN_STAR) { opId = OP_MUL; result = type_binary_arith_result(r.env.tt, l.typeId, r.typeId, opId); }
    if (k == TOKEN_SLASH) { opId = OP_DIV; result = type_binary_arith_result(r.env.tt, l.typeId, r.typeId, opId); }
    if (k == TOKEN_PERCENT) { opId = OP_MOD; result = type_binary_arith_result(r.env.tt, l.typeId, r.typeId, opId); }
    // bitwise
    if (k == TOKEN_AMP) { result = type_binary_bitwise_result(r.env.tt, l.typeId, r.typeId, OP_BIT_AND); }
    if (k == TOKEN_BAR) { result = type_binary_bitwise_result(r.env.tt, l.typeId, r.typeId, OP_BIT_OR); }
    if (k == TOKEN_CARET) { result = type_binary_bitwise_result(r.env.tt, l.typeId, r.typeId, OP_BIT_XOR); }
    // shifts
    if (k == TOKEN_SHIFT_LEFT) { result = type_binary_shift_result(r.env.tt, l.typeId, r.typeId, OP_SHL); }
    if (k == TOKEN_SHIFT_RIGHT) { result = type_binary_shift_result(r.env.tt, l.typeId, r.typeId, OP_SHR); }
    // comparisons
    if (k == TOKEN_LESS) { result = type_binary_compare_result(r.env.tt, l.typeId, r.typeId, OP_LT); }
    if (k == TOKEN_LESS_EQUAL) { result = type_binary_compare_result(r.env.tt, l.typeId, r.typeId, OP_LE); }
    if (k == TOKEN_GREATER) { result = type_binary_compare_result(r.env.tt, l.typeId, r.typeId, OP_GT); }
    if (k == TOKEN_GREATER_EQUAL) { result = type_binary_compare_result(r.env.tt, l.typeId, r.typeId, OP_GE); }
    if (k == TOKEN_EQUAL_EQUAL) { result = type_binary_compare_result(r.env.tt, l.typeId, r.typeId, OP_EQ); }
    if (k == TOKEN_BANG_EQUAL) { result = type_binary_compare_result(r.env.tt, l.typeId, r.typeId, OP_NE); }
    if (result == -1) { return TypeInferResult{r.env, -1, 1}; }
    return TypeInferResult{r.env, result, 0};
  }
  // ternary
  if (n.kind == NODE_TERNARY) {
    var c = infer_node(env, tokens, src, arena, n.a);
    if (c.err == 1) { return c; }
    var t = infer_node(c.env, tokens, src, arena, n.b);
    if (t.err == 1) { return t; }
    var e = infer_node(t.env, tokens, src, arena, n.c);
    if (e.err == 1) { return e; }
    if (type_equals(e.env.tt, t.typeId, e.typeId) == 0) { return TypeInferResult{e.env, -1, 1}; }
    return TypeInferResult{e.env, t.typeId, 0};
  }
  // length
  if (n.kind == NODE_LEN) {
    var inner = infer_node(env, tokens, src, arena, n.a);
    if (inner.err == 1) { return inner; }
    var t = typetable_get(inner.env.tt, inner.typeId);
    if (t.category != TYPECATEGORY_ARRAY) { return TypeInferResult{inner.env, -1, 1}; }
    return TypeInferResult{inner.env, 5, 0}; // int id
  }
  // index
  if (n.kind == NODE_INDEX) {
    var arr = infer_node(env, tokens, src, arena, n.a);
    if (arr.err == 1) { return arr; }
    var idxRes = infer_node(arr.env, tokens, src, arena, n.b);
    if (idxRes.err == 1) { return idxRes; }
    var arrType = typetable_get(idxRes.env.tt, arr.typeId);
    if (arrType.category != TYPECATEGORY_ARRAY) { return TypeInferResult{idxRes.env, -1, 1}; }
    var idxType = typetable_get(idxRes.env.tt, idxRes.typeId);
    if (idxType.category != TYPECATEGORY_INT && idxType.category != TYPECATEGORY_BYTE) { return TypeInferResult{idxRes.env, -1, 1}; }
    return TypeInferResult{idxRes.env, arrType.element, 0};
  }
  // deref (~postfix)
  if (n.kind == NODE_DEREF) {
    var operand = infer_node(env, tokens, src, arena, n.a);
    if (operand.err == 1) { return operand; }
    var tptr = typetable_get(operand.env.tt, operand.typeId);
    if (tptr.category != TYPECATEGORY_POINTER) { return TypeInferResult{operand.env, -1, 1}; }
    return TypeInferResult{operand.env, tptr.element, 0};
  }
  // update (++/--)
  if (n.kind == NODE_UPDATE) {
    var opnd = infer_node(env, tokens, src, arena, n.b);
    if (opnd.err == 1) { return opnd; }
    var cat = typetable_get(opnd.env.tt, opnd.typeId).category;
    if (cat != TYPECATEGORY_INT && cat != TYPECATEGORY_BYTE) { return TypeInferResult{opnd.env, -1, 1}; }
    return TypeInferResult{opnd.env, opnd.typeId, 0};
  }
  // assignment (expression form only; statement assignment left token unsupported)
  if (n.kind == NODE_ASSIGN) {
    if (n.c == 0) { return TypeInferResult{env, -1, 1}; } // statement assignment (identifier token), skip
    var lhs = infer_node(env, tokens, src, arena, n.a);
    if (lhs.err == 1) { return lhs; }
    var rhs = infer_node(lhs.env, tokens, src, arena, n.b);
    if (rhs.err == 1) { return rhs; }
    if (type_can_coerce(rhs.env.tt, rhs.typeId, lhs.typeId) == 0 && type_can_cast(rhs.env.tt, rhs.typeId, lhs.typeId) == 0) {
      return TypeInferResult{rhs.env, -1, 1};
    }
    return TypeInferResult{rhs.env, lhs.typeId, 0};
  }
  return TypeInferResult{env, -1, 1};
}

// Infer type for expression source; returns updated env to persist newly allocated types.
def infer_expression_type(env TypeEnv, src byte~, n int) TypeInferResult {
  var parsed = parse_expr_ast(src, n);
  if (parsed.err == 1) { return TypeInferResult{env, -1, 1}; }
  return infer_node(env, parsed.tokens, parsed.src, parsed.arena, parsed.root);
}
