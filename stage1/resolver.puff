// Stage1 Puffscript resolver (minimal):
// - require non-empty token stream
// - require trailing EOF
// - require at least one RETURN token
def resolve_simple(tokens VecInt) int {
  if (tokens.length == 0) { return 0; }
  var last = vecint_get(tokens, tokens.length - 1);
  if (last != TOKEN_EOF) { return 0; }
  var hasReturn = 0;
  var i = 0;
  while (i < tokens.length) {
    if (vecint_get(tokens, i) == TOKEN_RETURN) { hasReturn = 1; }
    i = i + 1;
  }
  if (hasReturn == 0) { return 0; }
  return 1;
}

// --- Simple scope tracking for var uniqueness ---
struct ScopeNames { names VecStr, depths VecInt, depth int }

def scope_names_new() ScopeNames {
  return ScopeNames{vecstr_new(8), vecint_new(8), 0};
}

def scope_names_enter(s ScopeNames) ScopeNames {
  return ScopeNames{s.names, s.depths, s.depth + 1};
}

def scope_names_exit(s ScopeNames) ScopeNames {
  if (s.depth == 0) { return s; }
  var names = s.names;
  var depths = s.depths;
  var d = s.depth;
  while (names.length > 0 && vecint_get(depths, names.length - 1) == d) {
    var popped = vecstr_pop(names);
    names = popped.vec;
    var pd = vecint_pop(depths);
    depths = pd.vec;
  }
  return ScopeNames{names, depths, d - 1};
}

def scope_names_lookup_current(s ScopeNames, name String) int {
  var i = s.names.length;
  while (i > 0) {
    i = i - 1;
    if (vecint_get(s.depths, i) != s.depth) { break; }
    var n = vecstr_get(s.names, i);
    if (str_eq(n.data, n.length, name.data, name.length) == 1) { return 1; }
  }
  return 0;
}

def scope_names_define(s ScopeNames, name String) ScopeNames {
  var names = s.names;
  var depths = s.depths;
  var clone = str_clone(name.data, name.length);
  names = vecstr_push(names, clone);
  depths = vecint_push(depths, s.depth);
  return ScopeNames{names, depths, s.depth};
}

// Resolve with duplicate-var detection and return presence using depth scopes.
// Returns 1 if ok, 0 on error.
def resolve_with_scopes(src byte~, n int) int {
  var tokens = scan_tokens(src, n);
  if (tokens.length == 0) { return 0; }
  var lastKind = token_kind_at(tokens, tokens.length - 1);
  if (lastKind != TOKEN_EOF) { return 0; }
  var hasReturn = 0;
  var scope = scope_new_root();
  var i = 0;
  while (i < tokens.length) {
    var k = token_kind_at(tokens, i);
    if (k == TOKEN_LEFT_BRACE) { scope = scope_enter(scope); i = i + 1; continue; }
    if (k == TOKEN_RIGHT_BRACE) { scope = scope_exit(scope); i = i + 1; continue; }
    if (k == TOKEN_VAR) {
      var nameTok = i + 1;
      if (nameTok >= tokens.length) { return 0; }
      var name = String{token_start_at(tokens, nameTok) + src, token_length_at(tokens, nameTok)};
      var dup = scope_lookup_index_current(scope, name);
      if (dup != -1) { return 0; }
      var res = scope_define_var(scope, name, -1);
      scope = res.scope;
    }
    if (k == TOKEN_RETURN) { hasReturn = 1; }
    i = i + 1;
  }
  if (hasReturn == 0) { return 0; }
  return 1;
}

// Resolve using depth-based Scope helpers from ast.puff.
// Rules:
// - require trailing EOF
// - require at least one RETURN
// - duplicate var in same depth -> error
// - inner scopes can shadow outer vars
def resolve_with_scope2(src byte~, n int) int {
  var tokens = scan_tokens(src, n);
  if (tokens.length == 0) { return 0; }
  var lastKind = token_kind_at(tokens, tokens.length - 1);
  if (lastKind != TOKEN_EOF) { return 0; }
  var hasReturn = 0;
  var scope = scope_new_root();
  var i = 0;
  while (i < tokens.length) {
    var k = token_kind_at(tokens, i);
    if (k == TOKEN_LEFT_BRACE) { scope = scope_enter(scope); i = i + 1; continue; }
    if (k == TOKEN_RIGHT_BRACE) { scope = scope_exit(scope); i = i + 1; continue; }
    if (k == TOKEN_VAR) {
      var nameTok = i + 1;
      if (nameTok >= tokens.length) { return 0; }
      var name = String{token_start_at(tokens, nameTok) + src, token_length_at(tokens, nameTok)};
      var dup = scope_lookup_index_current(scope, name);
      if (dup != -1) { return 0; }
      var res = scope_define_var(scope, name, -1);
      scope = res.scope;
    }
    if (k == TOKEN_RETURN) { hasReturn = 1; }
    i = i + 1;
  }
  if (hasReturn == 0) { return 0; }
  return 1;
}

// ------------------------------------------------------------
// Incremental resolver scaffolding (non-breaking for existing tests)
// ------------------------------------------------------------

// Generic ok/fail helpers for future extension.
def resolve_ok() int { return 1; }
def resolve_fail() int { return 0; }

// Block resolver using Scope helpers; returns updated scope and index after closing brace.
struct ResolveBlockResult { scope Scope, idx int, ok int, hasRet int }

def resolve_block(scope Scope, tokens Vec, src byte~, startIdx int) ResolveBlockResult {
  var s = scope_enter(scope);
  var i = startIdx + 1; // assume '{' at startIdx
  var hasRet = 0;
  while (i < tokens.length) {
    var k = token_kind_at(tokens, i);
    if (k == TOKEN_LEFT_BRACE) {
      var inner = resolve_block(s, tokens, src, i);
      if (inner.ok == 0) { return ResolveBlockResult{s, i, 0, hasRet}; }
      s = inner.scope;
      if (inner.hasRet == 1) { hasRet = 1; }
      i = inner.idx;
      continue;
    }
    if (k == TOKEN_RIGHT_BRACE) {
      s = scope_exit(s);
      return ResolveBlockResult{s, i + 1, 1, hasRet};
    }
    if (k == TOKEN_VAR) {
      var nameTok = i + 1;
      if (nameTok >= tokens.length) { return ResolveBlockResult{s, i, 0, hasRet}; }
      var name = String{src + token_start_at(tokens, nameTok), token_length_at(tokens, nameTok)};
      var dup = scope_lookup_index_current(s, name);
      if (dup != -1) { return ResolveBlockResult{s, i, 0, hasRet}; }
      var res = scope_define_var(s, name, -1);
      s = res.scope;
      i = i + 2;
      continue;
    }
    if (k == TOKEN_RETURN) { hasRet = 1; }
    i = i + 1;
  }
  return ResolveBlockResult{s, i, 0, hasRet};
}

// High-level resolver that:
// - requires trailing EOF
// - checks duplicate vars per scope
// - ensures at least one return somewhere
def resolve_module_tokens(src byte~, n int) int {
  var tokens = scan_tokens(src, n);
  if (tokens.length == 0) { return 0; }
  var lastKind = token_kind_at(tokens, tokens.length - 1);
  if (lastKind != TOKEN_EOF) { return 0; }
  var scope = scope_new_root();
  var hasRet = 0;
  var i = 0;
  while (i < tokens.length) {
    var k = token_kind_at(tokens, i);
    if (k == TOKEN_LEFT_BRACE) {
      var blk = resolve_block(scope, tokens, src, i);
      if (blk.ok == 0) { return 0; }
      scope = blk.scope;
      if (blk.hasRet == 1) { hasRet = 1; }
      i = blk.idx;
      continue;
    }
    if (k == TOKEN_VAR) {
      var nameTok = i + 1;
      if (nameTok >= tokens.length) { return 0; }
      var name = String{src + token_start_at(tokens, nameTok), token_length_at(tokens, nameTok)};
      var dup = scope_lookup_index_current(scope, name);
      if (dup != -1) { return 0; }
      var res = scope_define_var(scope, name, -1);
      scope = res.scope;
      i = i + 2;
      continue;
    }
    if (k == TOKEN_RETURN) { hasRet = 1; }
    i = i + 1;
  }
  if (hasRet == 0) { return 0; }
  return 1;
}

// ------------------------------------------------------------
// AST-based resolver (parse_full + expression AST)
// ------------------------------------------------------------

struct ResolveCtx {
  arena NodeArena,
  tokens Vec,
  src byte~,
  scope Scope,
  types TypeTable,
  tm TypeModuleTypes,
  currentFnIdx int,
  currentRetType int,
  err int,
  hasReturn int
}

def tok_str(tokens Vec, idx int, src byte~) String {
  if (idx < 0 || idx >= tokens.length) { return String{src, 0}; }
  var st = token_start_at(tokens, idx);
  var ln = token_length_at(tokens, idx);
  return String{src + st, ln};
}

def range_contains(starts VecInt, ends VecInt, idx int) int {
  var i = 0;
  while (i < starts.length) {
    var s = vecint_get(starts, i);
    var e = vecint_get(ends, i);
    if (idx >= s && idx <= e) { return 1; }
    i = i + 1;
  }
  return 0;
}

// Collect ranges covered by a referenced block (inclusive of the block node index).
// Resolve an expression tree; sets ctx.err on failure.
def resolve_expr(ctx ResolveCtx, idx int) ResolveCtx {
  var r = ctx;
  if (idx == -1) { return r; }
  var n = nodearena_get(r.arena, idx);
  var k = n.kind;
  if (k == NODE_LITERAL) { return r; }
  if (k == NODE_VARIABLE) {
    var name = tok_str(r.tokens, n.a, r.src);
    var found = scope_lookup_index_any(r.scope, name);
    if (found == -1) { r.err = 1; return r; }
    return r;
  }
  if (k == NODE_GROUP || k == NODE_LEN || k == NODE_DEREF) {
    return resolve_expr(r, n.a);
  }
  if (k == NODE_UNARY || k == NODE_UPDATE) {
    return resolve_expr(r, n.b);
  }
  if (k == NODE_BINARY || k == NODE_LOGICAL) {
    r = resolve_expr(r, n.a);
    if (r.err == 1) { return r; }
    return resolve_expr(r, n.b);
  }
  if (k == NODE_TERNARY) {
    r = resolve_expr(r, n.a);
    if (r.err == 1) { return r; }
    r = resolve_expr(r, n.b);
    if (r.err == 1) { return r; }
    return resolve_expr(r, n.c);
  }
  if (k == NODE_CALL) {
    // resolve callee and args
    r = resolve_expr(r, n.a);
    if (r.err == 1) { return r; }
    var calleeNode = nodearena_get(r.arena, n.a);
    if (calleeNode.kind == NODE_VARIABLE) {
      var name = tok_str(r.tokens, calleeNode.a, r.src);
      var info = scope_lookup_info(r.scope, name);
      if (info.kind == SYMKIND_FUNCTION || info.kind == SYMKIND_FUNCTION_OVERLOAD) {
        var argc = n.c;
        var ok = 0;
        if (info.arityA == -1 && info.arityB == -1) { ok = 1; }
        if (info.arityA == argc) { ok = 1; }
        if (info.arityB == argc) { ok = 1; }
        if (ok == 0) { r.err = 1; return r; }
      } else if (info.kind == 0) {
        r.err = 1;
        return r;
      }
    }
    var head = n.b;
    while (head != -1 && r.err == 0) {
      var argNode = nodearena_get(r.arena, head);
      r = resolve_expr(r, argNode.a);
      head = argNode.b;
    }
    return r;
  }
  if (k == NODE_INDEX) {
    r = resolve_expr(r, n.a);
    if (r.err == 1) { return r; }
    return resolve_expr(r, n.b);
  }
  if (k == NODE_DOT) {
    return resolve_expr(r, n.a);
  }
  if (k == NODE_LIST) {
    r = resolve_expr(r, n.a);
    if (r.err == 1) { return r; }
    if (n.b != -1) { r = resolve_expr(r, n.b); }
    return r;
  }
  if (k == NODE_ASSIGN) {
    if (n.c != 0) {
      // expression assignment: lhs is an expression node
      r = resolve_expr(r, n.a);
      if (r.err == 1) { return r; }
      return resolve_expr(r, n.b);
    }
    // statement assignment: lhs is a token
    var nameTok = n.a;
    var name = tok_str(r.tokens, nameTok, r.src);
    var foundIdx = scope_lookup_index_any(r.scope, name);
    if (foundIdx == -1) { r.err = 1; return r; }
    return resolve_expr(r, n.b);
  }
  return r;
}

def is_statement_kind(k int) int {
  if (k == NODE_VAR_STMT) { return 1; }
  if (k == NODE_RETURN) { return 1; }
  if (k == NODE_PRINT) { return 1; }
  if (k == NODE_IF) { return 1; }
  if (k == NODE_WHILE) { return 1; }
  if (k == NODE_FOR) { return 1; }
  if (k == NODE_BREAK) { return 1; }
  if (k == NODE_CONTINUE) { return 1; }
  if (k == NODE_ASSIGN) { return 1; }
  if (k == NODE_EXPR_STMT) { return 1; }
  return 0;
}

// Resolve a single statement node by index (with current scope and loop depth).
def resolve_statement(ctx ResolveCtx, stmtIdx int, loopDepth int) ResolveCtx {
  var r = ctx;
  var n = nodearena_get(r.arena, stmtIdx);
  var k = n.kind;
  if (k == NODE_VAR_STMT) {
    var name = tok_str(r.tokens, n.a, r.src);
    var vtype = tm_var_type_by_node(r.tm, stmtIdx);
    var res = scope_define_var(r.scope, name, vtype);
    if (res.err != 0) { r.err = 1; return r; }
    r.scope = res.scope;
    r = resolve_expr(r, n.b);
    return r;
  }
  if (k == NODE_ASSIGN) {
    var name = tok_str(r.tokens, n.a, r.src);
    var found = scope_lookup_index_any(r.scope, name);
    if (found == -1) { r.err = 1; return r; }
    r = resolve_expr(r, n.b);
    return r;
  }
  if (k == NODE_RETURN) {
    if (r.currentRetType != -1 && r.currentRetType != 8 && n.a == -1) {
      r.err = 1; return r;
    }
    r.hasReturn = 1;
    if (n.a != -1) { r = resolve_expr(r, n.a); }
    return r;
  }
  if (k == NODE_PRINT || k == NODE_EXPR_STMT) { r = resolve_expr(r, n.a); return r; }
  if (k == NODE_BREAK) { if (loopDepth <= 0) { r.err = 1; return r; } r = resolve_expr(r, n.a); return r; }
  if (k == NODE_CONTINUE) { if (loopDepth <= 0) { r.err = 1; return r; } r = resolve_expr(r, n.a); return r; }
  if (k == NODE_IF) {
    r = resolve_expr(r, n.a);
    if (r.err == 1) { return r; }
    if (n.b != -1) {
      var thenNode = nodearena_get(r.arena, n.b);
      if (thenNode.kind == NODE_BLOCK) { r = resolve_block_nodes(r, n.b, loopDepth); }
      else { r = resolve_statement(r, n.b, loopDepth); }
    }
    if (r.err == 1) { return r; }
    if (n.c != -1) {
      var elseNode = nodearena_get(r.arena, n.c);
      if (elseNode.kind == NODE_BLOCK) { r = resolve_block_nodes(r, n.c, loopDepth); }
      else { r = resolve_statement(r, n.c, loopDepth); }
    }
    return r;
  }
  if (k == NODE_WHILE) {
    r = resolve_expr(r, n.a);
    if (r.err == 1) { return r; }
    if (n.b != -1) {
      var body = nodearena_get(r.arena, n.b);
      if (body.kind == NODE_BLOCK) { r = resolve_block_nodes(r, n.b, loopDepth + 1); }
      else { r = resolve_statement(r, n.b, loopDepth + 1); }
    }
    return r;
  }
  if (k == NODE_FOR) {
    if (n.a != -1) { r = resolve_expr(r, n.a); }
    if (r.err == 1) { return r; }
    if (n.b != -1) { r = resolve_expr(r, n.b); }
    if (r.err == 1) { return r; }
    if (n.c != -1) { r = resolve_expr(r, n.c); }
    if (r.err == 1) { return r; }
    if (n.d != -1) {
      var body2 = nodearena_get(r.arena, n.d);
      if (body2.kind == NODE_BLOCK) { r = resolve_block_nodes(r, n.d, loopDepth + 1); }
      else { r = resolve_statement(r, n.d, loopDepth + 1); }
    }
    return r;
  }
  if (k == NODE_BLOCK) {
    return resolve_block_nodes(r, stmtIdx, loopDepth);
  }
  return r;
}

// Resolve a block by walking only its direct statements (depth + loopDepth carried in).
def resolve_block_nodes(ctx ResolveCtx, blockIdx int, loopDepth int) ResolveCtx {
  var r = ctx;
  var blk = nodearena_get(r.arena, blockIdx);
  var start = blk.a;
  var end = blk.a + blk.b;

  // Precompute nested block ranges to skip linear scanning of child contents here.
  var childStarts = vecint_new(8);
  var childEnds = vecint_new(8);
  var scan = start;
  while (scan < end) {
    if (scan == blockIdx) { scan = scan + 1; continue; }
    var bn = nodearena_get(r.arena, scan);
    if (bn.kind == NODE_BLOCK) {
      childStarts = vecint_push(childStarts, bn.a);
      childEnds = vecint_push(childEnds, bn.a + bn.b);
    }
    scan = scan + 1;
  }

  r.scope = scope_enter(r.scope);
  var i = start;
  while (i < end && r.err == 0) {
    // Skip over child block contents (they are handled via parent statements).
    var j = 0;
    var skipped = 0;
    while (j < childStarts.length) {
      var cs = vecint_get(childStarts, j);
      var ce = vecint_get(childEnds, j);
      if (i >= cs && i < ce) {
        i = ce;
        skipped = 1;
        break;
      }
      j = j + 1;
    }
    if (skipped == 1) { continue; }

    var n2 = nodearena_get(r.arena, i);
    // Skip nested block nodes here; they are traversed via their parent statements.
    if (n2.kind != NODE_BLOCK && is_statement_kind(n2.kind) == 1) {
      r = resolve_statement(r, i, loopDepth);
    }
    i = i + 1;
  }
  r.scope = scope_exit(r.scope);
  return r;
}

// Resolve a function node: define params in a nested scope and resolve the body.
def resolve_function(ctx ResolveCtx, fn Node, fi int) ResolveCtx {
  var r = ctx;
  var fnScope = scope_enter(r.scope);
  // parameters
  var added = 0;
  var idx = fn.b;
  while (idx != -1 && added < fn.d) {
    if (idx >= r.tokens.length) { break; }
    var k = token_kind_at(r.tokens, idx);
    if (k == TOKEN_IDENTIFIER) {
      var name = tok_str(r.tokens, idx, r.src);
      var paramType = -1;
      if (fi != -1) { paramType = tm_fn_param_type(r.tm, fi, added); }
      var res = scope_define_var(fnScope, name, paramType);
      if (res.err != 0) { r.err = 1; return r; }
      fnScope = res.scope;
      added = added + 1;
    }
    idx = idx + 1;
  }
  var bodyIdx = fn.a;
  var retType = -1;
  if (fi != -1) { retType = tm_fn_return_type(r.tm, fi); }
  var fnCtx = ResolveCtx{r.arena, r.tokens, r.src, fnScope, r.types, r.tm, fi, retType, 0, 0};
  if (bodyIdx != -1) {
    fnCtx = resolve_block_nodes(fnCtx, bodyIdx, 0);
  }
  if (fnCtx.err == 1) { r.err = 1; return r; }
  if (fnCtx.hasReturn == 0) { r.err = 1; return r; }
  r.hasReturn = 1;
  return r;
}

def vecint_find(v VecInt, target int) int {
  var i = 0;
  while (i < v.length) {
    if (vecint_get(v, i) == target) { return i; }
    i = i + 1;
  }
  return -1;
}

// Main AST-based module resolver.
def resolve_module_ast(src byte~, n int) int {
  var pmr = parse_module_source(src, n);
  if (pmr.err != 0) { return 0; }

  var tm = module_type_ids(pmr);
  if (tm.err == 1) { return 0; }

  // Precompute ranges for function bodies to separate global scope definitions.
  var fnStarts = vecint_new(4);
  var fnEnds = vecint_new(4);
  var i = 0;
  while (i < pmr.arena.nodes.length) {
    var node = nodearena_get(pmr.arena, i);
    if (node.kind == NODE_FUNCTION && node.a != -1) {
      var blk = nodearena_get(pmr.arena, node.a);
      fnStarts = vecint_push(fnStarts, blk.a);
      fnEnds = vecint_push(fnEnds, node.a);
    }
    i = i + 1;
  }

  var scope = scope_new_root();
  var types = tm.env.tt;

  // First pass: define globals (vars, structs, functions) outside function bodies.
  i = 0;
  while (i < pmr.arena.nodes.length) {
    if (range_contains(fnStarts, fnEnds, i) == 1) { i = i + 1; continue; }
    var n0 = nodearena_get(pmr.arena, i);
    if (n0.kind == NODE_VAR_STMT) {
      var name = tok_str(pmr.tokens, n0.a, pmr.src);
      var vi = vecint_find(pmr.meta.varNodeIndex, i);
      var vtid = -1;
      if (vi != -1 && vi < tm.varTypeIds.length) { vtid = vecint_get(tm.varTypeIds, vi); }
      var resVar = scope_define_var(scope, name, vtid);
      if (resVar.err != 0) { return 0; }
      scope = resVar.scope;
    } else if (n0.kind == NODE_STRUCT_DECL) {
      var nameS = tok_str(pmr.tokens, n0.c, pmr.src);
      var si = vecint_find(pmr.meta.structNodeIndex, i);
      var stid = -1;
      if (si != -1 && si < tm.structTypeIds.length) { stid = vecint_get(tm.structTypeIds, si); }
      var resS = scope_define_struct(scope, nameS, stid);
      if (resS.err != 0) { return 0; }
      scope = resS.scope;
    } else if (n0.kind == NODE_FUNCTION) {
      var nameF = tok_str(pmr.tokens, n0.c, pmr.src);
      var fi = vecint_find(pmr.meta.fnNodeIndex, i);
      var retId = -1;
      if (fi != -1 && fi < tm.fnReturnTypeId.length) { retId = vecint_get(tm.fnReturnTypeId, fi); }
      var resF = scope_define_function(scope, nameF, n0.d, retId, n0.value, n0.typeId);
      if (resF.err != 0) { return 0; }
      scope = resF.scope;
    }
    i = i + 1;
  }
  // Resolve global initializers (outside function bodies).
  var ctx = ResolveCtx{pmr.arena, pmr.tokens, pmr.src, scope, types, tm, -1, -1, 0, 0};
  i = 0;
  while (i < pmr.arena.nodes.length && ctx.err == 0) {
    if (range_contains(fnStarts, fnEnds, i) == 1) { i = i + 1; continue; }
    var n1 = nodearena_get(pmr.arena, i);
    if (n1.kind == NODE_VAR_STMT) {
      ctx = resolve_expr(ctx, n1.b);
    } else if (n1.kind == NODE_ASSIGN) {
      var nameA = tok_str(pmr.tokens, n1.a, pmr.src);
      var idxFound = scope_lookup_index_any(ctx.scope, nameA);
      if (idxFound == -1) { ctx.err = 1; }
      ctx = resolve_expr(ctx, n1.b);
    }
    i = i + 1;
  }
  if (ctx.err == 1) { return 0; }
  // Resolve functions.
  i = 0;
  while (i < pmr.arena.nodes.length && ctx.err == 0) {
    var n2 = nodearena_get(pmr.arena, i);
    if (n2.kind == NODE_FUNCTION) {
      var fi = vecint_find(tm.fnNodeIndex, i);
      ctx = resolve_function(ctx, n2, fi);
    }
    i = i + 1;
  }
  if (ctx.err == 1) { return 0; }
  if (ctx.hasReturn == 0) { return 0; }
  return 1;
}
