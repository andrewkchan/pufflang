// Stage1 Puffscript resolver (minimal):
// - require non-empty token stream
// - require trailing EOF
// - require at least one RETURN token
def resolve_simple(tokens VecInt) int {
  if (tokens.length == 0) { return 0; }
  var last = vecint_get(tokens, tokens.length - 1);
  if (last != TOKEN_EOF) { return 0; }
  var hasReturn = 0;
  var i = 0;
  while (i < tokens.length) {
    if (vecint_get(tokens, i) == TOKEN_RETURN) { hasReturn = 1; }
    i = i + 1;
  }
  if (hasReturn == 0) { return 0; }
  return 1;
}

// --- Simple scope tracking for var uniqueness ---
struct ScopeNames { names VecStr, depths VecInt, depth int }

def scope_names_new() ScopeNames {
  return ScopeNames{vecstr_new(8), vecint_new(8), 0};
}

def scope_names_enter(s ScopeNames) ScopeNames {
  return ScopeNames{s.names, s.depths, s.depth + 1};
}

def scope_names_exit(s ScopeNames) ScopeNames {
  if (s.depth == 0) { return s; }
  var names = s.names;
  var depths = s.depths;
  var d = s.depth;
  while (names.length > 0 && vecint_get(depths, names.length - 1) == d) {
    var popped = vecstr_pop(names);
    names = popped.vec;
    var pd = vecint_pop(depths);
    depths = pd.vec;
  }
  return ScopeNames{names, depths, d - 1};
}

def scope_names_lookup_current(s ScopeNames, name String) int {
  var i = s.names.length;
  while (i > 0) {
    i = i - 1;
    if (vecint_get(s.depths, i) != s.depth) { break; }
    var n = vecstr_get(s.names, i);
    if (str_eq(n.data, n.length, name.data, name.length) == 1) { return 1; }
  }
  return 0;
}

def scope_names_define(s ScopeNames, name String) ScopeNames {
  var names = s.names;
  var depths = s.depths;
  var clone = str_clone(name.data, name.length);
  names = vecstr_push(names, clone);
  depths = vecint_push(depths, s.depth);
  return ScopeNames{names, depths, s.depth};
}

// Resolve with duplicate-var detection and return presence using depth scopes.
// Returns 1 if ok, 0 on error.
def resolve_with_scopes(src byte~, n int) int {
  var tokens = scan_tokens(src, n);
  if (tokens.length == 0) { return 0; }
  var lastKind = token_kind_at(tokens, tokens.length - 1);
  if (lastKind != TOKEN_EOF) { return 0; }
  var hasReturn = 0;
  var scope = scope_new_root();
  var i = 0;
  while (i < tokens.length) {
    var k = token_kind_at(tokens, i);
    if (k == TOKEN_LEFT_BRACE) { scope = scope_enter(scope); i = i + 1; continue; }
    if (k == TOKEN_RIGHT_BRACE) { scope = scope_exit(scope); i = i + 1; continue; }
    if (k == TOKEN_VAR) {
      var nameTok = i + 1;
      if (nameTok >= tokens.length) { return 0; }
      var name = String{token_start_at(tokens, nameTok) + src, token_length_at(tokens, nameTok)};
      var dup = scope_lookup_index_current(scope, name);
      if (dup != -1) { return 0; }
      var res = scope_define_var(scope, name, -1);
      scope = res.scope;
    }
    if (k == TOKEN_RETURN) { hasReturn = 1; }
    i = i + 1;
  }
  if (hasReturn == 0) { return 0; }
  return 1;
}

// Resolve using depth-based Scope helpers from ast.puff.
// Rules:
// - require trailing EOF
// - require at least one RETURN
// - duplicate var in same depth -> error
// - inner scopes can shadow outer vars
def resolve_with_scope2(src byte~, n int) int {
  var tokens = scan_tokens(src, n);
  if (tokens.length == 0) { return 0; }
  var lastKind = token_kind_at(tokens, tokens.length - 1);
  if (lastKind != TOKEN_EOF) { return 0; }
  var hasReturn = 0;
  var scope = scope_new_root();
  var i = 0;
  while (i < tokens.length) {
    var k = token_kind_at(tokens, i);
    if (k == TOKEN_LEFT_BRACE) { scope = scope_enter(scope); i = i + 1; continue; }
    if (k == TOKEN_RIGHT_BRACE) { scope = scope_exit(scope); i = i + 1; continue; }
    if (k == TOKEN_VAR) {
      var nameTok = i + 1;
      if (nameTok >= tokens.length) { return 0; }
      var name = String{token_start_at(tokens, nameTok) + src, token_length_at(tokens, nameTok)};
      var dup = scope_lookup_index_current(scope, name);
      if (dup != -1) { return 0; }
      var res = scope_define_var(scope, name, -1);
      scope = res.scope;
    }
    if (k == TOKEN_RETURN) { hasReturn = 1; }
    i = i + 1;
  }
  if (hasReturn == 0) { return 0; }
  return 1;
}

// ------------------------------------------------------------
// Incremental resolver scaffolding (non-breaking for existing tests)
// ------------------------------------------------------------

// Generic ok/fail helpers for future extension.
def resolve_ok() int { return 1; }
def resolve_fail() int { return 0; }

// Block resolver using Scope helpers; returns updated scope and index after closing brace.
struct ResolveBlockResult { scope Scope, idx int, ok int, hasRet int }

def resolve_block(scope Scope, tokens Vec, src byte~, startIdx int) ResolveBlockResult {
  var s = scope_enter(scope);
  var i = startIdx + 1; // assume '{' at startIdx
  var hasRet = 0;
  while (i < tokens.length) {
    var k = token_kind_at(tokens, i);
    if (k == TOKEN_LEFT_BRACE) {
      var inner = resolve_block(s, tokens, src, i);
      if (inner.ok == 0) { return ResolveBlockResult{s, i, 0, hasRet}; }
      s = inner.scope;
      if (inner.hasRet == 1) { hasRet = 1; }
      i = inner.idx;
      continue;
    }
    if (k == TOKEN_RIGHT_BRACE) {
      s = scope_exit(s);
      return ResolveBlockResult{s, i + 1, 1, hasRet};
    }
    if (k == TOKEN_VAR) {
      var nameTok = i + 1;
      if (nameTok >= tokens.length) { return ResolveBlockResult{s, i, 0, hasRet}; }
      var name = String{src + token_start_at(tokens, nameTok), token_length_at(tokens, nameTok)};
      var dup = scope_lookup_index_current(s, name);
      if (dup != -1) { return ResolveBlockResult{s, i, 0, hasRet}; }
      var res = scope_define_var(s, name, -1);
      s = res.scope;
      i = i + 2;
      continue;
    }
    if (k == TOKEN_RETURN) { hasRet = 1; }
    i = i + 1;
  }
  return ResolveBlockResult{s, i, 0, hasRet};
}

// High-level resolver that:
// - requires trailing EOF
// - checks duplicate vars per scope
// - ensures at least one return somewhere
def resolve_module_tokens(src byte~, n int) int {
  var tokens = scan_tokens(src, n);
  if (tokens.length == 0) { return 0; }
  var lastKind = token_kind_at(tokens, tokens.length - 1);
  if (lastKind != TOKEN_EOF) { return 0; }
  var scope = scope_new_root();
  var hasRet = 0;
  var i = 0;
  while (i < tokens.length) {
    var k = token_kind_at(tokens, i);
    if (k == TOKEN_LEFT_BRACE) {
      var blk = resolve_block(scope, tokens, src, i);
      if (blk.ok == 0) { return 0; }
      scope = blk.scope;
      if (blk.hasRet == 1) { hasRet = 1; }
      i = blk.idx;
      continue;
    }
    if (k == TOKEN_VAR) {
      var nameTok = i + 1;
      if (nameTok >= tokens.length) { return 0; }
      var name = String{src + token_start_at(tokens, nameTok), token_length_at(tokens, nameTok)};
      var dup = scope_lookup_index_current(scope, name);
      if (dup != -1) { return 0; }
      var res = scope_define_var(scope, name, -1);
      scope = res.scope;
      i = i + 2;
      continue;
    }
    if (k == TOKEN_RETURN) { hasRet = 1; }
    i = i + 1;
  }
  if (hasRet == 0) { return 0; }
  return 1;
}

// ------------------------------------------------------------
// AST-based resolver (parse_full + expression AST)
// ------------------------------------------------------------

struct ResolveCtx {
  arena NodeArena,
  tokens Vec,
  src byte~,
  scope Scope,
  env TypeEnv,
  tm TypeModuleTypes,
  currentFnIdx int,
  currentRetType int,
  err int,
  hasReturn int
}

def tok_str(tokens Vec, idx int, src byte~) String {
  if (idx < 0 || idx >= tokens.length) { return String{src, 0}; }
  var st = token_start_at(tokens, idx);
  var ln = token_length_at(tokens, idx);
  return String{src + st, ln};
}

def range_contains(starts VecInt, ends VecInt, idx int) int {
  var i = 0;
  while (i < starts.length) {
    var s = vecint_get(starts, i);
    var e = vecint_get(ends, i);
    if (idx >= s && idx <= e) { return 1; }
    i = i + 1;
  }
  return 0;
}

struct InferResult { ctx ResolveCtx, typeId int }

def ctx_set_type(ctx ResolveCtx, nodeIdx int, typeId int) ResolveCtx {
  if (typeId != -1) {
    ctx.arena = nodearena_set_type(ctx.arena, nodeIdx, typeId);
  }
  return ctx;
}

// Find a function index in tm by name and arity.
def find_fn_index_by_name_arity(tm TypeModuleTypes, arena NodeArena, tokens Vec, src byte~, name String, argc int) int {
  var i = 0;
  while (i < tm.fnNodeIndex.length) {
    var fnIdx = vecint_get(tm.fnNodeIndex, i);
    var fnNode = nodearena_get(arena, fnIdx);
    var fnName = tok_str(tokens, fnNode.c, src);
    if (str_eq(fnName.data, fnName.length, name.data, name.length) == 1) {
      if (fnNode.d == argc) { return i; }
    }
    i = i + 1;
  }
  return -1;
}

def struct_index_for_type(tm TypeModuleTypes, typeId int) int {
  return tm_struct_index_for_type(tm, typeId);
}

def struct_field_index_by_name(tm TypeModuleTypes, structIdx int, tokens Vec, src byte~, name String) int {
  if (structIdx < 0 || structIdx >= tm.structFieldNameStart.length) { return -1; }
  var start = vecint_get(tm.structFieldNameStart, structIdx);
  var count = vecint_get(tm.structFieldCount, structIdx);
  var i = 0;
  while (i < count) {
    var tokIdx = vecint_get(tm.structFieldNames, start + i);
    var fname = tok_str(tokens, tokIdx, src);
    if (str_eq(fname.data, fname.length, name.data, name.length) == 1) { return i; }
    i = i + 1;
  }
  return -1;
}

// Type inference with scope + TypeEnv; annotates node.typeId and propagates env.
def infer_expr(ctx ResolveCtx, idx int) InferResult {
  var r = ctx;
  if (idx == -1) { return InferResult{r, -1}; }
  var n = nodearena_get(r.arena, idx);
  var k = n.kind;

  if (k == NODE_LITERAL) {
    var lit = literal_type(r.env, r.tokens, n.a, r.src);
    if (lit.err == 1) { r.err = 1; return InferResult{r, -1}; }
    r.env = lit.env;
    r = ctx_set_type(r, idx, lit.typeId);
    return InferResult{r, lit.typeId};
  }

  if (k == NODE_VARIABLE) {
    var name = tok_str(r.tokens, n.a, r.src);
    var symIdx = scope_lookup_index_any(r.scope, name);
    if (symIdx == -1) { r.err = 1; return InferResult{r, -1}; }
    var info = scope_get_info(r.scope, symIdx);
    r = ctx_set_type(r, idx, info.typeId);
    return InferResult{r, info.typeId};
  }

  if (k == NODE_GROUP) {
    var inner = infer_expr(r, n.a);
    inner.ctx = ctx_set_type(inner.ctx, idx, inner.typeId);
    return inner;
  }

  if (k == NODE_UNARY) {
    var operand = infer_expr(r, n.b);
    r = operand.ctx;
    if (r.err == 1) { return InferResult{r, -1}; }
    var opTok = n.a;
    var op = -1;
    var okind = token_kind_at(r.tokens, opTok);
    if (okind == TOKEN_MINUS) { op = UOP_NEG; }
    if (okind == TOKEN_BANG) { op = UOP_NOT; }
    if (okind == TOKEN_PLUS) {
      var resPlus = operand.typeId;
      r = ctx_set_type(r, idx, resPlus);
      return InferResult{r, resPlus};
    }
    if (okind == TOKEN_TILDE) {
      if (operand.typeId == -1) { r.err = 1; return InferResult{r, -1}; }
      var catUnary = typetable_get(r.env.tt, operand.typeId).category;
      if (catUnary == TYPECATEGORY_INT || catUnary == TYPECATEGORY_BYTE) {
        r = ctx_set_type(r, idx, operand.typeId);
        return InferResult{r, operand.typeId};
      }
      // treat as pointer deref for pointer types
      if (catUnary == TYPECATEGORY_POINTER) { op = UOP_DEREF; }
    }
    var resId = type_unary_result(r.env.tt, operand.typeId, op);
    if (resId == -1) { r.err = 1; return InferResult{r, -1}; }
    r = ctx_set_type(r, idx, resId);
    return InferResult{r, resId};
  }

  if (k == NODE_UPDATE) {
    var opnd = infer_expr(r, n.b);
    r = opnd.ctx;
    if (r.err == 1) { return InferResult{r, -1}; }
    var cat = typetable_get(r.env.tt, opnd.typeId).category;
    if (cat != TYPECATEGORY_INT && cat != TYPECATEGORY_BYTE) { r.err = 1; return InferResult{r, -1}; }
    r = ctx_set_type(r, idx, opnd.typeId);
    return InferResult{r, opnd.typeId};
  }

  if (k == NODE_LOGICAL) {
    var l = infer_expr(r, n.a);
    r = l.ctx;
    if (r.err == 1) { return InferResult{r, -1}; }
    var r2 = infer_expr(r, n.b);
    r = r2.ctx;
    if (r.err == 1) { return InferResult{r, -1}; }
    if (l.typeId == -1 || r2.typeId == -1) { r.err = 1; return InferResult{r, -1}; }
    var resId = type_binary_logical_result(r.env.tt, l.typeId, r2.typeId, 0);
    if (resId == -1) { r.err = 1; return InferResult{r, -1}; }
    r = ctx_set_type(r, idx, resId);
    return InferResult{r, resId};
  }

  if (k == NODE_BINARY) {
    var l = infer_expr(r, n.a);
    r = l.ctx;
    if (r.err == 1) { return InferResult{r, -1}; }
    var rside = infer_expr(r, n.b);
    r = rside.ctx;
    if (r.err == 1) { return InferResult{r, -1}; }
    if (l.typeId == -1 || rside.typeId == -1) { r.err = 1; return InferResult{r, -1}; }
    var opKind = token_kind_at(r.tokens, n.c);
    var result = -1;
    if (opKind == TOKEN_PLUS) { result = type_binary_arith_result(r.env.tt, l.typeId, rside.typeId, OP_ADD); }
    if (opKind == TOKEN_MINUS) { result = type_binary_arith_result(r.env.tt, l.typeId, rside.typeId, OP_SUB); }
    if (opKind == TOKEN_STAR) { result = type_binary_arith_result(r.env.tt, l.typeId, rside.typeId, OP_MUL); }
    if (opKind == TOKEN_SLASH) { result = type_binary_arith_result(r.env.tt, l.typeId, rside.typeId, OP_DIV); }
    if (opKind == TOKEN_PERCENT) { result = type_binary_arith_result(r.env.tt, l.typeId, rside.typeId, OP_MOD); }
    if (opKind == TOKEN_AMP) { result = type_binary_bitwise_result(r.env.tt, l.typeId, rside.typeId, OP_BIT_AND); }
    if (opKind == TOKEN_BAR) { result = type_binary_bitwise_result(r.env.tt, l.typeId, rside.typeId, OP_BIT_OR); }
    if (opKind == TOKEN_CARET) { result = type_binary_bitwise_result(r.env.tt, l.typeId, rside.typeId, OP_BIT_XOR); }
    if (opKind == TOKEN_SHIFT_LEFT) { result = type_binary_shift_result(r.env.tt, l.typeId, rside.typeId, OP_SHL); }
    if (opKind == TOKEN_SHIFT_RIGHT) { result = type_binary_shift_result(r.env.tt, l.typeId, rside.typeId, OP_SHR); }
    if (opKind == TOKEN_LESS) { result = type_binary_compare_result(r.env.tt, l.typeId, rside.typeId, OP_LT); }
    if (opKind == TOKEN_LESS_EQUAL) { result = type_binary_compare_result(r.env.tt, l.typeId, rside.typeId, OP_LE); }
    if (opKind == TOKEN_GREATER) { result = type_binary_compare_result(r.env.tt, l.typeId, rside.typeId, OP_GT); }
    if (opKind == TOKEN_GREATER_EQUAL) { result = type_binary_compare_result(r.env.tt, l.typeId, rside.typeId, OP_GE); }
    if (opKind == TOKEN_EQUAL_EQUAL) { result = type_binary_compare_result(r.env.tt, l.typeId, rside.typeId, OP_EQ); }
    if (opKind == TOKEN_BANG_EQUAL) { result = type_binary_compare_result(r.env.tt, l.typeId, rside.typeId, OP_NE); }
    if (result == -1) { r.err = 1; return InferResult{r, -1}; }
    r = ctx_set_type(r, idx, result);
    return InferResult{r, result};
  }

  if (k == NODE_TERNARY) {
    var c = infer_expr(r, n.a);
    r = c.ctx;
    if (r.err == 1) { return InferResult{r, -1}; }
    var t = infer_expr(r, n.b);
    r = t.ctx;
    if (r.err == 1) { return InferResult{r, -1}; }
    var e = infer_expr(r, n.c);
    r = e.ctx;
    if (r.err == 1) { return InferResult{r, -1}; }
    if (type_equals(r.env.tt, t.typeId, e.typeId) == 0) { r.err = 1; return InferResult{r, -1}; }
    r = ctx_set_type(r, idx, t.typeId);
    return InferResult{r, t.typeId};
  }

  if (k == NODE_LEN) {
    var inner = infer_expr(r, n.a);
    r = inner.ctx;
    if (r.err == 1) { return InferResult{r, -1}; }
    if (inner.typeId == -1) { r.err = 1; return InferResult{r, -1}; }
    var t = typetable_get(r.env.tt, inner.typeId);
    if (t.category != TYPECATEGORY_ARRAY) { r.err = 1; return InferResult{r, -1}; }
    r = ctx_set_type(r, idx, 5); // int id
    return InferResult{r, 5};
  }

  if (k == NODE_INDEX) {
    var arr = infer_expr(r, n.a);
    r = arr.ctx;
    if (r.err == 1) { return InferResult{r, -1}; }
    var idxRes = infer_expr(r, n.b);
    r = idxRes.ctx;
    if (r.err == 1) { return InferResult{r, -1}; }
    if (arr.typeId == -1 || idxRes.typeId == -1) { r.err = 1; return InferResult{r, -1}; }
    var arrType = typetable_get(r.env.tt, arr.typeId);
    var elem = -1;
    if (arrType.category == TYPECATEGORY_ARRAY) { elem = arrType.element; }
    else if (arrType.category == TYPECATEGORY_POINTER) { elem = arr.typeId; }
    if (elem == -1) { r.err = 1; return InferResult{r, -1}; }
    var idxType = typetable_get(r.env.tt, idxRes.typeId).category;
    if (idxType != TYPECATEGORY_INT && idxType != TYPECATEGORY_BYTE) { r.err = 1; return InferResult{r, -1}; }
    r = ctx_set_type(r, idx, elem);
    return InferResult{r, elem};
  }

  if (k == NODE_DEREF) {
    var operand2 = infer_expr(r, n.a);
    r = operand2.ctx;
    if (r.err == 1) { return InferResult{r, -1}; }
    if (operand2.typeId == -1) { r.err = 1; return InferResult{r, -1}; }
    var tptr = typetable_get(r.env.tt, operand2.typeId);
    if (tptr.category != TYPECATEGORY_POINTER) { r.err = 1; return InferResult{r, -1}; }
    r = ctx_set_type(r, idx, tptr.element);
    return InferResult{r, tptr.element};
  }
  if (k == NODE_DOT) {
    var base = infer_expr(r, n.a);
    r = base.ctx;
    if (r.err == 1) { return InferResult{r, -1}; }
    if (base.typeId == -1) { r.err = 1; return InferResult{r, -1}; }
    var baseType = typetable_get(r.env.tt, base.typeId);
    var structTypeId = base.typeId;
    if (baseType.category == TYPECATEGORY_POINTER) {
      structTypeId = baseType.element;
      baseType = typetable_get(r.env.tt, structTypeId);
    }
    if (baseType.category != TYPECATEGORY_STRUCT) { r.err = 1; return InferResult{r, -1}; }
    var sIdx = struct_index_for_type(r.tm, structTypeId);
    if (sIdx == -1) { r.err = 1; return InferResult{r, -1}; }
    var fieldName = tok_str(r.tokens, n.b, r.src);
    var fIdx = struct_field_index_by_name(r.tm, sIdx, r.tokens, r.src, fieldName);
    if (fIdx == -1) { r.err = 1; return InferResult{r, -1}; }
    var fType = tm_struct_field_type(r.tm, sIdx, fIdx);
    r = ctx_set_type(r, idx, fType);
    return InferResult{r, fType};
  }

  if (k == NODE_CALL) {
    // infer callee (for validation) and arguments
    var calleeRes = infer_expr(r, n.a);
    r = calleeRes.ctx;
    if (r.err == 1) { return InferResult{r, -1}; }
    var calleeNode = nodearena_get(r.arena, n.a);
    if (calleeNode.kind != NODE_VARIABLE) { r.err = 1; return InferResult{r, -1}; }
    var name = tok_str(r.tokens, calleeNode.a, r.src);
    var fi = find_fn_index_by_name_arity(r.tm, r.arena, r.tokens, r.src, name, n.c);
    if (fi == -1) { r.err = 1; return InferResult{r, -1}; }
    var expectedCount = tm_fn_param_count(r.tm, fi);
    if (expectedCount != -1 && expectedCount != n.c) { r.err = 1; return InferResult{r, -1}; }
    var head = n.b;
    var argIdx = 0;
    while (head != -1 && r.err == 0) {
      var argNode = nodearena_get(r.arena, head);
      var argRes = infer_expr(r, argNode.a);
      r = argRes.ctx;
      if (r.err == 1) { break; }
      if (argRes.typeId == -1) { r.err = 1; break; }
      var expectedType = tm_fn_param_type(r.tm, fi, argIdx);
      if (expectedType != -1 && argRes.typeId != -1) {
        if (type_can_coerce(r.env.tt, argRes.typeId, expectedType) == 0 && type_can_cast(r.env.tt, argRes.typeId, expectedType) == 0) {
          r.err = 1; break;
        }
      }
      head = argNode.b;
      argIdx = argIdx + 1;
    }
    if (r.err == 1) { return InferResult{r, -1}; }
    var retId = tm_fn_return_type(r.tm, fi);
    r = ctx_set_type(r, idx, retId);
    return InferResult{r, retId};
  }

  if (k == NODE_ASSIGN) {
    if (n.c == 0) { return InferResult{r, -1}; }
    var lhs = infer_expr(r, n.a);
    r = lhs.ctx;
    if (r.err == 1) { return InferResult{r, -1}; }
    var rhs = infer_expr(r, n.b);
    r = rhs.ctx;
    if (r.err == 1) { return InferResult{r, -1}; }
    if (lhs.typeId == -1 || rhs.typeId == -1) { r.err = 1; return InferResult{r, -1}; }
    if (lhs.typeId != -1 && rhs.typeId != -1) {
      if (type_can_coerce(r.env.tt, rhs.typeId, lhs.typeId) == 0) {
        r.err = 1; return InferResult{r, -1};
      }
    }
    r = ctx_set_type(r, idx, lhs.typeId);
    return InferResult{r, lhs.typeId};
  }

  // For list/dot/others, leave type unset but do not hard fail unless already errored.
  return InferResult{r, -1};
}

// Collect ranges covered by a referenced block (inclusive of the block node index).
// Resolve an expression tree; sets ctx.err on failure.
def resolve_expr(ctx ResolveCtx, idx int) ResolveCtx {
  var res = infer_expr(ctx, idx);
  return res.ctx;
}

def is_statement_kind(k int) int {
  if (k == NODE_VAR_STMT) { return 1; }
  if (k == NODE_RETURN) { return 1; }
  if (k == NODE_PRINT) { return 1; }
  if (k == NODE_IF) { return 1; }
  if (k == NODE_WHILE) { return 1; }
  if (k == NODE_FOR) { return 1; }
  if (k == NODE_BREAK) { return 1; }
  if (k == NODE_CONTINUE) { return 1; }
  if (k == NODE_ASSIGN) { return 1; }
  if (k == NODE_EXPR_STMT) { return 1; }
  return 0;
}

// Resolve a single statement node by index (with current scope and loop depth).
def resolve_statement(ctx ResolveCtx, stmtIdx int, loopDepth int) ResolveCtx {
  var r = ctx;
  var n = nodearena_get(r.arena, stmtIdx);
  var k = n.kind;
  if (k == NODE_VAR_STMT) {
    var name = tok_str(r.tokens, n.a, r.src);
    var initRes = infer_expr(r, n.b);
    r = initRes.ctx;
    if (r.err == 1) { return r; }
    if (initRes.typeId == -1) { r.err = 1; return r; }
    var declared = tm_var_type_by_node(r.tm, stmtIdx);
    var finalType = declared;
    if (finalType == -1) { finalType = initRes.typeId; }
    if (finalType != -1 && initRes.typeId != -1) {
      if (type_can_coerce(r.env.tt, initRes.typeId, finalType) == 0) {
        r.err = 1; return r;
      }
    }
    var res = scope_define_var(r.scope, name, finalType);
    if (res.err != 0) { r.err = 1; return r; }
    r.scope = res.scope;
    r.arena = nodearena_set_type(r.arena, stmtIdx, finalType);
    return r;
  }
  if (k == NODE_ASSIGN) {
    var name = tok_str(r.tokens, n.a, r.src);
    var found = scope_lookup_index_any(r.scope, name);
    if (found == -1) {
      // Likely an assignment expression node visited while scanning block contents; skip here.
      return r;
    }
    var rhs = infer_expr(r, n.b);
    r = rhs.ctx;
    if (r.err == 1) { return r; }
    if (rhs.typeId == -1) { r.err = 1; return r; }
    var info = scope_get_info(r.scope, found);
    var targetType = info.typeId;
    if (targetType == -1) {
      targetType = rhs.typeId;
      r.scope = scope_set_type_at(r.scope, found, targetType);
    }
    if (targetType != -1 && rhs.typeId != -1) {
      if (type_can_coerce(r.env.tt, rhs.typeId, targetType) == 0) {
        r.err = 1; return r;
      }
    }
    r.arena = nodearena_set_type(r.arena, stmtIdx, targetType);
    return r;
  }
  if (k == NODE_RETURN) {
    if (r.currentRetType != -1 && r.currentRetType != 8 && n.a == -1) { r.err = 1; return r; }
    if (n.a != -1) {
      var rv = infer_expr(r, n.a);
      r = rv.ctx;
      if (r.err == 1) { return r; }
      if (rv.typeId == -1) { r.err = 1; return r; }
      if (r.currentRetType != -1 && r.currentRetType != 8 && rv.typeId != -1) {
        if (type_can_coerce(r.env.tt, rv.typeId, r.currentRetType) == 0) {
          r.err = 1; return r;
        }
      }
    } else {
      if (r.currentRetType != -1 && r.currentRetType != 8) { r.err = 1; return r; }
    }
    r.hasReturn = 1;
    r.arena = nodearena_set_type(r.arena, stmtIdx, r.currentRetType);
    return r;
  }
  if (k == NODE_PRINT || k == NODE_EXPR_STMT) {
    var e = infer_expr(r, n.a);
    r = e.ctx;
    if (r.err == 1) { return r; }
    return r;
  }
  if (k == NODE_BREAK) {
    if (loopDepth <= 0) { r.err = 1; return r; }
    if (n.a != -1) {
      var be = infer_expr(r, n.a);
      r = be.ctx;
    }
    return r;
  }
  if (k == NODE_CONTINUE) {
    if (loopDepth <= 0) { r.err = 1; return r; }
    if (n.a != -1) {
      var ce = infer_expr(r, n.a);
      r = ce.ctx;
    }
    return r;
  }
  if (k == NODE_IF) {
    var cond = infer_expr(r, n.a);
    r = cond.ctx;
    if (r.err == 1) { return r; }
    if (cond.typeId != -1) {
      var cat = typetable_get(r.env.tt, cond.typeId).category;
      if (cat != TYPECATEGORY_BOOL && type_is_numeric(r.env.tt, cond.typeId) == 0) { r.err = 1; return r; }
    }
    if (n.b != -1) {
      var thenNode = nodearena_get(r.arena, n.b);
      if (thenNode.kind == NODE_BLOCK) { r = resolve_block_nodes(r, n.b, loopDepth); }
      else { r = resolve_statement(r, n.b, loopDepth); }
    }
    if (r.err == 1) { return r; }
    if (n.c != -1) {
      var elseNode = nodearena_get(r.arena, n.c);
      if (elseNode.kind == NODE_BLOCK) { r = resolve_block_nodes(r, n.c, loopDepth); }
      else { r = resolve_statement(r, n.c, loopDepth); }
    }
    return r;
  }
  if (k == NODE_WHILE) {
    var cond2 = infer_expr(r, n.a);
    r = cond2.ctx;
    if (r.err == 1) { return r; }
    if (n.b != -1) {
      var body = nodearena_get(r.arena, n.b);
      if (body.kind == NODE_BLOCK) { r = resolve_block_nodes(r, n.b, loopDepth + 1); }
      else { r = resolve_statement(r, n.b, loopDepth + 1); }
    }
    return r;
  }
  if (k == NODE_FOR) {
    if (n.a != -1) { r = resolve_expr(r, n.a); }
    if (r.err == 1) { return r; }
    if (n.b != -1) { var cond3 = infer_expr(r, n.b); r = cond3.ctx; }
    if (r.err == 1) { return r; }
    if (n.c != -1) { r = resolve_expr(r, n.c); }
    if (r.err == 1) { return r; }
    if (n.d != -1) {
      var body2 = nodearena_get(r.arena, n.d);
      if (body2.kind == NODE_BLOCK) { r = resolve_block_nodes(r, n.d, loopDepth + 1); }
      else { r = resolve_statement(r, n.d, loopDepth + 1); }
    }
    return r;
  }
  if (k == NODE_BLOCK) {
    return resolve_block_nodes(r, stmtIdx, loopDepth);
  }
  return r;
}

// Resolve a block by walking only its direct statements (depth + loopDepth carried in).
def resolve_block_nodes(ctx ResolveCtx, blockIdx int, loopDepth int) ResolveCtx {
  var r = ctx;
  var blk = nodearena_get(r.arena, blockIdx);
  var start = blk.a;
  var end = blk.a + blk.b;

  // Precompute nested block ranges to skip linear scanning of child contents here.
  var childStarts = vecint_new(8);
  var childEnds = vecint_new(8);
  var scan = start;
  while (scan < end) {
    if (scan == blockIdx) { scan = scan + 1; continue; }
    var bn = nodearena_get(r.arena, scan);
    if (bn.kind == NODE_BLOCK) {
      childStarts = vecint_push(childStarts, bn.a);
      childEnds = vecint_push(childEnds, bn.a + bn.b);
    }
    scan = scan + 1;
  }

  r.scope = scope_enter(r.scope);
  var i = start;
  while (i < end && r.err == 0) {
    // Skip over child block contents (they are handled via parent statements).
    var j = 0;
    var skipped = 0;
    while (j < childStarts.length) {
      var cs = vecint_get(childStarts, j);
      var ce = vecint_get(childEnds, j);
      if (i >= cs && i < ce) {
        i = ce;
        skipped = 1;
        break;
      }
      j = j + 1;
    }
    if (skipped == 1) { continue; }

    var n2 = nodearena_get(r.arena, i);
    // Skip nested block nodes here; they are traversed via their parent statements.
    if (n2.kind != NODE_BLOCK && is_statement_kind(n2.kind) == 1) {
      r = resolve_statement(r, i, loopDepth);
    }
    i = i + 1;
  }
  r.scope = scope_exit(r.scope);
  return r;
}

// Resolve a function node: define params in a nested scope and resolve the body.
def resolve_function(ctx ResolveCtx, fn Node, fi int) ResolveCtx {
  var r = ctx;
  var fnScope = scope_enter(r.scope);
  // parameters
  var added = 0;
  var idx = fn.b;
  var expectedParams = fn.d;
  if (fi != -1) {
    var cnt = tm_fn_param_count(r.tm, fi);
    if (cnt != -1) { expectedParams = cnt; }
  }
  while (idx != -1 && added < expectedParams) {
    if (idx >= r.tokens.length) { break; }
    var k = token_kind_at(r.tokens, idx);
    if (k == TOKEN_IDENTIFIER) {
      var name = tok_str(r.tokens, idx, r.src);
      var paramType = -1;
      if (fi != -1) { paramType = tm_fn_param_type(r.tm, fi, added); }
      var res = scope_define_var(fnScope, name, paramType);
      if (res.err != 0) { r.err = 1; return r; }
      fnScope = res.scope;
      added = added + 1;
      idx = idx + 1;
      while (idx < r.tokens.length) {
        var k2 = token_kind_at(r.tokens, idx);
        if (k2 == TOKEN_COMMA) { idx = idx + 1; break; }
        if (k2 == TOKEN_RIGHT_PAREN) { break; }
        idx = idx + 1;
      }
      continue;
    }
    idx = idx + 1;
  }
  var bodyIdx = fn.a;
  var retType = -1;
  if (fi != -1) { retType = tm_fn_return_type(r.tm, fi); }
  var fnCtx = ResolveCtx{r.arena, r.tokens, r.src, fnScope, r.env, r.tm, fi, retType, 0, 0};
  if (bodyIdx != -1) {
    fnCtx = resolve_block_nodes(fnCtx, bodyIdx, 0);
  }
  if (fnCtx.err == 1) { r.err = 1; return r; }
  if (fnCtx.hasReturn == 0) { r.err = 1; return r; }
  // Clean up parameter scope
  fnCtx.scope = scope_exit(fnCtx.scope);
  r.hasReturn = 1;
  return r;
}

def vecint_find(v VecInt, target int) int {
  var i = 0;
  while (i < v.length) {
    if (vecint_get(v, i) == target) { return i; }
    i = i + 1;
  }
  return -1;
}

// Main AST-based module resolver.
def resolve_module_ast(src byte~, n int) int {
  var pmr = parse_module_source(src, n);
  if (pmr.err != 0) { return 0; }

  var tm = module_type_ids(pmr);
  if (tm.err == 1) { return 0; }

  var ctx = resolve_module_ast_with_pmr(pmr, tm);
  if (ctx.err == 1) { return 0; }
  if (ctx.hasReturn == 0) { return 0; }
  return 1;
}

// Resolver variant that operates on an existing ParseModuleResult and TypeModuleTypes,
// returning the final resolver context (with updated arena/types) instead of a boolean.
def resolve_module_ast_with_pmr(pmr ParseModuleResult, tm TypeModuleTypes) ResolveCtx {
  // Precompute ranges for function bodies to separate global scope definitions.
  var fnStarts = vecint_new(4);
  var fnEnds = vecint_new(4);
  var i = 0;
  while (i < pmr.arena.nodes.length) {
    var node = nodearena_get(pmr.arena, i);
    if (node.kind == NODE_FUNCTION && node.a != -1) {
      var blk = nodearena_get(pmr.arena, node.a);
      fnStarts = vecint_push(fnStarts, blk.a);
      fnEnds = vecint_push(fnEnds, node.a);
    }
    i = i + 1;
  }

  var scope = scope_new_root();
  var env = tm.env;

  // First pass: define globals (vars, structs, functions) outside function bodies.
  i = 0;
  while (i < pmr.arena.nodes.length) {
    if (range_contains(fnStarts, fnEnds, i) == 1) { i = i + 1; continue; }
    var n0 = nodearena_get(pmr.arena, i);
    if (n0.kind == NODE_VAR_STMT) {
      var name = tok_str(pmr.tokens, n0.a, pmr.src);
      var vi = vecint_find(pmr.meta.varNodeIndex, i);
      var vtid = -1;
      if (vi != -1 && vi < tm.varTypeIds.length) { vtid = vecint_get(tm.varTypeIds, vi); }
      var resVar = scope_define_var(scope, name, vtid);
      if (resVar.err != 0) { return ResolveCtx{pmr.arena, pmr.tokens, pmr.src, scope, env, tm, -1, -1, 1, 0}; }
      scope = resVar.scope;
    } else if (n0.kind == NODE_STRUCT_DECL) {
      var nameS = tok_str(pmr.tokens, n0.c, pmr.src);
      var si = vecint_find(pmr.meta.structNodeIndex, i);
      var stid = -1;
      if (si != -1 && si < tm.structTypeIds.length) { stid = vecint_get(tm.structTypeIds, si); }
      var resS = scope_define_struct(scope, nameS, stid);
      if (resS.err != 0) { return ResolveCtx{pmr.arena, pmr.tokens, pmr.src, scope, env, tm, -1, -1, 1, 0}; }
      scope = resS.scope;
    } else if (n0.kind == NODE_FUNCTION) {
      var nameF = tok_str(pmr.tokens, n0.c, pmr.src);
      var fi = vecint_find(pmr.meta.fnNodeIndex, i);
      var retId = -1;
      if (fi != -1 && fi < tm.fnReturnTypeId.length) { retId = vecint_get(tm.fnReturnTypeId, fi); }
      var resF = scope_define_function(scope, nameF, n0.d, retId, n0.value, n0.typeId);
      if (resF.err != 0) { return ResolveCtx{pmr.arena, pmr.tokens, pmr.src, scope, env, tm, -1, -1, 1, 0}; }
      scope = resF.scope;
    }
    i = i + 1;
  }
  // Resolve global initializers (outside function bodies).
  var ctx = ResolveCtx{pmr.arena, pmr.tokens, pmr.src, scope, env, tm, -1, -1, 0, 0};
  i = 0;
  while (i < pmr.arena.nodes.length && ctx.err == 0) {
    if (range_contains(fnStarts, fnEnds, i) == 1) { i = i + 1; continue; }
    var n1 = nodearena_get(pmr.arena, i);
    if (n1.kind == NODE_VAR_STMT) {
      var init = infer_expr(ctx, n1.b);
      ctx = init.ctx;
      if (ctx.err == 1) { i = i + 1; continue; }
      if (init.typeId == -1) { ctx.err = 1; i = i + 1; continue; }
      var gi = vecint_find(pmr.meta.varNodeIndex, i);
      var declType = -1;
      if (gi != -1 && gi < tm.varTypeIds.length) { declType = vecint_get(tm.varTypeIds, gi); }
      var finalTypeG = declType;
      if (finalTypeG == -1) { finalTypeG = init.typeId; }
      if (finalTypeG != -1 && init.typeId != -1) {
        if (type_can_coerce(ctx.env.tt, init.typeId, finalTypeG) == 0) {
          ctx.err = 1; i = i + 1; continue;
        }
      }
      // update scope entry
      var nameG = tok_str(pmr.tokens, n1.a, pmr.src);
      var symIdx = scope_lookup_index_any(ctx.scope, nameG);
      if (symIdx != -1) {
        ctx.scope = scope_set_type_at(ctx.scope, symIdx, finalTypeG);
      }
      ctx.arena = nodearena_set_type(ctx.arena, i, finalTypeG);
    } else if (n1.kind == NODE_ASSIGN) {
      var nameA = tok_str(pmr.tokens, n1.a, pmr.src);
      var idxFound = scope_lookup_index_any(ctx.scope, nameA);
      if (idxFound == -1) { ctx.err = 1; i = i + 1; continue; }
      var rhs = infer_expr(ctx, n1.b);
      ctx = rhs.ctx;
      if (ctx.err == 1) { i = i + 1; continue; }
      if (rhs.typeId == -1) { ctx.err = 1; i = i + 1; continue; }
      var infoG = scope_get_info(ctx.scope, idxFound);
      var target = infoG.typeId;
      if (target == -1) { target = rhs.typeId; ctx.scope = scope_set_type_at(ctx.scope, idxFound, target); }
      if (target != -1 && rhs.typeId != -1) {
        if (type_can_coerce(ctx.env.tt, rhs.typeId, target) == 0) {
          ctx.err = 1;
        }
      }
    }
    i = i + 1;
  }
  if (ctx.err == 1) { return ctx; }
  // Resolve functions.
  i = 0;
  while (i < pmr.arena.nodes.length && ctx.err == 0) {
    var n2 = nodearena_get(pmr.arena, i);
    if (n2.kind == NODE_FUNCTION) {
      var fi = vecint_find(tm.fnNodeIndex, i);
      ctx = resolve_function(ctx, n2, fi);
    }
    i = i + 1;
  }
  if (ctx.err == 1) { return ctx; }
  if (ctx.hasReturn == 0) { return ctx; }
  return ctx;
}
