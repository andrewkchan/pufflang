// Stage1 Puffscript parser (minimal) consuming token kinds from scanner.
// Recognizes: def IDENT ( ) { return NUMBER; }
// Token constants provided by scanner.puff (aligned with Stage0 TokenType).

def safe_get(v VecInt, idx int) int {
  if (idx < 0 || idx >= v.length) { return -1; }
  return vecint_get(v, idx);
}

def parse_simple(tokens VecInt) int {
  var i = 0;
  if (safe_get(tokens, i) != TOKEN_DEF) { return 0; }
  i = i + 1;
  if (safe_get(tokens, i) != TOKEN_IDENTIFIER) { return 0; }
  i = i + 1;
  if (safe_get(tokens, i) != TOKEN_LEFT_PAREN) { return 0; }
  i = i + 1;
  if (safe_get(tokens, i) != TOKEN_RIGHT_PAREN) { return 0; }
  i = i + 1;
  if (safe_get(tokens, i) != TOKEN_LEFT_BRACE) { return 0; }
  i = i + 1;
  if (safe_get(tokens, i) != TOKEN_RETURN) { return 0; }
  i = i + 1;
  var retk = safe_get(tokens, i);
  if (retk != TOKEN_NUMBER && retk != TOKEN_IDENTIFIER) { return 0; }
  i = i + 1;
  if (safe_get(tokens, i) != TOKEN_SEMICOLON) { return 0; }
  i = i + 1;
  if (safe_get(tokens, i) != TOKEN_RIGHT_BRACE) { return 0; }
  i = i + 1;
  if (safe_get(tokens, i) != TOKEN_EOF) { return 0; }
  return 1;
}
