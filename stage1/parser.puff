// Stage1 Puffscript parser (minimal) consuming token kinds from scanner.
// Recognizes: def IDENT ( ) { return NUMBER; }
// Token constants provided by scanner.puff (aligned with Stage0 TokenType).

// --- Tiny AST result using shared NodeArena from ast.puff ---
struct ParseResult { arena NodeArena, root int }

def safe_get(v VecInt, idx int) int {
  if (idx < 0 || idx >= v.length) { return -1; }
  return vecint_get(v, idx);
}

// Parse a tiny expression (non-recursive):
// primary: [ - ] (IDENT (opt call args) | NUMBER)
// optional binop: (+|-|*|/) primary
// Returns the next index on success, or -1 on failure.
def parse_primary(tokens VecInt, i int) int {
  var unaryMinus = 0;
  if (safe_get(tokens, i) == TOKEN_MINUS) {
    unaryMinus = 1;
    i = i + 1;
  }
  var k = safe_get(tokens, i);
  if (k != TOKEN_NUMBER && k != TOKEN_IDENTIFIER) { return -1; }
  i = i + 1;
  if (k == TOKEN_IDENTIFIER && safe_get(tokens, i) == TOKEN_LEFT_PAREN) {
    i = i + 1;
    if (safe_get(tokens, i) == TOKEN_RIGHT_PAREN) {
      i = i + 1;
    } else {
      var arg = safe_get(tokens, i);
      if (arg != TOKEN_NUMBER && arg != TOKEN_IDENTIFIER) { return -1; }
      i = i + 1;
      while (safe_get(tokens, i) == TOKEN_COMMA) {
        i = i + 1;
        var arg2 = safe_get(tokens, i);
        if (arg2 != TOKEN_NUMBER && arg2 != TOKEN_IDENTIFIER) { return -1; }
        i = i + 1;
      }
      if (safe_get(tokens, i) != TOKEN_RIGHT_PAREN) { return -1; }
      i = i + 1;
    }
  }
  return i;
}

def parse_expr(tokens VecInt, i int) int {
  var next = parse_primary(tokens, i);
  if (next == -1) { return -1; }
  i = next;
  var op = safe_get(tokens, i);
  if (op == TOKEN_PLUS || op == TOKEN_MINUS || op == TOKEN_STAR || op == TOKEN_SLASH) {
    i = i + 1;
    var rhs = parse_primary(tokens, i);
    if (rhs == -1) { return -1; }
    i = rhs;
  }
  return i;
}

def parse_simple(tokens VecInt) int {
  var i = 0;
  if (safe_get(tokens, i) != TOKEN_DEF) { return 0; }
  i = i + 1;
  if (safe_get(tokens, i) != TOKEN_IDENTIFIER) { return 0; }
  i = i + 1;
  if (safe_get(tokens, i) != TOKEN_LEFT_PAREN) { return 0; }
  i = i + 1;
  // Optional parameter list: IDENT { , IDENT }.
  if (safe_get(tokens, i) == TOKEN_IDENTIFIER) {
    i = i + 1;
    while (safe_get(tokens, i) == TOKEN_COMMA) {
      i = i + 1;
      if (safe_get(tokens, i) != TOKEN_IDENTIFIER) { return 0; }
      i = i + 1;
    }
  }
  if (safe_get(tokens, i) != TOKEN_RIGHT_PAREN) { return 0; }
  i = i + 1;
  if (safe_get(tokens, i) != TOKEN_LEFT_BRACE) { return 0; }
  i = i + 1;
  // Optional var decls: var ident = expr;
  while (safe_get(tokens, i) == TOKEN_VAR) {
    i = i + 1;
    if (safe_get(tokens, i) != TOKEN_IDENTIFIER) { return 0; }
    i = i + 1;
    if (safe_get(tokens, i) != TOKEN_EQUAL) { return 0; }
    i = i + 1;
    var next = parse_expr(tokens, i);
    if (next == -1) { return 0; }
    i = next;
    if (safe_get(tokens, i) != TOKEN_SEMICOLON) { return 0; }
    i = i + 1;
  }
  if (safe_get(tokens, i) != TOKEN_RETURN) { return 0; }
  i = i + 1;
  var nextRet = parse_expr(tokens, i);
  if (nextRet == -1) { return 0; }
  i = nextRet;
  if (safe_get(tokens, i) != TOKEN_SEMICOLON) { return 0; }
  i = i + 1;
  if (safe_get(tokens, i) != TOKEN_RIGHT_BRACE) { return 0; }
  i = i + 1;
  if (safe_get(tokens, i) != TOKEN_EOF) { return 0; }
  return 1;
}

// Build a tiny AST for def/return-number (plus optional var NUMBER inits) into NodeArena.
// Returns ParseResult with root set to the function node index, or root=-1 on failure.
def parse_simple_ast(tokens VecInt) ParseResult {
  var arena = nodearena_new(8);
  var root = -1;
  // Validate first using the existing parse_simple; only build AST if valid.
  if (parse_simple(tokens) == 0) { return ParseResult{arena, root}; }

  var idx = 0;
  // From here, shape is already validated; minimal checks remain for safety.
  if (safe_get(tokens, idx) != TOKEN_DEF) { return ParseResult{arena, root}; }
  idx = idx + 1;
  if (safe_get(tokens, idx) != TOKEN_IDENTIFIER) { return ParseResult{arena, root}; }
  idx = idx + 1;
  if (safe_get(tokens, idx) != TOKEN_LEFT_PAREN) { return ParseResult{arena, root}; }
  idx = idx + 1;
  var paramCount = 0;
  if (safe_get(tokens, idx) == TOKEN_IDENTIFIER) {
    paramCount = paramCount + 1;
    idx = idx + 1;
    while (safe_get(tokens, idx) == TOKEN_COMMA) {
      idx = idx + 1;
      if (safe_get(tokens, idx) != TOKEN_IDENTIFIER) { return ParseResult{arena, root}; }
      paramCount = paramCount + 1;
      idx = idx + 1;
    }
  }
  if (safe_get(tokens, idx) != TOKEN_RIGHT_PAREN) { return ParseResult{arena, root}; }
  idx = idx + 1;
  if (safe_get(tokens, idx) != TOKEN_LEFT_BRACE) { return ParseResult{arena, root}; }
  idx = idx + 1;

  var blockStart = arena.nodes.length;

  // Optional var decls with NUMBER or IDENT initializer (stored as token kind placeholder).
  while (safe_get(tokens, idx) == TOKEN_VAR) {
    idx = idx + 1;
    if (safe_get(tokens, idx) != TOKEN_IDENTIFIER) { return ParseResult{arena, root}; }
    var nameTok = idx;
    idx = idx + 1;
    if (safe_get(tokens, idx) != TOKEN_EQUAL) { return ParseResult{arena, root}; }
    idx = idx + 1;
    var initKind = safe_get(tokens, idx);
    if (initKind != TOKEN_NUMBER && initKind != TOKEN_IDENTIFIER) { return ParseResult{arena, root}; }
    var initVal = vecint_get(tokens, idx); // token kind placeholder
    var initNodeKind = (initKind == TOKEN_NUMBER) ? NODE_LITERAL : NODE_VARIABLE;
    arena = nodearena_push(arena, Node{initNodeKind, 0, 0, 0, 0, initVal, -1});
    var initIdx = arena.nodes.length - 1;
    idx = idx + 1;
    if (safe_get(tokens, idx) != TOKEN_SEMICOLON) { return ParseResult{arena, root}; }
    idx = idx + 1;
    arena = nodearena_push(arena, Node{NODE_VAR_STMT, nameTok, initIdx, 0, 0, 0, -1});
  }

  if (safe_get(tokens, idx) != TOKEN_RETURN) { return ParseResult{arena, root}; }
  idx = idx + 1;
  var retKind = safe_get(tokens, idx);
  if (retKind != TOKEN_NUMBER && retKind != TOKEN_IDENTIFIER) { return ParseResult{arena, root}; }
  var retVal = vecint_get(tokens, idx); // token kind placeholder
  var retNodeKind = (retKind == TOKEN_NUMBER) ? NODE_LITERAL : NODE_VARIABLE;
  arena = nodearena_push(arena, Node{retNodeKind, 0, 0, 0, 0, retVal, -1});
  var retExprIdx = arena.nodes.length - 1;
  idx = idx + 1;
  if (safe_get(tokens, idx) != TOKEN_SEMICOLON) { return ParseResult{arena, root}; }
  idx = idx + 1;
  arena = nodearena_push(arena, Node{NODE_RETURN, retExprIdx, 0, 0, 0, 0, -1});
  var retIdx = arena.nodes.length - 1;

  if (safe_get(tokens, idx) != TOKEN_RIGHT_BRACE) { return ParseResult{arena, root}; }
  idx = idx + 1;
  if (safe_get(tokens, idx) != TOKEN_EOF) { return ParseResult{arena, root}; }

  var blockCount = arena.nodes.length - blockStart;
  arena = nodearena_push(arena, Node{NODE_BLOCK, blockStart, blockCount, 0, 0, 0, -1});
  var blkIdx = arena.nodes.length - 1;
  arena = nodearena_push(arena, Node{NODE_FUNCTION, blkIdx, paramCount, 0, 0, 0, -1});
  root = arena.nodes.length - 1;
  return ParseResult{arena, root};
}

// --- Minimal S-expression printer for a single def/return program ---

def ts_kind(tokens Vec, idx int) int { return token_kind_at(tokens, idx); }
def ts_len(tokens Vec) int { return tokens.length; }

def ts_match(tokens Vec, idx int~, kind int) int {
  if (idx~ < ts_len(tokens) && ts_kind(tokens, idx~) == kind) { idx~ = idx~ + 1; return 1; }
  return 0;
}

def ts_peek(tokens Vec, idx int) int {
  if (idx >= ts_len(tokens)) { return TOKEN_EOF; }
  return ts_kind(tokens, idx);
}

def sb_append_token_lexeme(sb StringBuilder, src byte~, tokIdx int, tokens Vec) StringBuilder {
  var start = token_start_at(tokens, tokIdx);
  var length = token_length_at(tokens, tokIdx);
  return sb_append_bytes(sb, src + start, length);
}

def trim_span(src byte~, start int, end int) String {
  // trim leading/trailing ASCII space, tab, newline, CR
  while (start < end) {
    var c = (src + start)~;
    if (c == byte(32) || c == byte(9) || c == byte(10) || c == byte(13)) { start = start + 1; continue; }
    break;
  }
  while (end > start) {
    var c2 = (src + end - 1)~;
    if (c2 == byte(32) || c2 == byte(9) || c2 == byte(10) || c2 == byte(13)) { end = end - 1; continue; }
    break;
  }
  var sb = sb_new();
  sb = sb_append_bytes(sb, src + start, end - start);
  return sb_to_string(sb);
}

// Parse a simple function and emit S-expr:
// (def <name> (params a b) (return <expr>))
// This mirrors the narrow patterns used by stage1 tests and avoids a full AST.
def parse_to_sexpr(src byte~, n int) String {
  var tokens = scan_tokens(src, n);
  var idx = 0;
  if (ts_match(tokens, &idx, TOKEN_DEF) == 0) { return String{src, 0}; }
  var nameTok = idx;
  ts_match(tokens, &idx, TOKEN_IDENTIFIER);
  ts_match(tokens, &idx, TOKEN_LEFT_PAREN);
  var sb = sb_new();
  sb = sb_append_cstr(sb, byte~(&"(def "[0]));
  sb = sb_append_token_lexeme(sb, src, nameTok, tokens);
  sb = sb_append_cstr(sb, byte~(&" (params"[0]));
  var firstParam = 1;
  while (ts_peek(tokens, idx) != TOKEN_RIGHT_PAREN && ts_peek(tokens, idx) != TOKEN_EOF) {
    if (ts_peek(tokens, idx) != TOKEN_IDENTIFIER) { break; }
    if (firstParam == 1) { sb = sb_append_byte(sb, byte(32)); firstParam = 0; }
    else { sb = sb_append_byte(sb, byte(32)); }
    sb = sb_append_token_lexeme(sb, src, idx, tokens);
    idx = idx + 1;
    if (ts_match(tokens, &idx, TOKEN_COMMA) == 1) { continue; }
  }
  ts_match(tokens, &idx, TOKEN_RIGHT_PAREN);
  sb = sb_append_byte(sb, byte(41)); // )
  ts_match(tokens, &idx, TOKEN_LEFT_BRACE);
  // Find return expr bounds
  // Assume pattern: return <expr> ;
  var retTokIdx = idx;
  while (retTokIdx < ts_len(tokens) && ts_kind(tokens, retTokIdx) != TOKEN_RETURN) { retTokIdx = retTokIdx + 1; }
  if (retTokIdx >= ts_len(tokens)) { return String{src, 0}; }
  var retStart = token_start_at(tokens, retTokIdx) + token_length_at(tokens, retTokIdx);
  var semiTokIdx = retTokIdx;
  while (semiTokIdx < ts_len(tokens) && ts_kind(tokens, semiTokIdx) != TOKEN_SEMICOLON) { semiTokIdx = semiTokIdx + 1; }
  if (semiTokIdx >= ts_len(tokens)) { return String{src, 0}; }
  var retEnd = token_start_at(tokens, semiTokIdx);
  var exprStr = trim_span(src, retStart, retEnd);
  // skip past semicolon and closing brace
  idx = semiTokIdx + 1;
  ts_match(tokens, &idx, TOKEN_RIGHT_BRACE);
  sb = sb_append_byte(sb, byte(32));
  sb = sb_append_byte(sb, byte(40));
  sb = sb_append_cstr(sb, byte~(&"return "[0]));
  sb = sb_append_string(sb, exprStr);
  sb = sb_append_byte(sb, byte(41));
  sb = sb_append_byte(sb, byte(41)); // close def
  return sb_to_string(sb);
}

// --- Lightweight parser metadata (counts) ---
struct ParserInfo { params int, vars int, hasReturn int }

// Parse shallowly to count params, var decls, and detect return presence.
def parse_meta_counts(src byte~, n int) ParserInfo {
  var tokens = scan_tokens(src, n);
  var idx = 0;
  var params = 0;
  var vars = 0;
  var hasRet = 0;
  if (ts_match(tokens, &idx, TOKEN_DEF) == 0) { return ParserInfo{0, 0, 0}; }
  if (ts_match(tokens, &idx, TOKEN_IDENTIFIER) == 0) { return ParserInfo{0, 0, 0}; }
  ts_match(tokens, &idx, TOKEN_LEFT_PAREN);
  // params
  while (ts_peek(tokens, idx) != TOKEN_RIGHT_PAREN && ts_peek(tokens, idx) != TOKEN_EOF) {
    if (ts_match(tokens, &idx, TOKEN_IDENTIFIER) == 1) {
      params = params + 1;
      if (ts_match(tokens, &idx, TOKEN_COMMA) == 1) { continue; }
    } else {
      idx = idx + 1;
    }
  }
  ts_match(tokens, &idx, TOKEN_RIGHT_PAREN);
  // advance to body
  while (idx < ts_len(tokens) && ts_kind(tokens, idx) != TOKEN_LEFT_BRACE && ts_kind(tokens, idx) != TOKEN_EOF) { idx = idx + 1; }
  if (ts_match(tokens, &idx, TOKEN_LEFT_BRACE) == 0) { return ParserInfo{params, vars, hasRet}; }
  while (idx < ts_len(tokens) && ts_kind(tokens, idx) != TOKEN_RIGHT_BRACE && ts_kind(tokens, idx) != TOKEN_EOF) {
    var k = ts_kind(tokens, idx);
    if (k == TOKEN_VAR) {
      vars = vars + 1;
    } else if (k == TOKEN_RETURN) {
      hasRet = 1;
    }
    idx = idx + 1;
  }
  return ParserInfo{params, vars, hasRet};
}

// Extract parameter names into VecStr.
def parse_params_vec(src byte~, n int) VecStr {
  var tokens = scan_tokens(src, n);
  var idx = 0;
  var out = vecstr_new(4);
  if (ts_match(tokens, &idx, TOKEN_DEF) == 0) { return out; }
  ts_match(tokens, &idx, TOKEN_IDENTIFIER);
  ts_match(tokens, &idx, TOKEN_LEFT_PAREN);
  while (idx < ts_len(tokens)) {
    var k = ts_kind(tokens, idx);
    if (k == TOKEN_RIGHT_PAREN) { break; }
    if (k == TOKEN_LEFT_BRACE) { break; }
    if (k == TOKEN_IDENTIFIER) {
      var start = token_start_at(tokens, idx);
      var lenTok = token_length_at(tokens, idx);
      var s = String{src + start, lenTok};
      out = vecstr_push(out, s);
      idx = idx + 1;
      if (ts_match(tokens, &idx, TOKEN_COMMA) == 1) { continue; }
      else { continue; }
    }
    idx = idx + 1;
  }
  return out;
}

// Extract return expression substring (best-effort; trims whitespace).
def parse_return_expr_str(src byte~, n int) String {
  var tokens = scan_tokens(src, n);
  var idx = 0;
  // find "return"
  var retTokIdx = 0;
  var found = 0;
  while (retTokIdx < ts_len(tokens)) {
    if (ts_kind(tokens, retTokIdx) == TOKEN_RETURN) { found = 1; break; }
    retTokIdx = retTokIdx + 1;
  }
  if (found == 0) { return String{src, 0}; }
  var retStart = token_start_at(tokens, retTokIdx) + token_length_at(tokens, retTokIdx);
  var semiTokIdx = retTokIdx;
  while (semiTokIdx < ts_len(tokens) && ts_kind(tokens, semiTokIdx) != TOKEN_SEMICOLON) { semiTokIdx = semiTokIdx + 1; }
  if (semiTokIdx >= ts_len(tokens)) { return String{src, 0}; }
  var retEnd = token_start_at(tokens, semiTokIdx);
  return trim_span(src, retStart, retEnd);
}

// --- Function shape extraction (name, params, var count, return expr) ---
struct FunctionShape {
  name String,
  params VecStr,
  vars int,
  hasReturn int,
  returnExpr String
}

def parse_function_shape(src byte~, n int) FunctionShape {
  var tokens = scan_tokens(src, n);
  var idx = 0;
  var name = String{src, 0};
  var params = vecstr_new(4);
  var vars = 0;
  var hasRet = 0;
  var retExpr = String{src, 0};

  if (ts_match(tokens, &idx, TOKEN_DEF) == 0) { return FunctionShape{name, params, vars, hasRet, retExpr}; }
  if (ts_peek(tokens, idx) == TOKEN_IDENTIFIER) {
    var start = token_start_at(tokens, idx);
    var lenTok = token_length_at(tokens, idx);
    name = String{src + start, lenTok};
    idx = idx + 1;
  }
  if (ts_match(tokens, &idx, TOKEN_LEFT_PAREN) == 1) {
    while (idx < ts_len(tokens)) {
      var k = ts_kind(tokens, idx);
      if (k == TOKEN_RIGHT_PAREN) { idx = idx + 1; break; }
      if (k == TOKEN_IDENTIFIER) {
        var pStart = token_start_at(tokens, idx);
        var pLen = token_length_at(tokens, idx);
        params = vecstr_push(params, String{src + pStart, pLen});
        idx = idx + 1;
        if (ts_match(tokens, &idx, TOKEN_COMMA) == 1) { continue; }
        else { continue; }
      }
      idx = idx + 1;
    }
  }
  while (idx < ts_len(tokens) && ts_kind(tokens, idx) != TOKEN_LEFT_BRACE && ts_kind(tokens, idx) != TOKEN_EOF) { idx = idx + 1; }
  if (ts_match(tokens, &idx, TOKEN_LEFT_BRACE) == 1) {
    var retTokIdx = -1;
    while (idx < ts_len(tokens) && ts_kind(tokens, idx) != TOKEN_RIGHT_BRACE) {
      var k2 = ts_kind(tokens, idx);
      if (k2 == TOKEN_VAR) { vars = vars + 1; }
      if (k2 == TOKEN_RETURN && retTokIdx == -1) { retTokIdx = idx; hasRet = 1; }
      idx = idx + 1;
    }
    if (retTokIdx != -1) {
      var startR = token_start_at(tokens, retTokIdx) + token_length_at(tokens, retTokIdx);
      var semiTokIdx = retTokIdx;
      while (semiTokIdx < ts_len(tokens) && ts_kind(tokens, semiTokIdx) != TOKEN_SEMICOLON) { semiTokIdx = semiTokIdx + 1; }
      if (semiTokIdx < ts_len(tokens)) {
        var endR = token_start_at(tokens, semiTokIdx);
        retExpr = trim_span(src, startR, endR);
      }
    }
  }
  return FunctionShape{name, params, vars, hasRet, retExpr};
}
