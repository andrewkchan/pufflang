// Stage1 Puffscript driver: scan + parse_full + resolve + codegen stub.
// Expect scanner.puff, parser_expr.puff, parser_full.puff, resolver.puff, and codegen.puff concatenated ahead.

def compile_simple(src byte~, n int) int {
  var pmr = parse_module_source(src, n);
  if (pmr.err != 0) { return 0; }
  var resolved = resolve_module_ast(src, n);
  if (resolved == 0) { return 0; }
  return codegen_simple(resolved);
}

// Variant that uses full tokens and depth-aware resolver.
def compile_simple2(src byte~, n int) int {
  var pmr = parse_module_source(src, n);
  if (pmr.err != 0) { return 0; }
  var resolved = resolve_module_ast(src, n);
  if (resolved == 0) { return 0; }
  return codegen_simple(resolved);
}

// Full compile that returns textual LLVM IR (minimal subset for now).
// On error, returns empty string.
def compile_to_ir(src byte~, n int) String {
  var pmr = parse_module_source(src, n);
  if (pmr.err != 0) { return String{src, 0}; }
  var tm = module_type_ids(pmr);
  if (tm.err == 1) { return String{src, 0}; }
  var rctx = resolve_module_ast_with_pmr(pmr, tm);
  if (rctx.err == 1) { return String{src, 0}; }
  if (rctx.hasReturn == 0) { return String{src, 0}; }
  pmr.arena = rctx.arena;
  tm.env = rctx.env;
  return codegen_module(pmr, tm);
}
