// Stage1 Puffscript scanner producing token kinds (aligned with Stage0 TokenType).
// TokenType values (see src/tokens.ts):
// Literals
var TOKEN_IDENTIFIER int = 0;
var TOKEN_STRING int = 1;
var TOKEN_SINGLE_QUOTE_STRING int = 2;
var TOKEN_NUMBER_DECIMAL int = 3;
var TOKEN_NUMBER_HEX int = 4;
var TOKEN_NUMBER int = 5;
var TOKEN_COMMENT int = 6;
// Single-char
var TOKEN_LEFT_PAREN int = 7;
var TOKEN_RIGHT_PAREN int = 8;
var TOKEN_LEFT_BRACE int = 9;
var TOKEN_RIGHT_BRACE int = 10;
var TOKEN_LEFT_BRACKET int = 11;
var TOKEN_RIGHT_BRACKET int = 12;
var TOKEN_COMMA int = 13;
var TOKEN_DOT int = 14;
var TOKEN_QUESTION int = 15;
var TOKEN_COLON int = 16;
var TOKEN_SEMICOLON int = 17;
var TOKEN_TILDE int = 18;
// One- or two-char
var TOKEN_PLUS_PLUS int = 19;
var TOKEN_MINUS_MINUS int = 20;
var TOKEN_BANG_EQUAL int = 21;
var TOKEN_BANG int = 22;
var TOKEN_EQUAL_EQUAL int = 23;
var TOKEN_EQUAL int = 24;
var TOKEN_GREATER_EQUAL int = 25;
var TOKEN_GREATER int = 26;
var TOKEN_LESS_EQUAL int = 27;
var TOKEN_LESS int = 28;
var TOKEN_AMP_AMP int = 29;
var TOKEN_AMP int = 30;
var TOKEN_BAR_BAR int = 31;
var TOKEN_BAR int = 32;
var TOKEN_CARET int = 33;
var TOKEN_SHIFT_LEFT int = 34;
var TOKEN_SHIFT_RIGHT int = 35;
var TOKEN_MINUS_EQUAL int = 36;
var TOKEN_MINUS int = 37;
var TOKEN_PLUS_EQUAL int = 38;
var TOKEN_PLUS int = 39;
var TOKEN_SLASH_EQUAL int = 40;
var TOKEN_SLASH int = 41;
var TOKEN_STAR_EQUAL int = 42;
var TOKEN_STAR int = 43;
var TOKEN_PERCENT_EQUAL int = 44;
var TOKEN_PERCENT int = 45;
// Keywords
var TOKEN_BYTE int = 46;
var TOKEN_BOOL int = 47;
var TOKEN_BREAK int = 48;
var TOKEN_CONTINUE int = 49;
var TOKEN_DEF int = 50;
var TOKEN_ELSE int = 51;
var TOKEN_EXPORT int = 52;
var TOKEN_IMPORT int = 53;
var TOKEN_FALSE int = 54;
var TOKEN_FOR int = 55;
var TOKEN_FLOAT int = 56;
var TOKEN_IF int = 57;
var TOKEN_INT int = 58;
var TOKEN_LEN int = 59;
var TOKEN_PRINT int = 60;
var TOKEN_RETURN int = 61;
var TOKEN_STRUCT int = 62;
var TOKEN_TRUE int = 63;
var TOKEN_VAR int = 64;
var TOKEN_VOID int = 65;
var TOKEN_SWITCH int = 66;
var TOKEN_CASE int = 67;
var TOKEN_DEFAULT int = 68;
var TOKEN_WHILE int = 69;
// EOF
var TOKEN_EOF int = 70;

// Token storage (currently store only kind as int for minimal footprint).
struct Token { kind int, start int, length int, line int }

def vec_token_new(cap int) Vec {
  return vec_new(4, cap);
}

def push_token_kind(v Vec, kind int) Vec {
  var k = kind;
  return vec_push(v, byte~(&k));
}

def is_alpha(b byte) int {
  if (b >= byte(65) && b <= byte(90)) { return 1; }   // A-Z
  if (b >= byte(97) && b <= byte(122)) { return 1; }  // a-z
  if (b == byte(95)) { return 1; } // underscore
  return 0;
}

def is_digit(b byte) int {
  if (b >= byte(48) && b <= byte(57)) { return 1; }
  return 0;
}

def is_alnum(b byte) int {
  if (is_alpha(b) == 1) { return 1; }
  if (is_digit(b) == 1) { return 1; }
  return 0;
}

def match_keyword(src byte~, start int, length int) int {
  // Minimal keywords needed for current tests.
  if (length == 3) {
    if ((src + start)~ == byte(100) && (src + start + 1)~ == byte(101) && (src + start + 2)~ == byte(102)) { return TOKEN_DEF; }
    if ((src + start)~ == byte(105) && (src + start + 1)~ == byte(110) && (src + start + 2)~ == byte(116)) { return TOKEN_INT; }
    if ((src + start)~ == byte(118) && (src + start + 1)~ == byte(97) && (src + start + 2)~ == byte(114)) { return TOKEN_VAR; }
  }
  if (length == 6) {
    if ((src + start)~ == byte(114) && (src + start + 1)~ == byte(101) && (src + start + 2)~ == byte(116) && (src + start + 3)~ == byte(117) && (src + start + 4)~ == byte(114) && (src + start + 5)~ == byte(110)) { return TOKEN_RETURN; }
  }
  return -1;
}

// Simplified scanner adequate for current Stage1 tests (def/return/ident/number/parens/braces/semicolon).
def scan_kinds(src byte~, n int) VecInt {
  var i = 0;
  var out = vecint_new(32);
  while (i < n) {
    var c = (src + i)~;
    if (c == byte(32) || c == byte(10) || c == byte(9) || c == byte(13)) { i = i + 1; continue; }
    if (is_alpha(c) == 1) {
      var start = i;
      while (i < n && is_alnum((src + i)~) == 1) { i = i + 1; }
      var kw = match_keyword(src, start, i - start);
      if (kw != -1) {
        out = vecint_push(out, kw);
      } else {
        out = vecint_push(out, TOKEN_IDENTIFIER);
      }
      continue;
    }
    if (is_digit(c) == 1) {
      while (i < n && is_digit((src + i)~) == 1) { i = i + 1; }
      out = vecint_push(out, TOKEN_NUMBER);
      continue;
    }
    if (c == byte(43)) { out = vecint_push(out, TOKEN_PLUS); i = i + 1; continue; }
    if (c == byte(61)) { out = vecint_push(out, TOKEN_EQUAL); i = i + 1; continue; }
    if (c == byte(44)) { out = vecint_push(out, TOKEN_COMMA); i = i + 1; continue; }
    if (c == byte(40)) { out = vecint_push(out, TOKEN_LEFT_PAREN); i = i + 1; continue; }
    if (c == byte(41)) { out = vecint_push(out, TOKEN_RIGHT_PAREN); i = i + 1; continue; }
    if (c == byte(123)) { out = vecint_push(out, TOKEN_LEFT_BRACE); i = i + 1; continue; }
    if (c == byte(125)) { out = vecint_push(out, TOKEN_RIGHT_BRACE); i = i + 1; continue; }
    if (c == byte(59)) { out = vecint_push(out, TOKEN_SEMICOLON); i = i + 1; continue; }
    i = i + 1;
  }
  out = vecint_push(out, TOKEN_EOF);
  return out;
}

// Minimal keyword matcher for scan_tokens (def/return/int/var/len).
def match_keyword_tokens(src byte~, start int, length int) int {
  if (length == 3) {
    if ((src + start)~ == byte(100) && (src + start + 1)~ == byte(101) && (src + start + 2)~ == byte(102)) { return TOKEN_DEF; }
    if ((src + start)~ == byte(105) && (src + start + 1)~ == byte(110) && (src + start + 2)~ == byte(116)) { return TOKEN_INT; }
    if ((src + start)~ == byte(118) && (src + start + 1)~ == byte(97) && (src + start + 2)~ == byte(114)) { return TOKEN_VAR; }
    if ((src + start)~ == byte(108) && (src + start + 1)~ == byte(101) && (src + start + 2)~ == byte(110)) { return TOKEN_LEN; }
  }
  if (length == 6) {
    if ((src + start)~ == byte(114) && (src + start + 1)~ == byte(101) && (src + start + 2)~ == byte(116) && (src + start + 3)~ == byte(117) && (src + start + 4)~ == byte(114) && (src + start + 5)~ == byte(110)) { return TOKEN_RETURN; }
  }
  return -1;
}

// Simplified token scanner: leverage scan_kinds to avoid duplicate logic, and wrap into Token Vec.
// start/length/line are stubbed (0/0/1) for now; enough for current use and avoids heavy IR.
def scan_tokens(src byte~, n int) Vec {
  var kinds = scan_kinds(src, n);
  var out = vec_token_new(kinds.length + 1);
  var i = 0;
  while (i < kinds.length) {
    var k = vecint_get(kinds, i);
    out = push_token_kind(out, k);
    i = i + 1;
  }
  return out;
}

// Full scanner alias.
def scan_tokens_full(src byte~, n int) Vec { return scan_tokens(src, n); }

// Helpers for reading Token fields from the Vec returned by scan_tokens.
def token_kind_at(tokens Vec, idx int) int {
  return (int~(vec_get_ptr(tokens, idx)))~;
}

def token_length_at(tokens Vec, idx int) int {
  return 0;
}

