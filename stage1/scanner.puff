// Stage1 Puffscript scanner (simplified) producing token kinds as ints.
var TOKEN_EOF int = 0;
var TOKEN_IDENTIFIER int = 1;
var TOKEN_NUMBER int = 2;
var TOKEN_LEFT_PAREN int = 3;
var TOKEN_RIGHT_PAREN int = 4;
var TOKEN_LEFT_BRACE int = 5;
var TOKEN_RIGHT_BRACE int = 6;
var TOKEN_DEF int = 7;
var TOKEN_RETURN int = 8;
var TOKEN_SEMICOLON int = 9;

def is_alpha(b byte) int {
  if (b >= byte(65) && b <= byte(90)) { return 1; }   // A-Z
  if (b >= byte(97) && b <= byte(122)) { return 1; }  // a-z
  if (b == byte(95)) { return 1; } // underscore
  return 0;
}

def is_digit(b byte) int {
  if (b >= byte(48) && b <= byte(57)) { return 1; }
  return 0;
}

def is_alnum(b byte) int {
  if (is_alpha(b) == 1) { return 1; }
  if (is_digit(b) == 1) { return 1; }
  return 0;
}

def match_keyword(src byte~, start int, length int, a byte, b byte, c byte, d byte, e byte, f byte) int {
  if (length == 3) {
    if ((src + start)~ == a && (src + start + 1)~ == b && (src + start + 2)~ == c) { return 1; }
  }
  if (length == 6) {
    if ((src + start)~ == a && (src + start + 1)~ == b && (src + start + 2)~ == c && (src + start + 3)~ == d && (src + start + 4)~ == e && (src + start + 5)~ == f) { return 1; }
  }
  return 0;
}

def scan_kinds(src byte~, n int) VecInt {
  var i = 0;
  var out = vecint_new(32);
  while (i < n) {
    var c = (src + i)~;
    if (c == byte(32) || c == byte(10) || c == byte(9) || c == byte(13)) {
      i = i + 1;
      continue;
    }
    if (is_alpha(c) == 1) {
      var start = i;
      while (i < n && is_alnum((src + i)~) == 1) { i = i + 1; }
      var length = i - start;
      if (match_keyword(src, start, length, byte(100), byte(101), byte(102), byte(0), byte(0), byte(0)) == 1) {
        out = vecint_push(out, TOKEN_DEF);
      } else if (match_keyword(src, start, length, byte(114), byte(101), byte(116), byte(117), byte(114), byte(110)) == 1) {
        out = vecint_push(out, TOKEN_RETURN);
      } else {
        out = vecint_push(out, TOKEN_IDENTIFIER);
      }
      continue;
    }
    if (is_digit(c) == 1) {
      while (i < n && is_digit((src + i)~) == 1) { i = i + 1; }
      out = vecint_push(out, TOKEN_NUMBER);
      continue;
    }
    if (c == byte(40)) { out = vecint_push(out, TOKEN_LEFT_PAREN); i = i + 1; continue; }   // (
    if (c == byte(41)) { out = vecint_push(out, TOKEN_RIGHT_PAREN); i = i + 1; continue; }  // )
    if (c == byte(123)) { out = vecint_push(out, TOKEN_LEFT_BRACE); i = i + 1; continue; }  // {
    if (c == byte(125)) { out = vecint_push(out, TOKEN_RIGHT_BRACE); i = i + 1; continue; } // }
    if (c == byte(59)) { out = vecint_push(out, TOKEN_SEMICOLON); i = i + 1; continue; }    // ;
    // Unknown char: skip
    i = i + 1;
  }
  out = vecint_push(out, TOKEN_EOF);
  return out;
}
