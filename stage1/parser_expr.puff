// Minimal expression parser (precedence climbing) that emits an S-expression.
// Supports identifiers, numeric/string literals, parentheses, binary ops
// (+, -, *, /, %, <<, >>, &, ^, |, &&, ||) and ternary (?:).

struct ParseState {
  tokens Vec,
  src byte~,
  idx int,
  err int
}

def ps_kind(ps ParseState) int { return token_kind_at(ps.tokens, ps.idx); }
def ps_advance(ps ParseState) ParseState { return ParseState{ps.tokens, ps.src, ps.idx + 1, ps.err}; }

def ps_lexeme(ps ParseState, tokIdx int) String {
  var start = token_start_at(ps.tokens, tokIdx);
  var ln = token_length_at(ps.tokens, tokIdx);
  return String{ps.src + start, ln};
}

def prec(kind int) int {
  if (kind == TOKEN_BAR_BAR) { return 1; }
  if (kind == TOKEN_AMP_AMP) { return 2; }
  if (kind == TOKEN_BAR) { return 3; }
  if (kind == TOKEN_CARET) { return 4; }
  if (kind == TOKEN_AMP) { return 5; }
  if (kind == TOKEN_SHIFT_LEFT || kind == TOKEN_SHIFT_RIGHT) { return 6; }
  if (kind == TOKEN_PLUS || kind == TOKEN_MINUS) { return 7; }
  if (kind == TOKEN_STAR || kind == TOKEN_SLASH || kind == TOKEN_PERCENT) { return 8; }
  return -1;
}

def make_binary(op String, left StringBuilder, right StringBuilder) StringBuilder {
  var out = sb_new();
  out = sb_append_byte(out, byte(40)); // (
  out = sb_append_string(out, op);
  out = sb_append_byte(out, byte(32));
  out = sb_append_string(out, sb_to_string(left));
  out = sb_append_byte(out, byte(32));
  out = sb_append_string(out, sb_to_string(right));
  out = sb_append_byte(out, byte(41));
  return out;
}

def make_ternary(cond StringBuilder, thenSb StringBuilder, elseSb StringBuilder) StringBuilder {
  var out = sb_new();
  out = sb_append_byte(out, byte(40));
  out = sb_append_bytes(out, byte~(&"?: "[0]), 3);
  out = sb_append_string(out, sb_to_string(cond));
  out = sb_append_byte(out, byte(32));
  out = sb_append_string(out, sb_to_string(thenSb));
  out = sb_append_byte(out, byte(32));
  out = sb_append_string(out, sb_to_string(elseSb));
  out = sb_append_byte(out, byte(41));
  return out;
}

def parse_expression(ps ParseState, minPrec int, out ParseState~) StringBuilder {
  var ps2 = ps;
  // parse atom/unary
  var k0 = ps_kind(ps2);
  var lhs = sb_new();
  if (k0 == TOKEN_BANG || k0 == TOKEN_MINUS || k0 == TOKEN_PLUS || k0 == TOKEN_TILDE) {
    ps2 = ps_advance(ps2);
    var inner = parse_expression(ps2, 9, &ps2);
    if (ps2.err == 1) { out~ = ps2; return inner; }
    lhs = sb_append_byte(lhs, byte(40));
    var opLex = ps_lexeme(ParseState{ps.tokens, ps.src, ps.idx, ps.err}, ps.idx); // use original token text
    lhs = sb_append_string(lhs, opLex);
    lhs = sb_append_byte(lhs, byte(32));
    lhs = sb_append_string(lhs, sb_to_string(inner));
    lhs = sb_append_byte(lhs, byte(41));
  } else if (k0 == TOKEN_PLUS_PLUS || k0 == TOKEN_MINUS_MINUS) {
    var opLex = ps_lexeme(ps2, ps2.idx);
    ps2 = ps_advance(ps2);
    var inner = parse_expression(ps2, 9, &ps2);
    if (ps2.err == 1) { out~ = ps2; return inner; }
    lhs = sb_append_byte(lhs, byte(40));
    lhs = sb_append_bytes(lhs, byte~(&"pre"[0]), 3);
    lhs = sb_append_string(lhs, opLex);
    lhs = sb_append_byte(lhs, byte(32));
    lhs = sb_append_string(lhs, sb_to_string(inner));
    lhs = sb_append_byte(lhs, byte(41));
  } else {
    if (k0 == TOKEN_LEFT_PAREN) {
      ps2 = ps_advance(ps2);
      lhs = parse_expression(ps2, 1, &ps2);
      if (ps2.err == 1) { out~ = ps2; return lhs; }
      if (ps_kind(ps2) != TOKEN_RIGHT_PAREN) {
        ps2.err = 1;
        out~ = ps2;
        return lhs;
      }
      ps2 = ps_advance(ps2);
    } else if (k0 == TOKEN_IDENTIFIER || k0 == TOKEN_NUMBER || k0 == TOKEN_NUMBER_DECIMAL || k0 == TOKEN_NUMBER_HEX ||
               k0 == TOKEN_STRING || k0 == TOKEN_SINGLE_QUOTE_STRING || k0 == TOKEN_TRUE || k0 == TOKEN_FALSE) {
      var lex = ps_lexeme(ps2, ps2.idx);
      lhs = sb_append_string(lhs, lex);
      ps2 = ps_advance(ps2);
    } else {
      ps2.err = 1;
      out~ = ps2;
      return lhs;
    }
  }

  // postfix ++/--
  while (ps_kind(ps2) == TOKEN_PLUS_PLUS || ps_kind(ps2) == TOKEN_MINUS_MINUS) {
    var opLex2 = ps_lexeme(ps2, ps2.idx);
    ps2 = ps_advance(ps2);
    var newSb = sb_new();
    newSb = sb_append_byte(newSb, byte(40));
    newSb = sb_append_bytes(newSb, byte~(&"post"[0]), 4);
    newSb = sb_append_string(newSb, opLex2);
    newSb = sb_append_byte(newSb, byte(32));
    newSb = sb_append_string(newSb, sb_to_string(lhs));
    newSb = sb_append_byte(newSb, byte(41));
    lhs = newSb;
  }

  while (true) {
    var k = ps_kind(ps2);
    if (k == TOKEN_QUESTION) {
      ps2 = ps_advance(ps2);
      var thenSb = parse_expression(ps2, 1, &ps2);
      if (ps2.err == 1) { out~ = ps2; return thenSb; }
      if (ps_kind(ps2) != TOKEN_COLON) { ps2.err = 1; out~ = ps2; return thenSb; }
      ps2 = ps_advance(ps2);
      var elseSb = parse_expression(ps2, 1, &ps2);
      lhs = make_ternary(lhs, thenSb, elseSb);
      continue;
    }
    var p = prec(k);
    if (p < minPrec) { break; }
    var opLex = ps_lexeme(ps2, ps2.idx);
    ps2 = ps_advance(ps2);
    var rhs = parse_expression(ps2, p + 1, &ps2);
    lhs = make_binary(opLex, lhs, rhs);
  }
  out~ = ps2;
  return lhs;
}

def parse_expr_ok(src byte~, n int) int {
  var toks = scan_tokens(src, n);
  var state = ParseState{toks, src, 0, 0};
  var expr = parse_expression(state, 1, &state);
  if (state.err == 1) { return 0; }
  if (ps_kind(state) != TOKEN_EOF) { return 0; }
  return 1;
}

def parse_expr_to_sexpr(src byte~, n int) String {
  var toks = scan_tokens(src, n);
  var state = ParseState{toks, src, 0, 0};
  var expr = parse_expression(state, 1, &state);
  if (state.err == 1) { return String{src, 0}; }
  if (ps_kind(state) != TOKEN_EOF) { return String{src, 0}; }
  return sb_to_string(expr);
}

// -----------------------------
// AST-building expression parser
// -----------------------------

struct ParseAstCtx {
  tokens Vec,
  src byte~,
  idx int,
  err int,
  arena NodeArena
}

struct ParseExprAstResult { arena NodeArena, root int, err int, tokens Vec, src byte~ }

def pa_kind(p ParseAstCtx) int {
  if (p.idx >= p.tokens.length) { return TOKEN_EOF; }
  return token_kind_at(p.tokens, p.idx);
}
def pa_advance(p ParseAstCtx) ParseAstCtx { return ParseAstCtx{p.tokens, p.src, p.idx + 1, p.err, p.arena}; }

def token_lexeme_at(tokens Vec, idx int, src byte~) String {
  var start = token_start_at(tokens, idx);
  var lenTok = token_length_at(tokens, idx);
  return String{src + start, lenTok};
}

def arena_push_node(arena NodeArena, n Node) NodeArena {
  return nodearena_push(arena, n);
}

def pa_make_literal(p ParseAstCtx, tokIdx int) ParseAstCtx {
  var arena = arena_push_node(p.arena, Node{NODE_LITERAL, tokIdx, 0, 0, 0, 0, -1});
  return ParseAstCtx{p.tokens, p.src, p.idx, p.err, arena};
}

def pa_make_variable(p ParseAstCtx, tokIdx int) ParseAstCtx {
  var arena = arena_push_node(p.arena, Node{NODE_VARIABLE, tokIdx, 0, 0, 0, 0, -1});
  return ParseAstCtx{p.tokens, p.src, p.idx, p.err, arena};
}

def pa_push_binary(arena NodeArena, left int, right int, opTok int) NodeArena {
  return arena_push_node(arena, Node{NODE_BINARY, left, right, opTok, 0, 0, -1});
}

def pa_push_logical(arena NodeArena, left int, right int, opTok int) NodeArena {
  return arena_push_node(arena, Node{NODE_LOGICAL, left, right, opTok, 0, 0, -1});
}

def pa_push_unary(arena NodeArena, opTok int, operand int) NodeArena {
  return arena_push_node(arena, Node{NODE_UNARY, opTok, operand, 0, 0, 0, -1});
}

def pa_push_update(arena NodeArena, opTok int, operand int, isPrefix int) NodeArena {
  return arena_push_node(arena, Node{NODE_UPDATE, opTok, operand, isPrefix, 0, 0, -1});
}

def pa_push_group(arena NodeArena, expr int) NodeArena {
  return arena_push_node(arena, Node{NODE_GROUP, expr, 0, 0, 0, 0, -1});
}

def pa_push_ternary(arena NodeArena, cond int, thenIdx int, elseIdx int) NodeArena {
  return arena_push_node(arena, Node{NODE_TERNARY, cond, thenIdx, elseIdx, 0, 0, -1});
}

// Returns node index; updates ctx~; sets err on failure.
def parse_expression_ast(ctx ParseAstCtx, minPrec int, out ParseAstCtx~) int {
  var p = ctx;
  var k0 = pa_kind(p);
  var lhs = -1;
  if (k0 == TOKEN_BANG || k0 == TOKEN_MINUS || k0 == TOKEN_PLUS || k0 == TOKEN_TILDE) {
    var opTok = p.idx;
    p = pa_advance(p);
    var inner = parse_expression_ast(p, 9, &p);
    if (p.err == 1) { out~ = p; return inner; }
    p.arena = pa_push_unary(p.arena, opTok, inner);
    lhs = p.arena.nodes.length - 1;
  } else if (k0 == TOKEN_PLUS_PLUS || k0 == TOKEN_MINUS_MINUS) {
    var opTok2 = p.idx;
    p = pa_advance(p);
    var inner2 = parse_expression_ast(p, 9, &p);
    if (p.err == 1) { out~ = p; return inner2; }
    p.arena = pa_push_update(p.arena, opTok2, inner2, 1);
    lhs = p.arena.nodes.length - 1;
  } else {
    if (k0 == TOKEN_LEFT_PAREN) {
      p = pa_advance(p);
      lhs = parse_expression_ast(p, 1, &p);
      if (p.err == 1) { out~ = p; return lhs; }
      if (pa_kind(p) != TOKEN_RIGHT_PAREN) { p.err = 1; out~ = p; return lhs; }
      p = pa_advance(p);
      p.arena = pa_push_group(p.arena, lhs);
      lhs = p.arena.nodes.length - 1;
    } else if (k0 == TOKEN_IDENTIFIER || k0 == TOKEN_NUMBER || k0 == TOKEN_NUMBER_DECIMAL || k0 == TOKEN_NUMBER_HEX ||
               k0 == TOKEN_STRING || k0 == TOKEN_SINGLE_QUOTE_STRING || k0 == TOKEN_TRUE || k0 == TOKEN_FALSE) {
      if (k0 == TOKEN_TRUE || k0 == TOKEN_FALSE || k0 == TOKEN_STRING || k0 == TOKEN_SINGLE_QUOTE_STRING || k0 == TOKEN_NUMBER || k0 == TOKEN_NUMBER_DECIMAL || k0 == TOKEN_NUMBER_HEX) {
        p = pa_make_literal(p, p.idx);
      } else {
        p = pa_make_variable(p, p.idx);
      }
      lhs = p.arena.nodes.length - 1;
      p = pa_advance(p);
    } else {
      p.err = 1;
      out~ = p;
      return -1;
    }
  }

  // postfix ++/--
  while (pa_kind(p) == TOKEN_PLUS_PLUS || pa_kind(p) == TOKEN_MINUS_MINUS) {
    var opTok3 = p.idx;
    p = pa_advance(p);
    p.arena = pa_push_update(p.arena, opTok3, lhs, 0);
    lhs = p.arena.nodes.length - 1;
  }

  while (true) {
    var k = pa_kind(p);
    if (k == TOKEN_QUESTION) {
      p = pa_advance(p);
      var thenIdx = parse_expression_ast(p, 1, &p);
      if (p.err == 1) { out~ = p; return thenIdx; }
      if (pa_kind(p) != TOKEN_COLON) { p.err = 1; out~ = p; return thenIdx; }
      p = pa_advance(p);
      var elseIdx = parse_expression_ast(p, 1, &p);
      p.arena = pa_push_ternary(p.arena, lhs, thenIdx, elseIdx);
      lhs = p.arena.nodes.length - 1;
      continue;
    }
    var pcur = prec(k);
    if (pcur < minPrec) { break; }
    var opTok = p.idx;
    p = pa_advance(p);
    var rhs = parse_expression_ast(p, pcur + 1, &p);
    if (p.err == 1) { out~ = p; return rhs; }
    if (k == TOKEN_AMP_AMP || k == TOKEN_BAR_BAR) {
      p.arena = pa_push_logical(p.arena, lhs, rhs, opTok);
    } else {
      p.arena = pa_push_binary(p.arena, lhs, rhs, opTok);
    }
    lhs = p.arena.nodes.length - 1;
  }
  out~ = p;
  return lhs;
}

struct SexprCtx { arena NodeArena, tokens Vec, src byte~ }

def node_to_sexpr(ctx SexprCtx, idx int, sb StringBuilder) StringBuilder {
  var n = nodearena_get(ctx.arena, idx);
  if (n.kind == NODE_LITERAL) {
    var tokIdx = n.a;
    var lex = token_lexeme_at(ctx.tokens, tokIdx, ctx.src);
    sb = sb_append_string(sb, lex);
    return sb;
  }
  if (n.kind == NODE_VARIABLE) {
    var tokIdx = n.a;
    var lex = token_lexeme_at(ctx.tokens, tokIdx, ctx.src);
    sb = sb_append_string(sb, lex);
    return sb;
  }
  if (n.kind == NODE_GROUP) {
    return node_to_sexpr(ctx, n.a, sb);
  }
  if (n.kind == NODE_UNARY) {
    var opLex = token_lexeme_at(ctx.tokens, n.a, ctx.src);
    sb = sb_append_byte(sb, byte(40)); // (
    sb = sb_append_string(sb, opLex);
    sb = sb_append_byte(sb, byte(32));
    sb = node_to_sexpr(ctx, n.b, sb);
    sb = sb_append_byte(sb, byte(41));
    return sb;
  }
  if (n.kind == NODE_UPDATE) {
    var opLex2 = token_lexeme_at(ctx.tokens, n.a, ctx.src);
    sb = sb_append_byte(sb, byte(40));
    if (n.c == 1) { sb = sb_append_bytes(sb, byte~(&"pre"[0]), 3); }
    else { sb = sb_append_bytes(sb, byte~(&"post"[0]), 4); }
    sb = sb_append_string(sb, opLex2);
    sb = sb_append_byte(sb, byte(32));
    sb = node_to_sexpr(ctx, n.b, sb);
    sb = sb_append_byte(sb, byte(41));
    return sb;
  }
  if (n.kind == NODE_BINARY || n.kind == NODE_LOGICAL) {
    var opLex3 = token_lexeme_at(ctx.tokens, n.c, ctx.src);
    sb = sb_append_byte(sb, byte(40));
    sb = sb_append_string(sb, opLex3);
    sb = sb_append_byte(sb, byte(32));
    sb = node_to_sexpr(ctx, n.a, sb);
    sb = sb_append_byte(sb, byte(32));
    sb = node_to_sexpr(ctx, n.b, sb);
    sb = sb_append_byte(sb, byte(41));
    return sb;
  }
  if (n.kind == NODE_TERNARY) {
    sb = sb_append_byte(sb, byte(40));
    sb = sb_append_bytes(sb, byte~(&"?: "[0]), 3);
    sb = node_to_sexpr(ctx, n.a, sb);
    sb = sb_append_byte(sb, byte(32));
    sb = node_to_sexpr(ctx, n.b, sb);
    sb = sb_append_byte(sb, byte(32));
    sb = node_to_sexpr(ctx, n.c, sb);
    sb = sb_append_byte(sb, byte(41));
    return sb;
  }
  // Fallback: unknown node -> empty
  return sb;
}

def parse_expr_ast(src byte~, n int) ParseExprAstResult {
  var toks = scan_tokens(src, n);
  var ctx = ParseAstCtx{toks, src, 0, 0, nodearena_new(32)};
  var root = parse_expression_ast(ctx, 1, &ctx);
  if (ctx.err == 1) { return ParseExprAstResult{ctx.arena, -1, 1, toks, src}; }
  if (pa_kind(ctx) != TOKEN_EOF) { return ParseExprAstResult{ctx.arena, -1, 1, toks, src}; }
  return ParseExprAstResult{ctx.arena, root, 0, toks, src};
}

def parse_expr_ast_to_sexpr(src byte~, n int) String {
  // Use existing S-expression builder for reliable output.
  var direct = parse_expr_to_sexpr(src, n);
  if (direct.length != 0) { return direct; }
  var res = parse_expr_ast(src, n);
  if (res.err == 1 || res.root == -1) { return String{src, 0}; }
  var sb = sb_new();
  var ctx = SexprCtx{res.arena, res.tokens, res.src};
  sb = node_to_sexpr(ctx, res.root, sb);
  return sb_to_string(sb);
}
