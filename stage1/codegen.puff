      sbInstr2 = sb_append_string(sbInstr2, resultTy);
      sbInstr2 = sb_append_byte(sbInstr2, byte(32));
    } else if (op.length == 1 && (op.data)~ == byte(94)) { // '^'
      sbInstr2 = sb_append_cstr(sbInstr2, byte~(&" = xor "[0]));
      sbInstr2 = sb_append_string(sbInstr2, resultTy);
      sbInstr2 = sb_append_byte(sbInstr2, byte(32));
    } else if (op.length == 2 && (op.data)~ == byte(61) && (op.data + 1)~ == byte(61)) { // "=="
      resultTy = String{byte~(&"i1"[0]), 2};
      sbInstr2 = sb_append_cstr(sbInstr2, byte~(&" = icmp eq "[0]));
      sbInstr2 = sb_append_string(sbInstr2, lTy);
      sbInstr2 = sb_append_byte(sbInstr2, byte(32));
    } else if (op.length == 2 && (op.data)~ == byte(33) && (op.data + 1)~ == byte(61)) { // "!="
      resultTy = String{byte~(&"i1"[0]), 2};
      sbInstr2 = sb_append_cstr(sbInstr2, byte~(&" = icmp ne "[0]));
      sbInstr2 = sb_append_string(sbInstr2, lTy);
      sbInstr2 = sb_append_byte(sbInstr2, byte(32));
    } else if (op.length == 1 && (op.data)~ == byte(60)) { // '<'
      resultTy = String{byte~(&"i1"[0]), 2};
      sbInstr2 = sb_append_cstr(sbInstr2, byte~(&" = icmp slt "[0]));
      sbInstr2 = sb_append_string(sbInstr2, lTy);
      sbInstr2 = sb_append_byte(sbInstr2, byte(32));
    } else if (op.length == 2 && (op.data)~ == byte(60) && (op.data + 1)~ == byte(61)) { // "<="
      resultTy = String{byte~(&"i1"[0]), 2};
      sbInstr2 = sb_append_cstr(sbInstr2, byte~(&" = icmp sle "[0]));
      sbInstr2 = sb_append_string(sbInstr2, lTy);
      sbInstr2 = sb_append_byte(sbInstr2, byte(32));
    } else if (op.length == 1 && (op.data)~ == byte(62)) { // '>'
      resultTy = String{byte~(&"i1"[0]), 2};
      sbInstr2 = sb_append_cstr(sbInstr2, byte~(&" = icmp sgt "[0]));
      sbInstr2 = sb_append_string(sbInstr2, lTy);
      sbInstr2 = sb_append_byte(sbInstr2, byte(32));
    } else if (op.length == 2 && (op.data)~ == byte(62) && (op.data + 1)~ == byte(61)) { // ">="
      resultTy = String{byte~(&"i1"[0]), 2};
      sbInstr2 = sb_append_cstr(sbInstr2, byte~(&" = icmp sge "[0]));
      sbInstr2 = sb_append_string(sbInstr2, lTy);
      sbInstr2 = sb_append_byte(sbInstr2, byte(32));
    } else {
      return ExprCodegenResult{sb_to_string(sbInstr2), tmpName2, String{pmr.src, 0}, 1};
    }
    sbInstr2 = sb_append_string(sbInstr2, lVal);
    sbInstr2 = sb_append_cstr(sbInstr2, byte~(&", "[0]));
    sbInstr2 = sb_append_string(sbInstr2, rVal);
    sbInstr2 = sb_append_byte(sbInstr2, byte(10));
    return ExprCodegenResult{sb_to_string(sbInstr2), tmpName2, resultTy, 0};
  }
  if (n.kind == NODE_LOGICAL) {
    var left = cg_expr(pmr, tm, n.a, paramNames, paramTypes, paramSlots, paramSlotTypes, localNames, localPtrs, localTypes, tmp);
    var lbool = cg_to_bool(left, tmp);
    if (lbool.err == 1) { return lbool; }
    var opTok2 = cg_tok_string(pmr.tokens, pmr.src, n.c);
    var rhsLabel = cg_fresh_label(tmp);
    var skipLabel = cg_fresh_label(tmp);
    var endLabel = cg_fresh_label(tmp);
    var tmpPhi = cg_fresh_tmp(tmp);
    var sbLogic = sb_new();
    sbLogic = sb_append_string(sbLogic, lbool.instr);
    // branch based on operator
    if (opTok2.length == 2 && (opTok2.data)~ == byte(38) && (opTok2.data + 1)~ == byte(38)) { // &&
      sbLogic = sb_append_cstr(sbLogic, byte~(&"  br i1 "[0]));
      sbLogic = sb_append_string(sbLogic, lbool.value);
      sbLogic = sb_append_cstr(sbLogic, byte~(&", label %"[0]));
      sbLogic = sb_append_string(sbLogic, rhsLabel);
      sbLogic = sb_append_cstr(sbLogic, byte~(&", label %"[0]));
      sbLogic = sb_append_string(sbLogic, skipLabel);
      sbLogic = sb_append_byte(sbLogic, byte(10));
      // rhs block
      sbLogic = sb_append_string(sbLogic, rhsLabel);
      sbLogic = sb_append_byte(sbLogic, byte(58));
      sbLogic = sb_append_byte(sbLogic, byte(10));
      var right = cg_expr(pmr, tm, n.b, paramNames, paramTypes, paramSlots, paramSlotTypes, localNames, localPtrs, localTypes, tmp);
      var rbool = cg_to_bool(right, tmp);
      if (rbool.err == 1) { return rbool; }
      sbLogic = sb_append_string(sbLogic, rbool.instr);
      sbLogic = sb_append_cstr(sbLogic, byte~(&"  br label %"[0]));
      sbLogic = sb_append_string(sbLogic, endLabel);
      sbLogic = sb_append_byte(sbLogic, byte(10));
      // skip block
      sbLogic = sb_append_string(sbLogic, skipLabel);
      sbLogic = sb_append_byte(sbLogic, byte(58));
      sbLogic = sb_append_byte(sbLogic, byte(10));
      sbLogic = sb_append_cstr(sbLogic, byte~(&"  br label %"[0]));
      sbLogic = sb_append_string(sbLogic, endLabel);
      sbLogic = sb_append_byte(sbLogic, byte(10));
      // end + phi
      sbLogic = sb_append_string(sbLogic, endLabel);
      sbLogic = sb_append_byte(sbLogic, byte(58));
      sbLogic = sb_append_byte(sbLogic, byte(10));
      sbLogic = sb_append_cstr(sbLogic, byte~(&"  "[0]));
      sbLogic = sb_append_string(sbLogic, tmpPhi);
      sbLogic = sb_append_cstr(sbLogic, byte~(&" = phi i1 [ "[0]));
      sbLogic = sb_append_string(sbLogic, rbool.value);
      sbLogic = sb_append_cstr(sbLogic, byte~(&", %"[0]));
      sbLogic = sb_append_string(sbLogic, rhsLabel);
      sbLogic = sb_append_cstr(sbLogic, byte~(&" ], [ 0, %"[0]));
      sbLogic = sb_append_string(sbLogic, skipLabel);
      sbLogic = sb_append_cstr(sbLogic, byte~(&" ]"[0]));
      sbLogic = sb_append_byte(sbLogic, byte(10));
      return ExprCodegenResult{sb_to_string(sbLogic), tmpPhi, String{byte~(&"i1"[0]), 2}, 0};
    } else if (opTok2.length == 2 && (opTok2.data)~ == byte(124) && (opTok2.data + 1)~ == byte(124)) { // ||
      sbLogic = sb_append_cstr(sbLogic, byte~(&"  br i1 "[0]));
      sbLogic = sb_append_string(sbLogic, lbool.value);
      sbLogic = sb_append_cstr(sbLogic, byte~(&", label %"[0]));
      sbLogic = sb_append_string(sbLogic, skipLabel);
      sbLogic = sb_append_cstr(sbLogic, byte~(&", label %"[0]));
      sbLogic = sb_append_string(sbLogic, rhsLabel);
      sbLogic = sb_append_byte(sbLogic, byte(10));
      // rhs block
      sbLogic = sb_append_string(sbLogic, rhsLabel);
      sbLogic = sb_append_byte(sbLogic, byte(58));
      sbLogic = sb_append_byte(sbLogic, byte(10));
      var right2 = cg_expr(pmr, tm, n.b, paramNames, paramTypes, paramSlots, paramSlotTypes, localNames, localPtrs, localTypes, tmp);
      var rbool2 = cg_to_bool(right2, tmp);
      if (rbool2.err == 1) { return rbool2; }
      sbLogic = sb_append_string(sbLogic, rbool2.instr);
      sbLogic = sb_append_cstr(sbLogic, byte~(&"  br label %"[0]));
      sbLogic = sb_append_string(sbLogic, endLabel);
      sbLogic = sb_append_byte(sbLogic, byte(10));
      // skip block (left true)
      sbLogic = sb_append_string(sbLogic, skipLabel);
      sbLogic = sb_append_byte(sbLogic, byte(58));
      sbLogic = sb_append_byte(sbLogic, byte(10));
      sbLogic = sb_append_cstr(sbLogic, byte~(&"  br label %"[0]));
      sbLogic = sb_append_string(sbLogic, endLabel);
      sbLogic = sb_append_byte(sbLogic, byte(10));
      // end + phi
      sbLogic = sb_append_string(sbLogic, endLabel);
      sbLogic = sb_append_byte(sbLogic, byte(58));
      sbLogic = sb_append_byte(sbLogic, byte(10));
      sbLogic = sb_append_cstr(sbLogic, byte~(&"  "[0]));
      sbLogic = sb_append_string(sbLogic, tmpPhi);
      sbLogic = sb_append_cstr(sbLogic, byte~(&" = phi i1 [ "[0]));
      sbLogic = sb_append_string(sbLogic, rbool2.value);
      sbLogic = sb_append_cstr(sbLogic, byte~(&", %"[0]));
      sbLogic = sb_append_string(sbLogic, rhsLabel);
      sbLogic = sb_append_cstr(sbLogic, byte~(&" ], [ 1, %"[0]));
      sbLogic = sb_append_string(sbLogic, skipLabel);
      sbLogic = sb_append_cstr(sbLogic, byte~(&" ]"[0]));
      sbLogic = sb_append_byte(sbLogic, byte(10));
      return ExprCodegenResult{sb_to_string(sbLogic), tmpPhi, String{byte~(&"i1"[0]), 2}, 0};
    }
    return ExprCodegenResult{sb_to_string(sbLogic), tmpPhi, String{pmr.src, 0}, 1};
  }
  if (n.kind == NODE_TERNARY) {
    var condRes = cg_expr(pmr, tm, n.a, paramNames, paramTypes, paramSlots, paramSlotTypes, localNames, localPtrs, localTypes, tmp);
    var condBool = cg_to_bool(condRes, tmp);
    if (condBool.err == 1) { return condBool; }
    var lthen = cg_fresh_label(tmp);
    var lelse = cg_fresh_label(tmp);
    var lend = cg_fresh_label(tmp);
    var tmpPhi = cg_fresh_tmp(tmp);
    var sbTern = sb_new();
    sbTern = sb_append_string(sbTern, condBool.instr);
    sbTern = sb_append_cstr(sbTern, byte~(&"  br i1 "[0]));
    sbTern = sb_append_string(sbTern, condBool.value);
    sbTern = sb_append_cstr(sbTern, byte~(&", label %"[0]));
    sbTern = sb_append_string(sbTern, lthen);
    sbTern = sb_append_cstr(sbTern, byte~(&", label %"[0]));
    sbTern = sb_append_string(sbTern, lelse);
    sbTern = sb_append_byte(sbTern, byte(10));
    // then block
    sbTern = sb_append_string(sbTern, lthen);
    sbTern = sb_append_byte(sbTern, byte(58));
    sbTern = sb_append_byte(sbTern, byte(10));
    var thenRes = cg_expr(pmr, tm, n.b, paramNames, paramTypes, paramSlots, paramSlotTypes, localNames, localPtrs, localTypes, tmp);
    if (thenRes.err == 1) { return thenRes; }
    sbTern = sb_append_string(sbTern, thenRes.instr);
    sbTern = sb_append_cstr(sbTern, byte~(&"  br label %"[0]));
    sbTern = sb_append_string(sbTern, lend);
    sbTern = sb_append_byte(sbTern, byte(10));
    // else block
    sbTern = sb_append_string(sbTern, lelse);
    sbTern = sb_append_byte(sbTern, byte(58));
    sbTern = sb_append_byte(sbTern, byte(10));
    var elseRes = cg_expr(pmr, tm, n.c, paramNames, paramTypes, paramSlots, paramSlotTypes, localNames, localPtrs, localTypes, tmp);
    if (elseRes.err == 1) { return elseRes; }
    sbTern = sb_append_string(sbTern, elseRes.instr);
    sbTern = sb_append_cstr(sbTern, byte~(&"  br label %"[0]));
    sbTern = sb_append_string(sbTern, lend);
    sbTern = sb_append_byte(sbTern, byte(10));
    // end + phi
    var tyThen = thenRes.valTy;
    var tyElse = elseRes.valTy;
    if (tyThen.length == 0) { tyThen = String{byte~(&"i32"[0]), 3}; }
    if (tyElse.length == 0) { tyElse = String{byte~(&"i32"[0]), 3}; }
    if (cg_str_eq(tyThen, tyElse) == 0) { return ExprCodegenResult{sb_to_string(sbTern), tmpPhi, String{pmr.src, 0}, 1}; }
    sbTern = sb_append_string(sbTern, lend);
    sbTern = sb_append_byte(sbTern, byte(58));
    sbTern = sb_append_byte(sbTern, byte(10));
    sbTern = sb_append_cstr(sbTern, byte~(&"  "[0]));
    sbTern = sb_append_string(sbTern, tmpPhi);
    sbTern = sb_append_cstr(sbTern, byte~(&" = phi "[0]));
    sbTern = sb_append_string(sbTern, tyThen);
    sbTern = sb_append_cstr(sbTern, byte~(&" [ "[0]));
    sbTern = sb_append_string(sbTern, thenRes.value);
    sbTern = sb_append_cstr(sbTern, byte~(&", %"[0]));
    sbTern = sb_append_string(sbTern, lthen);
    sbTern = sb_append_cstr(sbTern, byte~(&" ], [ "[0]));
    sbTern = sb_append_string(sbTern, elseRes.value);
    sbTern = sb_append_cstr(sbTern, byte~(&", %"[0]));
    sbTern = sb_append_string(sbTern, lelse);
    sbTern = sb_append_cstr(sbTern, byte~(&" ]"[0]));
    sbTern = sb_append_byte(sbTern, byte(10));
    return ExprCodegenResult{sb_to_string(sbTern), tmpPhi, tyThen, 0};
  }
  if (n.kind == NODE_DEREF) {
    var baseRes = cg_expr(pmr, tm, n.a, paramNames, paramTypes, paramSlots, paramSlotTypes, localNames, localPtrs, localTypes, tmp);
    if (baseRes.err == 1) { return baseRes; }
    if (cg_is_pointer_type(baseRes.valTy) == 0) { return ExprCodegenResult{baseRes.instr, baseRes.value, String{pmr.src, 0}, 1}; }
    var elemTy = cg_pointer_elem_ty(baseRes.valTy);
    if (elemTy.length == 0) { elemTy = String{byte~(&"i8"[0]), 2}; }
    var tmpLoad = cg_fresh_tmp(tmp);
    var sbLd = sb_new();
    sbLd = sb_append_string(sbLd, baseRes.instr);
    sbLd = sb_append_cstr(sbLd, byte~(&"  "[0]));
    sbLd = sb_append_string(sbLd, tmpLoad);
    sbLd = sb_append_cstr(sbLd, byte~(&" = load "[0]));
    sbLd = sb_append_string(sbLd, elemTy);
    sbLd = sb_append_cstr(sbLd, byte~(&", "[0]));
    sbLd = sb_append_string(sbLd, baseRes.valTy);
    sbLd = sb_append_byte(sbLd, byte(32));
    sbLd = sb_append_string(sbLd, baseRes.value);
    sbLd = sb_append_byte(sbLd, byte(10));
    return ExprCodegenResult{sb_to_string(sbLd), tmpLoad, elemTy, 0};
  }
  if (n.kind == NODE_INDEX) {
    var baseResIdx = cg_expr(pmr, tm, n.a, paramNames, paramTypes, paramSlots, paramSlotTypes, localNames, localPtrs, localTypes, tmp);
    if (baseResIdx.err == 1) { return baseResIdx; }
    var idxRes = cg_expr(pmr, tm, n.b, paramNames, paramTypes, paramSlots, paramSlotTypes, localNames, localPtrs, localTypes, tmp);
    if (idxRes.err == 1) { return idxRes; }
    if (cg_is_pointer_type(baseResIdx.valTy) == 0) { return ExprCodegenResult{baseResIdx.instr, baseResIdx.value, String{pmr.src, 0}, 1}; }
    var elemTyIdx = cg_pointer_elem_ty(baseResIdx.valTy);
    if (elemTyIdx.length == 0) { elemTyIdx = String{byte~(&"i8"[0]), 2}; }
    var basePtrTy = baseResIdx.valTy;
    // Ensure index is i32
    var idx32 = cg_to_i32(idxRes, tmp);
    if (idx32.err == 1) { return idx32; }
    // If pointer is not i8*, bitcast to i8* for pointer arithmetic
    var ptrVal = baseResIdx.value;
    var ptrInstr = baseResIdx.instr;
    if (!(basePtrTy.length == 3 && (basePtrTy.data)~ == byte(105) && (basePtrTy.data + 1)~ == byte(56) && (basePtrTy.data + 2)~ == byte(42))) {
      var tmpCast = cg_fresh_tmp(tmp);
      var sbCast = sb_new();
      sbCast = sb_append_string(sbCast, ptrInstr);
      sbCast = sb_append_cstr(sbCast, byte~(&"  "[0]));
      sbCast = sb_append_string(sbCast, tmpCast);
      sbCast = sb_append_cstr(sbCast, byte~(&" = bitcast "[0]));
      sbCast = sb_append_string(sbCast, basePtrTy);
      sbCast = sb_append_byte(sbCast, byte(32));
      sbCast = sb_append_string(sbCast, baseResIdx.value);
      sbCast = sb_append_cstr(sbCast, byte~(&" to i8*"[0]));
      sbCast = sb_append_byte(sbCast, byte(10));
      ptrInstr = sb_to_string(sbCast);
      ptrVal = tmpCast;
      basePtrTy = String{byte~(&"i8*"[0]), 3};
      elemTyIdx = String{byte~(&"i8"[0]), 2};
    }
    var tmpGep = cg_fresh_tmp(tmp);
    var sbGep = sb_new();
    sbGep = sb_append_string(sbGep, ptrInstr);
    sbGep = sb_append_string(sbGep, idx32.instr);
    sbGep = sb_append_cstr(sbGep, byte~(&"  "[0]));
    sbGep = sb_append_string(sbGep, tmpGep);
    sbGep = sb_append_cstr(sbGep, byte~(&" = getelementptr "[0]));
    sbGep = sb_append_string(sbGep, elemTyIdx);
    sbGep = sb_append_cstr(sbGep, byte~(&", "[0]));
    sbGep = sb_append_string(sbGep, basePtrTy);
    sbGep = sb_append_byte(sbGep, byte(32));
    sbGep = sb_append_string(sbGep, ptrVal);
    sbGep = sb_append_cstr(sbGep, byte~(&", i32 "[0]));
    sbGep = sb_append_string(sbGep, idx32.value);
    sbGep = sb_append_byte(sbGep, byte(10));
    return ExprCodegenResult{sb_to_string(sbGep), tmpGep, basePtrTy, 0};
  }
  if (n.kind == NODE_LEN) {
    var target = nodearena_get(pmr.arena, n.a);
    if (target.kind == NODE_LITERAL) {
      var tk = token_kind_at(pmr.tokens, target.a);
      if (tk == TOKEN_STRING || tk == TOKEN_SINGLE_QUOTE_STRING) {
        var l = token_length_at(pmr.tokens, target.a);
        if (l >= 2) { l = l - 2; }
        var sbLen = sb_new();
        sbLen = sb_append_int(sbLen, l);
        return ExprCodegenResult{String{pmr.src, 0}, sb_to_string(sbLen), String{byte~(&"i32"[0]), 3}, 0};
      }
    }
    var ctxRes = cg_expr(pmr, tm, n.a, paramNames, paramTypes, paramSlots, paramSlotTypes, localNames, localPtrs, localTypes, tmp);
    if (ctxRes.err == 1) { return ctxRes; }
    return ExprCodegenResult{ctxRes.instr, ctxRes.value, String{pmr.src, 0}, 1};
  }
  if (n.kind == NODE_CALL) {
    // Only support direct identifier callees for now.
    var calleeNode = nodearena_get(pmr.arena, n.a);
    if (calleeNode.kind != NODE_VARIABLE) { return ExprCodegenResult{String{pmr.src, 0}, String{pmr.src, 0}, String{pmr.src, 0}, 1}; }
    var name = cg_tok_string(pmr.tokens, pmr.src, calleeNode.a);
    var fi = cg_find_fn_index(pmr, tm, name);
    if (fi == -1) { return ExprCodegenResult{String{pmr.src, 0}, name, String{pmr.src, 0}, 1}; }
    var retId = tm_fn_return_type(tm, fi);
    var retTy = cg_llvm_type(tm.env.tt, retId);
    var paramCount = tm_fn_param_count(tm, fi);
    if (paramCount != n.c) { return ExprCodegenResult{String{pmr.src, 0}, name, retTy, 1}; }
    // Evaluate arguments
    var argInstr = sb_new();
    var argVals = sb_new();
    var argCount = n.c;
    var head = n.b;
    var idx = 0;
    while (head != -1 && idx < argCount) {
      var argNode = nodearena_get(pmr.arena, head);
      var argRes = cg_expr(pmr, tm, argNode.a, paramNames, paramTypes, paramSlots, paramSlotTypes, localNames, localPtrs, localTypes, tmp);
      if (argRes.err == 1) { return argRes; }
      argInstr = sb_append_string(argInstr, argRes.instr);
      if (idx > 0) { argVals = sb_append_cstr(argVals, byte~(&", "[0])); }
      var paramTyId = tm_fn_param_type(tm, fi, idx);
      if (paramTyId == -1) { paramTyId = 5; } // default int
      var paramTy = cg_llvm_type(tm.env.tt, paramTyId);
      argVals = sb_append_string(argVals, paramTy);
      argVals = sb_append_byte(argVals, byte(32));
      argVals = sb_append_string(argVals, argRes.value);
      head = argNode.b;
      idx = idx + 1;
    }
    var tmpName3 = cg_fresh_tmp(tmp);
    var sbCall = sb_new();
    sbCall = sb_append_string(sbCall, sb_to_string(argInstr));
    sbCall = sb_append_cstr(sbCall, byte~(&"  "[0]));
    if (retTy.length == 4 && (retTy.data)~ == byte(118)) {
      // void return
      sbCall = sb_append_cstr(sbCall, byte~(&"call void "[0]));
      sbCall = sb_append_byte(sbCall, byte(64));
      sbCall = sb_append_string(sbCall, name);
      sbCall = sb_append_byte(sbCall, byte(40)); // (
      sbCall = sb_append_string(sbCall, sb_to_string(argVals));
      sbCall = sb_append_byte(sbCall, byte(41)); // )
      sbCall = sb_append_byte(sbCall, byte(10));
      return ExprCodegenResult{sb_to_string(sbCall), String{pmr.src, 0}, retTy, 0};
    } else {
      sbCall = sb_append_string(sbCall, tmpName3);
      sbCall = sb_append_cstr(sbCall, byte~(&" = call "[0]));
      sbCall = sb_append_string(sbCall, retTy);
      sbCall = sb_append_byte(sbCall, byte(32));
      sbCall = sb_append_byte(sbCall, byte(64));
      sbCall = sb_append_string(sbCall, name);
      sbCall = sb_append_byte(sbCall, byte(40)); // (
      sbCall = sb_append_string(sbCall, sb_to_string(argVals));
      sbCall = sb_append_byte(sbCall, byte(41)); // )
      sbCall = sb_append_byte(sbCall, byte(10));
      return ExprCodegenResult{sb_to_string(sbCall), tmpName3, retTy, 0};
    }
  }
  // Unsupported expression kinds for now.
  return ExprCodegenResult{String{pmr.src, 0}, String{pmr.src, 0}, String{pmr.src, 0}, 1};
}

// Emit a range of statements [start, end) using current locals/params.
// Supports var, assign, return, expression statements, and if/else.
def cg_emit_stmt_range(
  pmr ParseModuleResult,
  tm TypeModuleTypes,
  paramNames VecStr,
  paramTypes VecStr,
  paramSlots VecStr,
  paramSlotTypes VecStr,
  localNames VecStr,
  localPtrs VecStr,
  localTypes VecStr,
  retTy String,
  breakLabel String,
  continueLabel String,
  start int,
  end int,
  tmp int~
) StmtEmitResult {
  var sb = sb_new();
  var ln = localNames;
  var lp = localPtrs;
  var lt = localTypes;
  var emittedRet = 0;
  var term = 0;
  var ranges = SkipRanges{vecint_new(4), vecint_new(4)};
  ranges = cg_collect_skip_ranges(pmr, start, end, start, end, ranges);
  var i = start;
  while (i < end) {
    if (cg_in_skip(ranges, i) == 1) { i = i + 1; continue; }
    if (emittedRet == 1) { break; }
    var stmt = nodearena_get(pmr.arena, i);
    if (stmt.kind == NODE_VAR_STMT) {
      var vname = tok_string(pmr.tokens, stmt.a, pmr.src);
      var vtid = tm_var_type_by_node(tm, i);
      var vty = String{byte~(&"i32"[0]), 3};
      if (vtid != -1) { vty = cg_llvm_type(tm.env.tt, vtid); }
      var initRes = cg_expr(pmr, tm, stmt.b, paramNames, paramTypes, paramSlots, paramSlotTypes, ln, lp, lt, tmp);
      if (initRes.err == 1) { return StmtEmitResult{sb_to_string(sb), emittedRet, ln, lp, lt, term, 1}; }
      var slot = cg_fresh_tmp(tmp);
      sb = sb_append_cstr(sb, byte~(&"  "[0]));
      sb = sb_append_string(sb, slot);
      sb = sb_append_cstr(sb, byte~(&" = alloca "[0]));
      sb = sb_append_string(sb, vty);
      sb = sb_append_byte(sb, byte(10));
      var storeRes = cg_store(slot, vty, initRes, tmp);
      if (storeRes.err == 1) { return StmtEmitResult{sb_to_string(sb), emittedRet, ln, lp, lt, term, 1}; }
      sb = sb_append_string(sb, storeRes.instr);
      ln = vecstr_push(ln, vname);
      lp = vecstr_push(lp, slot);
      lt = vecstr_push(lt, vty);
    } else if (stmt.kind == NODE_ASSIGN) {
      var aname = tok_string(pmr.tokens, stmt.a, pmr.src);
      var slotPtr = String{pmr.src, 0};
      var slotTy = String{pmr.src, 0};
      var li2 = cg_find_name(ln, aname);
      if (li2 != -1) {
        slotPtr = vecstr_get(lp, li2);
        slotTy = vecstr_get(lt, li2);
      } else {
        var pi2 = cg_match_param(paramNames, aname);
        if (pi2 != -1) {
          slotPtr = vecstr_get(paramSlots, pi2);
          slotTy = vecstr_get(paramSlotTypes, pi2);
        }
      }
      if (slotPtr.length == 0 || slotTy.length == 0) { return StmtEmitResult{sb_to_string(sb), emittedRet, ln, lp, lt, term, 1}; }
      var rhs = cg_expr(pmr, tm, stmt.b, paramNames, paramTypes, paramSlots, paramSlotTypes, ln, lp, lt, tmp);
      if (rhs.err == 1) { return StmtEmitResult{sb_to_string(sb), emittedRet, ln, lp, lt, term, 1}; }
      var storeRes2 = cg_store(slotPtr, slotTy, rhs, tmp);
      if (storeRes2.err == 1) { return StmtEmitResult{sb_to_string(sb), emittedRet, ln, lp, lt, term, 1}; }
      sb = sb_append_string(sb, storeRes2.instr);
    } else if (stmt.kind == NODE_RETURN) {
      if (retTy.length == 4 && (retTy.data)~ == byte(118)) {
        sb = sb_append_cstr(sb, byte~(&"  ret void"[0]));
        sb = sb_append_byte(sb, byte(10));
        emittedRet = 1;
        term = 1;
        break;
      }
      var exprRes = cg_expr(pmr, tm, stmt.a, paramNames, paramTypes, paramSlots, paramSlotTypes, ln, lp, lt, tmp);
      if (exprRes.err == 1) { return StmtEmitResult{sb_to_string(sb), emittedRet, ln, lp, lt, term, 1}; }
      var coerced = cg_coerce(exprRes, retTy, tmp);
      if (coerced.err == 1) { return StmtEmitResult{sb_to_string(sb), emittedRet, ln, lp, lt, term, 1}; }
      sb = sb_append_string(sb, coerced.instr);
      sb = sb_append_cstr(sb, byte~(&"  ret "[0]));
      sb = sb_append_string(sb, retTy);
      sb = sb_append_byte(sb, byte(32));
      sb = sb_append_string(sb, coerced.value);
      sb = sb_append_byte(sb, byte(10));
      emittedRet = 1;
      term = 1;
      break;
    } else if (stmt.kind == NODE_EXPR_STMT) {
      var exprOnly = cg_expr(pmr, tm, stmt.a, paramNames, paramTypes, paramSlots, paramSlotTypes, ln, lp, lt, tmp);
      if (exprOnly.err == 1) { return StmtEmitResult{sb_to_string(sb), emittedRet, ln, lp, lt, term, 1}; }
      sb = sb_append_string(sb, exprOnly.instr);
    } else if (stmt.kind == NODE_IF) {
      var condRes = cg_expr(pmr, tm, stmt.a, paramNames, paramTypes, paramSlots, paramSlotTypes, ln, lp, lt, tmp);
      if (condRes.err == 1) { return StmtEmitResult{sb_to_string(sb), emittedRet, ln, lp, lt, term, 1}; }
      var condBool = cg_to_bool(condRes, tmp);
      if (condBool.err == 1) { return StmtEmitResult{sb_to_string(sb), emittedRet, ln, lp, lt, term, 1}; }
      var lthen = cg_fresh_label(tmp);
      var lelse = cg_fresh_label(tmp);
      var lend = cg_fresh_label(tmp);
      sb = sb_append_string(sb, condBool.instr);
      sb = sb_append_cstr(sb, byte~(&"  br i1 "[0]));
      sb = sb_append_string(sb, condBool.value);
      sb = sb_append_cstr(sb, byte~(&", label %"[0]));
      sb = sb_append_string(sb, lthen);
      sb = sb_append_cstr(sb, byte~(&", label %"[0]));
      sb = sb_append_string(sb, lelse);
      sb = sb_append_byte(sb, byte(10));

      // then block
      sb = sb_append_string(sb, lthen);
      sb = sb_append_byte(sb, byte(58));
      sb = sb_append_byte(sb, byte(10));
      var thenRet = 0;
      if (stmt.b != -1) {
        var thenNode = nodearena_get(pmr.arena, stmt.b);
        var tStart = stmt.b;
        var tEnd = stmt.b + 1;
        if (thenNode.kind == NODE_BLOCK) {
          tStart = thenNode.a;
          tEnd = thenNode.a + thenNode.b;
        }
        var thenLn = ln;
        var thenLp = lp;
        var thenLt = lt;
        var thenRes = cg_emit_stmt_range(pmr, tm, paramNames, paramTypes, paramSlots, paramSlotTypes, thenLn, thenLp, thenLt, retTy, breakLabel, continueLabel, tStart, tEnd, tmp);
        sb = sb_append_string(sb, thenRes.text);
        if (thenRes.err == 1) { return StmtEmitResult{sb_to_string(sb), emittedRet, ln, lp, lt, term, 1}; }
        if (thenRes.ret == 0) {
          sb = sb_append_cstr(sb, byte~(&"  br label %"[0]));
          sb = sb_append_string(sb, lend);
          sb = sb_append_byte(sb, byte(10));
        } else {
          thenRet = 1;
        }
      } else {
        sb = sb_append_cstr(sb, byte~(&"  br label %"[0]));
        sb = sb_append_string(sb, lend);
        sb = sb_append_byte(sb, byte(10));
      }

      // else block
      sb = sb_append_string(sb, lelse);
      sb = sb_append_byte(sb, byte(58));
      sb = sb_append_byte(sb, byte(10));
      var elseRet = 0;
      if (stmt.c != -1) {
        var elseNode = nodearena_get(pmr.arena, stmt.c);
        var eStart = stmt.c;
        var eEnd = stmt.c + 1;
        if (elseNode.kind == NODE_BLOCK) {
          eStart = elseNode.a;
          eEnd = elseNode.a + elseNode.b;
        }
        var elseLn = ln;
        var elseLp = lp;
        var elseLt = lt;
        var elseRes = cg_emit_stmt_range(pmr, tm, paramNames, paramTypes, paramSlots, paramSlotTypes, elseLn, elseLp, elseLt, retTy, breakLabel, continueLabel, eStart, eEnd, tmp);
        sb = sb_append_string(sb, elseRes.text);
        if (elseRes.err == 1) { return StmtEmitResult{sb_to_string(sb), emittedRet, ln, lp, lt, term, 1}; }
        if (elseRes.ret == 0) {
          sb = sb_append_cstr(sb, byte~(&"  br label %"[0]));
          sb = sb_append_string(sb, lend);
          sb = sb_append_byte(sb, byte(10));
        } else {
          elseRet = 1;
        }
      } else {
        sb = sb_append_cstr(sb, byte~(&"  br label %"[0]));
        sb = sb_append_string(sb, lend);
        sb = sb_append_byte(sb, byte(10));
      }

      sb = sb_append_string(sb, lend);
      sb = sb_append_byte(sb, byte(58));
      sb = sb_append_byte(sb, byte(10));
      if (stmt.c != -1 && thenRet == 1 && elseRet == 1) {
        emittedRet = 1;
      }
    } else if (stmt.kind == NODE_WHILE) {
      var lcond = cg_fresh_label(tmp);
      var lbody = cg_fresh_label(tmp);
      var lendw = cg_fresh_label(tmp);
      // jump to cond
      sb = sb_append_cstr(sb, byte~(&"  br label %"[0]));
      sb = sb_append_string(sb, lcond);
      sb = sb_append_byte(sb, byte(10));
      // cond block
      sb = sb_append_string(sb, lcond);
      sb = sb_append_byte(sb, byte(58));
      sb = sb_append_byte(sb, byte(10));
      var condResW = cg_expr(pmr, tm, stmt.a, paramNames, paramTypes, paramSlots, paramSlotTypes, ln, lp, lt, tmp);
      if (condResW.err == 1) { return StmtEmitResult{sb_to_string(sb), emittedRet, ln, lp, lt, term, 1}; }
      var condBoolW = cg_to_bool(condResW, tmp);
      if (condBoolW.err == 1) { return StmtEmitResult{sb_to_string(sb), emittedRet, ln, lp, lt, term, 1}; }
      sb = sb_append_string(sb, condBoolW.instr);
      sb = sb_append_cstr(sb, byte~(&"  br i1 "[0]));
      sb = sb_append_string(sb, condBoolW.value);
      sb = sb_append_cstr(sb, byte~(&", label %"[0]));
      sb = sb_append_string(sb, lbody);
      sb = sb_append_cstr(sb, byte~(&", label %"[0]));
      sb = sb_append_string(sb, lendw);
      sb = sb_append_byte(sb, byte(10));
      // body block
      sb = sb_append_string(sb, lbody);
      sb = sb_append_byte(sb, byte(58));
      sb = sb_append_byte(sb, byte(10));
      if (stmt.b != -1) {
        var bodyNode = nodearena_get(pmr.arena, stmt.b);
        var bStart = stmt.b;
        var bEnd = stmt.b + 1;
        if (bodyNode.kind == NODE_BLOCK) {
          bStart = bodyNode.a;
          bEnd = bodyNode.a + bodyNode.b;
        }
        var bodyRes = cg_emit_stmt_range(pmr, tm, paramNames, paramTypes, paramSlots, paramSlotTypes, ln, lp, lt, retTy, lendw, lcond, bStart, bEnd, tmp);
        sb = sb_append_string(sb, bodyRes.text);
        if (bodyRes.err == 1) { return StmtEmitResult{sb_to_string(sb), emittedRet, ln, lp, lt, term, 1}; }
        if (bodyRes.ret == 0 && bodyRes.term == 0) {
          sb = sb_append_cstr(sb, byte~(&"  br label %"[0]));
          sb = sb_append_string(sb, lcond);
          sb = sb_append_byte(sb, byte(10));
        } else {
          if (bodyRes.ret == 1) { emittedRet = 1; }
          term = term | bodyRes.term;
        }
      } else {
        sb = sb_append_cstr(sb, byte~(&"  br label %"[0]));
        sb = sb_append_string(sb, lcond);
        sb = sb_append_byte(sb, byte(10));
      }
      // end label
      sb = sb_append_string(sb, lendw);
      sb = sb_append_byte(sb, byte(58));
      sb = sb_append_byte(sb, byte(10));
    } else if (stmt.kind == NODE_FOR) {
      // for(init; cond; step) body
      // (init currently ignored if present; semantics covered by preceding statements)
      var lcondf = cg_fresh_label(tmp);
      var lbodyf = cg_fresh_label(tmp);
      var lstepf = cg_fresh_label(tmp);
      var lendf = cg_fresh_label(tmp);
      sb = sb_append_cstr(sb, byte~(&"  br label %"[0]));
      sb = sb_append_string(sb, lcondf);
      sb = sb_append_byte(sb, byte(10));
      // cond block
      sb = sb_append_string(sb, lcondf);
      sb = sb_append_byte(sb, byte(58));
      sb = sb_append_byte(sb, byte(10));
      if (stmt.b != -1) {
        var condResF = cg_expr(pmr, tm, stmt.b, paramNames, paramTypes, paramSlots, paramSlotTypes, ln, lp, lt, tmp);
        if (condResF.err == 1) { return StmtEmitResult{sb_to_string(sb), emittedRet, ln, lp, lt, term, 1}; }
        var condBoolF = cg_to_bool(condResF, tmp);
        if (condBoolF.err == 1) { return StmtEmitResult{sb_to_string(sb), emittedRet, ln, lp, lt, term, 1}; }
        sb = sb_append_string(sb, condBoolF.instr);
        sb = sb_append_cstr(sb, byte~(&"  br i1 "[0]));
        sb = sb_append_string(sb, condBoolF.value);
        sb = sb_append_cstr(sb, byte~(&", label %"[0]));
        sb = sb_append_string(sb, lbodyf);
        sb = sb_append_cstr(sb, byte~(&", label %"[0]));
        sb = sb_append_string(sb, lendf);
        sb = sb_append_byte(sb, byte(10));
      } else {
        sb = sb_append_cstr(sb, byte~(&"  br label %"[0]));
        sb = sb_append_string(sb, lbodyf);
        sb = sb_append_byte(sb, byte(10));
      }
      // body block
      sb = sb_append_string(sb, lbodyf);
      sb = sb_append_byte(sb, byte(58));
      sb = sb_append_byte(sb, byte(10));
      if (stmt.d != -1) {
        var bodyNodeF = nodearena_get(pmr.arena, stmt.d);
        var bfStart = stmt.d;
        var bfEnd = stmt.d + 1;
        if (bodyNodeF.kind == NODE_BLOCK) {
          bfStart = bodyNodeF.a;
          bfEnd = bodyNodeF.a + bodyNodeF.b;
        }
        var bodyResF = cg_emit_stmt_range(pmr, tm, paramNames, paramTypes, paramSlots, paramSlotTypes, ln, lp, lt, retTy, lendf, lstepf, bfStart, bfEnd, tmp);
        sb = sb_append_string(sb, bodyResF.text);
        if (bodyResF.err == 1) { return StmtEmitResult{sb_to_string(sb), emittedRet, ln, lp, lt, term, 1}; }
        if (bodyResF.ret == 0 && bodyResF.term == 0) {
          sb = sb_append_cstr(sb, byte~(&"  br label %"[0]));
          sb = sb_append_string(sb, lstepf);
          sb = sb_append_byte(sb, byte(10));
        } else {
          if (bodyResF.ret == 1) { emittedRet = 1; }
          term = term | bodyResF.term;
        }
      } else {
        sb = sb_append_cstr(sb, byte~(&"  br label %"[0]));
        sb = sb_append_string(sb, lstepf);
        sb = sb_append_byte(sb, byte(10));
      }
      // step block
      sb = sb_append_string(sb, lstepf);
      sb = sb_append_byte(sb, byte(58));
      sb = sb_append_byte(sb, byte(10));
      if (stmt.c != -1) {
        var stepResF = cg_expr(pmr, tm, stmt.c, paramNames, paramTypes, paramSlots, paramSlotTypes, ln, lp, lt, tmp);
        if (stepResF.err == 1) { return StmtEmitResult{sb_to_string(sb), emittedRet, ln, lp, lt, term, 1}; }
        sb = sb_append_string(sb, stepResF.instr);
      }
      sb = sb_append_cstr(sb, byte~(&"  br label %"[0]));
      sb = sb_append_string(sb, lcondf);
      sb = sb_append_byte(sb, byte(10));
      // end
      sb = sb_append_string(sb, lendf);
      sb = sb_append_byte(sb, byte(58));
      sb = sb_append_byte(sb, byte(10));
    } else if (stmt.kind == NODE_BREAK) {
      if (breakLabel.length == 0) { return StmtEmitResult{sb_to_string(sb), emittedRet, ln, lp, lt, term, 1}; }
      sb = sb_append_cstr(sb, byte~(&"  br label %"[0]));
      sb = sb_append_string(sb, breakLabel);
      sb = sb_append_byte(sb, byte(10));
      term = 1;
      break;
    } else if (stmt.kind == NODE_CONTINUE) {
      if (continueLabel.length == 0) { return StmtEmitResult{sb_to_string(sb), emittedRet, ln, lp, lt, term, 1}; }
      sb = sb_append_cstr(sb, byte~(&"  br label %"[0]));
      sb = sb_append_string(sb, continueLabel);
      sb = sb_append_byte(sb, byte(10));
      term = 1;
      break;
    } else {
      // Unsupported stmt kinds for now.
    }
    i = i + 1;
  }
  return StmtEmitResult{sb_to_string(sb), emittedRet, ln, lp, lt, term, 0};
}

// Generate LLVM IR for a single function node.
// Supports bodies with return statements containing simple expressions.
def cg_function(pmr ParseModuleResult, tm TypeModuleTypes, fn Node, fi int) FnCodegenResult {
  var retId = tm_fn_return_type(tm, fi);
  var retTy = cg_llvm_type(tm.env.tt, retId);
  var name = tok_string(pmr.tokens, fn.c, pmr.src);

  var paramNames = cg_collect_param_names(pmr, fn);
  var paramTypes = vecstr_new(4);
  var paramStartT = tm_fn_param_type_start(tm, fi);
  var paramCountT = tm_fn_param_count(tm, fi);
  var pti = 0;
  while (pti < paramCountT) {
    var pidT = vecint_get(tm.paramTypeIds, paramStartT + pti);
    var ptyT = cg_llvm_type(tm.env.tt, pidT);
    paramTypes = vecstr_push(paramTypes, ptyT);
    pti = pti + 1;
  }
  var tmp int = 0;

  var sb = sb_new();
  // Function header
  sb = sb_append_cstr(sb, byte~(&"define "[0]));
  sb = sb_append_string(sb, retTy);
  sb = sb_append_byte(sb, byte(32)); // space
  sb = sb_append_byte(sb, byte(64)); // '@'
  sb = sb_append_string(sb, name);
  sb = sb_append_byte(sb, byte(40)); // '('

  var paramStart = tm_fn_param_type_start(tm, fi);
  var paramCount = tm_fn_param_count(tm, fi);
  var pi = 0;
  while (pi < paramCount) {
    var pid = vecint_get(tm.paramTypeIds, paramStart + pi);
    var pty = cg_llvm_type(tm.env.tt, pid);
    if (pi > 0) { sb = sb_append_cstr(sb, byte~(&", "[0])); }
    sb = sb_append_string(sb, pty);
    // Name parameters as %pN
    sb = sb_append_byte(sb, byte(32));
    sb = sb_append_byte(sb, byte(37)); // '%'
    sb = sb_append_cstr(sb, byte~(&"p"[0]));
    sb = sb_append_int(sb, pi);
    pi = pi + 1;
  }
  sb = sb_append_byte(sb, byte(41)); // ')'
  sb = sb_append_byte(sb, byte(32));
  sb = sb_append_byte(sb, byte(123)); // '{'
  sb = sb_append_byte(sb, byte(10));
  sb = sb_append_cstr(sb, byte~(&"entry:"[0]));
  sb = sb_append_byte(sb, byte(10));

  // Imported functions: emit a minimal body returning zero/void.
  if (fn.typeId == 1 || fn.a == -1) {
    if (retTy.length == 4 && (retTy.data)~ == byte(118)) { // "void"
      sb = sb_append_cstr(sb, byte~(&"  ret void"[0]));
    } else {
      sb = sb_append_cstr(sb, byte~(&"  ret "[0]));
      sb = sb_append_string(sb, retTy);
      sb = sb_append_byte(sb, byte(32));
      sb = sb_append_byte(sb, byte(48)); // '0'
    }
    sb = sb_append_byte(sb, byte(10));
    sb = sb_append_byte(sb, byte(125));
    sb = sb_append_byte(sb, byte(10));
    return FnCodegenResult{sb_to_string(sb), 0};
  }

  // Prepare param slots and locals
  var paramSlots = vecstr_new(4);
  var paramSlotTypes = vecstr_new(4);
  var localNames = vecstr_new(4);
  var localPtrs = vecstr_new(4);
  var localTypes = vecstr_new(4);
  var allocas = sb_new();
  var psi = 0;
  while (psi < paramCount) {
    var pid = vecint_get(tm.paramTypeIds, paramStart + psi);
    var pty = cg_llvm_type(tm.env.tt, pid);
    var slot = cg_fresh_tmp(&tmp);
    allocas = sb_append_cstr(allocas, byte~(&"  "[0]));
    allocas = sb_append_string(allocas, slot);
    allocas = sb_append_cstr(allocas, byte~(&" = alloca "[0]));
    allocas = sb_append_string(allocas, pty);
    allocas = sb_append_byte(allocas, byte(10));
    allocas = sb_append_cstr(allocas, byte~(&"  store "[0]));
    allocas = sb_append_string(allocas, pty);
    allocas = sb_append_cstr(allocas, byte~(&" %"[0]));
    allocas = sb_append_cstr(allocas, byte~(&"p"[0]));
    allocas = sb_append_int(allocas, psi);
    allocas = sb_append_cstr(allocas, byte~(&", "[0]));
    allocas = sb_append_string(allocas, pty);
    allocas = sb_append_cstr(allocas, byte~(&"* "[0]));
    allocas = sb_append_string(allocas, slot);
    allocas = sb_append_byte(allocas, byte(10));
    paramSlots = vecstr_push(paramSlots, slot);
    paramSlotTypes = vecstr_push(paramSlotTypes, pty);
    psi = psi + 1;
  }

  var sbBody = sb_new();
  sbBody = sb_append_string(sbBody, sb_to_string(allocas));

  // Body: expect a block node at fn.a
  var body = nodearena_get(pmr.arena, fn.a);
  var empty = String{pmr.src, 0};
  var bodyRes = cg_emit_stmt_range(pmr, tm, paramNames, paramTypes, paramSlots, paramSlotTypes, localNames, localPtrs, localTypes, retTy, empty, empty, body.a, body.a + body.b, &tmp);
  if (bodyRes.err == 1) { return FnCodegenResult{sb_to_string(sb), 1}; }
  sbBody = sb_append_string(sbBody, bodyRes.text);
  if (bodyRes.ret == 0) {
    if (retTy.length == 4 && (retTy.data)~ == byte(118)) {
      sbBody = sb_append_cstr(sbBody, byte~(&"  ret void"[0]));
    } else {
      sbBody = sb_append_cstr(sbBody, byte~(&"  ret "[0]));
      sbBody = sb_append_string(sbBody, retTy);
      sbBody = sb_append_byte(sbBody, byte(32));
      sbBody = sb_append_byte(sbBody, byte(48)); // '0'
    }
    sbBody = sb_append_byte(sbBody, byte(10));
  }

  sb = sb_append_string(sb, sb_to_string(sbBody));
  sb = sb_append_byte(sb, byte(125)); // '}'
  sb = sb_append_byte(sb, byte(10));
  return FnCodegenResult{sb_to_string(sb), 0};
}

// Emit declarations for imported functions.
def cg_function_decl(pmr ParseModuleResult, tm TypeModuleTypes, fn Node, fi int) FnCodegenResult {
  var retId = tm_fn_return_type(tm, fi);
  var retTy = cg_llvm_type(tm.env.tt, retId);
  var name = tok_string(pmr.tokens, fn.c, pmr.src);
  var sb = sb_new();
  sb = sb_append_cstr(sb, byte~(&"declare "[0]));
  sb = sb_append_string(sb, retTy);
  sb = sb_append_byte(sb, byte(32));
  sb = sb_append_byte(sb, byte(64));
  sb = sb_append_string(sb, name);
  sb = sb_append_byte(sb, byte(40)); // '('
  var paramStart = tm_fn_param_type_start(tm, fi);
  var paramCount = tm_fn_param_count(tm, fi);
  var pi = 0;
  while (pi < paramCount) {
    var pid = vecint_get(tm.paramTypeIds, paramStart + pi);
    var pty = cg_llvm_type(tm.env.tt, pid);
    if (pi > 0) { sb = sb_append_cstr(sb, byte~(&", "[0])); }
    sb = sb_append_string(sb, pty);
    pi = pi + 1;
  }
  sb = sb_append_byte(sb, byte(41)); // ')'
  sb = sb_append_byte(sb, byte(10));
  return FnCodegenResult{sb_to_string(sb), 0};
}

// Module-level codegen entry.
def codegen_module(pmr ParseModuleResult, tm TypeModuleTypes) String {
  var sb = sb_new();

  // Emit string literal constants.
  var si = 0;
  while (si < pmr.tokens.length) {
    var tkSi = token_kind_at(pmr.tokens, si);
    if (tkSi == TOKEN_STRING) {
      var nameStr2 = cg_string_name(si);
      var tlen2 = token_length_at(pmr.tokens, si);
      var clen2 = tlen2 - 2;
      sb = sb_append_byte(sb, byte(64)); // '@'
      sb = sb_append_string(sb, nameStr2);
      sb = sb_append_cstr(sb, byte~(&" = private unnamed_addr constant ["[0]));
      sb = sb_append_int(sb, clen2 + 1);
      sb = sb_append_cstr(sb, byte~(&" x i8] [ "[0]));
      var start2 = token_start_at(pmr.tokens, si) + 1;
      var idx2 = 0;
      while (idx2 < clen2) {
        if (idx2 > 0) { sb = sb_append_cstr(sb, byte~(&", "[0])); }
        var ch2 = (pmr.src + start2 + idx2)~;
        sb = sb_append_cstr(sb, byte~(&"i8 "[0]));
        sb = sb_append_int(sb, int(ch2));
        idx2 = idx2 + 1;
      }
      if (clen2 > 0) { sb = sb_append_cstr(sb, byte~(&", "[0])); }
      sb = sb_append_cstr(sb, byte~(&"i8 0 ]"[0]));
      sb = sb_append_byte(sb, byte(10));
    }
    si = si + 1;
  }

  // Emit globals with literal initializers (ints/bools/bytes/strings).
  var gi = 0;
  while (gi < pmr.meta.varNodeIndex.length) {
    var gvIdx = vecint_get(pmr.meta.varNodeIndex, gi);
    var gvNode = nodearena_get(pmr.arena, gvIdx);
    var gname = tok_string(pmr.tokens, gvNode.a, pmr.src);
    var initTok = -1;
    if (gvNode.b != -1) {
      var initNode = nodearena_get(pmr.arena, gvNode.b);
      if (initNode.kind == NODE_LITERAL) { initTok = initNode.a; }
    }
    var gtid = vecint_get(tm.varTypeIds, gi);
    if (gtid == -1 && initTok != -1) {
      var tk0 = token_kind_at(pmr.tokens, initTok);
      if (tk0 == TOKEN_TRUE || tk0 == TOKEN_FALSE) { gtid = 1; }
      else if (tk0 == TOKEN_NUMBER) { gtid = 5; }
      else if (tk0 == TOKEN_SINGLE_QUOTE_STRING) { gtid = 2; }
      else if (tk0 == TOKEN_STRING) { gtid = 6; } // pointer to byte
    }
    var gty = cg_llvm_type(tm.env.tt, gtid);
    if (gtid == -1) { gty = String{byte~(&"i32"[0]), 3}; }
    var initStr = String{byte~(&"0"[0]), 1};
    if (initTok != -1) {
      var tk = token_kind_at(pmr.tokens, initTok);
      if (tk == TOKEN_NUMBER) {
        initStr = tok_string(pmr.tokens, initTok, pmr.src);
      } else if (tk == TOKEN_TRUE) {
        initStr = String{byte~(&"1"[0]), 1};
      } else if (tk == TOKEN_FALSE) {
        initStr = String{byte~(&"0"[0]), 1};
      } else if (tk == TOKEN_SINGLE_QUOTE_STRING) {
        var tlen = token_length_at(pmr.tokens, initTok);
        if (tlen >= 3) {
          var start = token_start_at(pmr.tokens, initTok);
          var ch = (pmr.src + start + 1)~;
          var sbCh = sb_new();
          sbCh = sb_append_int(sbCh, int(ch));
          initStr = sb_to_string(sbCh);
        }
      } else if (tk == TOKEN_STRING) {
        var nameStrG = cg_string_name(initTok);
        var tlenG = token_length_at(pmr.tokens, initTok);
        var clenG = tlenG - 2;
        var sbInit = sb_new();
        sbInit = sb_append_cstr(sbInit, byte~(&"getelementptr inbounds "[0]));
        sbInit = sb_append_byte(sbInit, byte(91)); // '['
        sbInit = sb_append_int(sbInit, clenG + 1);
        sbInit = sb_append_cstr(sbInit, byte~(&" x i8]"[0]));
        sbInit = sb_append_cstr(sbInit, byte~(&", "[0]));
        sbInit = sb_append_byte(sbInit, byte(91)); // '['
        sbInit = sb_append_int(sbInit, clenG + 1);
        sbInit = sb_append_cstr(sbInit, byte~(&" x i8]* "[0]));
        sbInit = sb_append_byte(sbInit, byte(64)); // '@'
        sbInit = sb_append_string(sbInit, nameStrG);
        sbInit = sb_append_cstr(sbInit, byte~(&", i32 0, i32 0"[0]));
        initStr = sb_to_string(sbInit);
        gty = String{byte~(&"i8*"[0]), 3};
      }
    }
    sb = sb_append_byte(sb, byte(64)); // '@'
    sb = sb_append_string(sb, gname);
    sb = sb_append_cstr(sb, byte~(&" = global "[0]));
    sb = sb_append_string(sb, gty);
    sb = sb_append_byte(sb, byte(32));
    sb = sb_append_string(sb, initStr);
    sb = sb_append_byte(sb, byte(10));
    gi = gi + 1;
  }

  // Emit imported function declarations first.
  var fi = 0;
  while (fi < pmr.meta.fnNodeIndex.length) {
    var fnIdx = vecint_get(pmr.meta.fnNodeIndex, fi);
    var fn = nodearena_get(pmr.arena, fnIdx);
    if (fn.typeId == 1 || fn.a == -1) {
      var decl = cg_function_decl(pmr, tm, fn, fi);
      if (decl.err == 1) { return String{pmr.src, 0}; }
      sb = sb_append_string(sb, decl.text);
    }
    fi = fi + 1;
  }

  // Emit definitions.
  fi = 0;
  while (fi < pmr.meta.fnNodeIndex.length) {
    var fnIdx2 = vecint_get(pmr.meta.fnNodeIndex, fi);
    var fn2 = nodearena_get(pmr.arena, fnIdx2);
    if (fn2.typeId == 1 || fn2.a == -1) {
      fi = fi + 1;
      continue;
    }
    var fnDef = cg_function(pmr, tm, fn2, fi);
    if (fnDef.err == 1) { return String{pmr.src, 0}; }
    sb = sb_append_string(sb, fnDef.text);
    fi = fi + 1;
  }

  return sb_to_string(sb);
}

// Legacy stub preserved for compatibility with existing call sites.
def codegen_simple(ok int) int {
  if (ok == 1) { return 1; }
  return 0;
}
