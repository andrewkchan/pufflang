// Stage1 Puffscript LLVM IR codegen (initial, minimal subset).
// Generates textual LLVM IR for:
// - function definitions (non-import) with simple return statements
// - return expressions composed of literals, groups, and unary minus
// - integer/byte/bool/void/float return types (float is mapped to 'float')
//
// Structured to expand over time with more statement/expression support.

struct FnCodegenResult { text String, err int }
struct ExprCodegenResult { instr String, value String, valTy String, err int }

// Map a type id from TypeTable to LLVM IR textual type.
def cg_llvm_type(tt TypeTable, typeId int) String {
  var t = typetable_get(tt, typeId);
  if (t.category == TYPECATEGORY_INT) { return String{byte~(&"i32"[0]), 3}; }
  if (t.category == TYPECATEGORY_BYTE) { return String{byte~(&"i8"[0]), 2}; }
  if (t.category == TYPECATEGORY_BOOL) { return String{byte~(&"i1"[0]), 2}; }
  if (t.category == TYPECATEGORY_VOID) { return String{byte~(&"void"[0]), 4}; }
  if (t.category == TYPECATEGORY_FLOAT) { return String{byte~(&"float"[0]), 5}; }
  if (t.category == TYPECATEGORY_POINTER) { return String{byte~(&"i8*"[0]), 3}; }
  // Fallback to i32 for unknown/unsupported types.
  return String{byte~(&"i32"[0]), 3};
}

// Render a token's lexeme to string.
def cg_tok_string(tokens Vec, src byte~, tokIdx int) String {
  return tok_string(tokens, tokIdx, src);
}

// String equality helper for small LLVM type names.
def cg_str_eq(a String, b String) int {
  if (a.length != b.length) { return 0; }
  var i = 0;
  while (i < a.length) {
    if ((a.data + i)~ != (b.data + i)~) { return 0; }
    i = i + 1;
  }
  return 1;
}

// Does string end with '*' (pointer type)?
def cg_is_pointer_type(ty String) int {
  if (ty.length < 2) { return 0; }
  if ((ty.data + ty.length - 1)~ == byte(42)) { return 1; }
  return 0;
}

// Remove trailing '*' from type string; returns empty on invalid.
def cg_pointer_elem_ty(ptrTy String) String {
  if (cg_is_pointer_type(ptrTy) == 0) { return String{ptrTy.data, 0}; }
  var sb = sb_new();
  var i = 0;
  while (i < ptrTy.length - 1) {
    sb = sb_append_byte(sb, (ptrTy.data + i)~);
    i = i + 1;
  }
  return sb_to_string(sb);
}

// Ensure an expression is i32; zext from i1/i8.
def cg_to_i32(res ExprCodegenResult, tmp int~) ExprCodegenResult {
  if (res.err == 1) { return res; }
  if (res.valTy.length == 3 && (res.valTy.data)~ == byte(105) && (res.valTy.data + 1)~ == byte(51)) { return res; }
  if (res.valTy.length == 2 && (res.valTy.data)~ == byte(105) && (res.valTy.data + 1)~ == byte(49)) {
    var tmpName = cg_fresh_tmp(tmp);
    var sb = sb_new();
    sb = sb_append_string(sb, res.instr);
    sb = sb_append_cstr(sb, byte~(&"  "[0]));
    sb = sb_append_string(sb, tmpName);
    sb = sb_append_cstr(sb, byte~(&" = zext i1 "[0]));
    sb = sb_append_string(sb, res.value);
    sb = sb_append_cstr(sb, byte~(&" to i32"[0]));
    sb = sb_append_byte(sb, byte(10));
    return ExprCodegenResult{sb_to_string(sb), tmpName, String{byte~(&"i32"[0]), 3}, 0};
  }
  if (res.valTy.length == 2 && (res.valTy.data)~ == byte(105) && (res.valTy.data + 1)~ == byte(56)) { // i8
    var tmpName2 = cg_fresh_tmp(tmp);
    var sb2 = sb_new();
    sb2 = sb_append_string(sb2, res.instr);
    sb2 = sb_append_cstr(sb2, byte~(&"  "[0]));
    sb2 = sb_append_string(sb2, tmpName2);
    sb2 = sb_append_cstr(sb2, byte~(&" = zext i8 "[0]));
    sb2 = sb_append_string(sb2, res.value);
    sb2 = sb_append_cstr(sb2, byte~(&" to i32"[0]));
    sb2 = sb_append_byte(sb2, byte(10));
    return ExprCodegenResult{sb_to_string(sb2), tmpName2, String{byte~(&"i32"[0]), 3}, 0};
  }
  return res;
}

// Convert an expression result to i1 (non-short-circuit); appends icmp if needed.
def cg_to_bool(res ExprCodegenResult, tmp int~) ExprCodegenResult {
  if (res.err == 1) { return res; }
  if (res.valTy.length == 2 && (res.valTy.data)~ == byte(105) && (res.valTy.data + 1)~ == byte(49)) {
    return res;
  }
  var ty = res.valTy;
  if (ty.length == 0) { ty = String{byte~(&"i32"[0]), 3}; }
  var zero = String{byte~(&"0"[0]), 1};
  var tmpName = cg_fresh_tmp(tmp);
  var sb = sb_new();
  sb = sb_append_string(sb, res.instr);
  sb = sb_append_cstr(sb, byte~(&"  "[0]));
  sb = sb_append_string(sb, tmpName);
  sb = sb_append_cstr(sb, byte~(&" = icmp ne "[0]));
  sb = sb_append_string(sb, ty);
  sb = sb_append_byte(sb, byte(32));
  sb = sb_append_string(sb, res.value);
  sb = sb_append_cstr(sb, byte~(&", "[0]));
  sb = sb_append_string(sb, zero);
  sb = sb_append_byte(sb, byte(10));
  return ExprCodegenResult{sb_to_string(sb), tmpName, String{byte~(&"i1"[0]), 2}, 0};
}

// Coerce a value to a target LLVM type (limited to int widening/trunc).
def cg_coerce(val ExprCodegenResult, targetTy String, tmp int~) ExprCodegenResult {
  if (val.err == 1) { return val; }
  if (cg_str_eq(val.valTy, targetTy) == 1) { return val; }
  // widen i1/i8 -> i32
  if (targetTy.length == 3 && (targetTy.data)~ == byte(105) && (targetTy.data + 1)~ == byte(51)) {
    if (val.valTy.length == 2 && (val.valTy.data)~ == byte(105) && (val.valTy.data + 1)~ == byte(49)) {
      var tmpZ = cg_fresh_tmp(tmp);
      var sb = sb_new();
      sb = sb_append_string(sb, val.instr);
      sb = sb_append_cstr(sb, byte~(&"  "[0]));
      sb = sb_append_string(sb, tmpZ);
      sb = sb_append_cstr(sb, byte~(&" = zext i1 "[0]));
      sb = sb_append_string(sb, val.value);
      sb = sb_append_cstr(sb, byte~(&" to i32"[0]));
      sb = sb_append_byte(sb, byte(10));
      return ExprCodegenResult{sb_to_string(sb), tmpZ, targetTy, 0};
    }
    if (val.valTy.length == 2 && (val.valTy.data)~ == byte(105) && (val.valTy.data + 1)~ == byte(56)) {
      var tmpZ2 = cg_fresh_tmp(tmp);
      var sb2 = sb_new();
      sb2 = sb_append_string(sb2, val.instr);
      sb2 = sb_append_cstr(sb2, byte~(&"  "[0]));
      sb2 = sb_append_string(sb2, tmpZ2);
      sb2 = sb_append_cstr(sb2, byte~(&" = zext i8 "[0]));
      sb2 = sb_append_string(sb2, val.value);
      sb2 = sb_append_cstr(sb2, byte~(&" to i32"[0]));
      sb2 = sb_append_byte(sb2, byte(10));
      return ExprCodegenResult{sb_to_string(sb2), tmpZ2, targetTy, 0};
    }
  }
  // truncate i32 -> i8/i1
  if (val.valTy.length == 3 && (val.valTy.data)~ == byte(105) && (val.valTy.data + 1)~ == byte(51)) {
    if (targetTy.length == 2 && (targetTy.data)~ == byte(105) && (targetTy.data + 1)~ == byte(56)) {
      var tmpT = cg_fresh_tmp(tmp);
      var sbt = sb_new();
      sbt = sb_append_string(sbt, val.instr);
      sbt = sb_append_cstr(sbt, byte~(&"  "[0]));
      sbt = sb_append_string(sbt, tmpT);
      sbt = sb_append_cstr(sbt, byte~(&" = trunc i32 "[0]));
      sbt = sb_append_string(sbt, val.value);
      sbt = sb_append_cstr(sbt, byte~(&" to i8"[0]));
      sbt = sb_append_byte(sbt, byte(10));
      return ExprCodegenResult{sb_to_string(sbt), tmpT, targetTy, 0};
    }
    if (targetTy.length == 2 && (targetTy.data)~ == byte(105) && (targetTy.data + 1)~ == byte(49)) {
      var tmpTb = cg_fresh_tmp(tmp);
      var sbtb = sb_new();
      sbtb = sb_append_string(sbtb, val.instr);
      sbtb = sb_append_cstr(sbtb, byte~(&"  "[0]));
      sbtb = sb_append_string(sbtb, tmpTb);
      sbtb = sb_append_cstr(sbtb, byte~(&" = trunc i32 "[0]));
      sbtb = sb_append_string(sbtb, val.value);
      sbtb = sb_append_cstr(sbtb, byte~(&" to i1"[0]));
      sbtb = sb_append_byte(sbtb, byte(10));
      return ExprCodegenResult{sb_to_string(sbtb), tmpTb, targetTy, 0};
    }
  }
  return ExprCodegenResult{val.instr, val.value, val.valTy, 1};
}

// Store a value into a slot of given element type.
def cg_store(ptr String, elemTy String, val ExprCodegenResult, tmp int~) ExprCodegenResult {
  var et = elemTy;
  if (et.length == 0) {
    if (val.valTy.length > 0) { et = val.valTy; }
    else { et = String{byte~(&"i32"[0]), 3}; }
  }
  var coerced = cg_coerce(val, elemTy, tmp);
  if (coerced.err == 1) { return coerced; }
  var sb = sb_new();
  sb = sb_append_string(sb, coerced.instr);
  sb = sb_append_cstr(sb, byte~(&"  store "[0]));
  sb = sb_append_string(sb, et);
  sb = sb_append_byte(sb, byte(32));
  sb = sb_append_string(sb, coerced.value);
  sb = sb_append_cstr(sb, byte~(&", "[0]));
  sb = sb_append_string(sb, et);
  sb = sb_append_cstr(sb, byte~(&"* "[0]));
  sb = sb_append_string(sb, ptr);
  sb = sb_append_byte(sb, byte(10));
  return ExprCodegenResult{sb_to_string(sb), coerced.value, et, 0};
}

// Collect parameter names from function tokens (best-effort).
def cg_collect_param_names(pmr ParseModuleResult, fn Node) VecStr {
  var names = vecstr_new(4);
  var idx = fn.b;
  var collected = 0;
  while (idx < pmr.tokens.length && collected < fn.d) {
    var k = token_kind_at(pmr.tokens, idx);
    if (k == TOKEN_IDENTIFIER) {
      var s = tok_string(pmr.tokens, idx, pmr.src);
      names = vecstr_push(names, s);
      collected = collected + 1;
    }
    if (k == TOKEN_RIGHT_PAREN) { break; }
    idx = idx + 1;
  }
  return names;
}

def cg_match_param(params VecStr, name String) int {
  var i = 0;
  while (i < params.length) {
    var p = vecstr_get(params, i);
    if (str_eq(p.data, p.length, name.data, name.length) == 1) { return i; }
    i = i + 1;
  }
  return -1;
}

def cg_fresh_tmp(counter int~) String {
  var sb = sb_new();
  sb = sb_append_byte(sb, byte(37)); // '%'
  sb = sb_append_cstr(sb, byte~(&"t"[0]));
  sb = sb_append_int(sb, counter~);
  counter~ = counter~ + 1;
  return sb_to_string(sb);
}

// Find function index in tm by name (first match).
def cg_find_fn_index(pmr ParseModuleResult, tm TypeModuleTypes, name String) int {
  var i = 0;
  while (i < pmr.meta.fnNodeIndex.length) {
    var fnIdx = vecint_get(pmr.meta.fnNodeIndex, i);
    var fnNode = nodearena_get(pmr.arena, fnIdx);
    var fnName = tok_string(pmr.tokens, fnNode.c, pmr.src);
    if (str_eq(fnName.data, fnName.length, name.data, name.length) == 1) { return i; }
    i = i + 1;
  }
  return -1;
}

// Helper to find a name in VecStr (returns index or -1).
def cg_find_name(v VecStr, name String) int {
  var i = 0;
  while (i < v.length) {
    var n = vecstr_get(v, i);
    if (str_eq(n.data, n.length, name.data, name.length) == 1) { return i; }
    i = i + 1;
  }
  return -1;
}

// Emit simple expressions (literal, group, unary, variable, binary, call).
// Returns accumulated instructions (in order) and the SSA value to use.
def cg_expr(
  pmr ParseModuleResult,
  tm TypeModuleTypes,
  exprIdx int,
  paramNames VecStr,
  paramTypes VecStr,
  paramSlots VecStr,
  paramSlotTypes VecStr,
  localNames VecStr,
  localPtrs VecStr,
  localTypes VecStr,
  tmp int~
) ExprCodegenResult {
  if (exprIdx < 0 || exprIdx >= pmr.arena.nodes.length) { return ExprCodegenResult{String{pmr.src, 0}, String{pmr.src, 0}, String{pmr.src, 0}, 1}; }
  var n = nodearena_get(pmr.arena, exprIdx);
  if (n.kind == NODE_LITERAL) {
    var lex = cg_tok_string(pmr.tokens, pmr.src, n.a);
    var tk = token_kind_at(pmr.tokens, n.a);
    if (tk == TOKEN_TRUE) { return ExprCodegenResult{String{pmr.src, 0}, String{byte~(&"1"[0]), 1}, String{byte~(&"i1"[0]), 2}, 0}; }
    if (tk == TOKEN_FALSE) { return ExprCodegenResult{String{pmr.src, 0}, String{byte~(&"0"[0]), 1}, String{byte~(&"i1"[0]), 2}, 0}; }
    return ExprCodegenResult{String{pmr.src, 0}, lex, String{byte~(&"i32"[0]), 3}, 0};
  }
  if (n.kind == NODE_GROUP) {
    return cg_expr(pmr, tm, n.a, paramNames, paramTypes, paramSlots, paramSlotTypes, localNames, localPtrs, localTypes, tmp);
  }
  if (n.kind == NODE_UNARY) {
    var op = cg_tok_string(pmr.tokens, pmr.src, n.a);
    var inner = cg_expr(pmr, tm, n.b, paramNames, paramTypes, paramSlots, paramSlotTypes, localNames, localPtrs, localTypes, tmp);
    if (inner.err == 1) { return ExprCodegenResult{inner.instr, inner.value, inner.valTy, 1}; }
    // unary + : no-op
    if (op.length == 1 && (op.data)~ == byte(43)) { return inner; } // '+'
    // logical not
    if (op.length == 1 && (op.data)~ == byte(33)) { // '!'
      var b = cg_to_bool(inner, tmp);
      if (b.err == 1) { return b; }
      var tmpNot = cg_fresh_tmp(tmp);
      var sbNot = sb_new();
      sbNot = sb_append_string(sbNot, b.instr);
      sbNot = sb_append_cstr(sbNot, byte~(&"  "[0]));
      sbNot = sb_append_string(sbNot, tmpNot);
      sbNot = sb_append_cstr(sbNot, byte~(&" = xor i1 "[0]));
      sbNot = sb_append_string(sbNot, b.value);
      sbNot = sb_append_cstr(sbNot, byte~(&", 1"[0]));
      sbNot = sb_append_byte(sbNot, byte(10));
      return ExprCodegenResult{sb_to_string(sbNot), tmpNot, String{byte~(&"i1"[0]), 2}, 0};
    }
    // bitwise not
    if (op.length == 1 && (op.data)~ == byte(126)) { // '~'
      var tyBw = inner.valTy;
      if (tyBw.length == 0) { tyBw = String{byte~(&"i32"[0]), 3}; }
      var tmpBw = cg_fresh_tmp(tmp);
      var sbBw = sb_new();
      sbBw = sb_append_string(sbBw, inner.instr);
      sbBw = sb_append_cstr(sbBw, byte~(&"  "[0]));
      sbBw = sb_append_string(sbBw, tmpBw);
      sbBw = sb_append_cstr(sbBw, byte~(&" = xor "[0]));
      sbBw = sb_append_string(sbBw, tyBw);
      sbBw = sb_append_byte(sbBw, byte(32));
      sbBw = sb_append_string(sbBw, inner.value);
      sbBw = sb_append_cstr(sbBw, byte~(&", -1"[0]));
      sbBw = sb_append_byte(sbBw, byte(10));
      return ExprCodegenResult{sb_to_string(sbBw), tmpBw, tyBw, 0};
    }
    // unary minus
    if (inner.instr.length == 0 && (inner.value.length > 0)) {
      var sbLit = sb_new();
      sbLit = sb_append_string(sbLit, op);
      sbLit = sb_append_string(sbLit, inner.value);
      return ExprCodegenResult{inner.instr, sb_to_string(sbLit), inner.valTy, 0};
    }
    var tyMinus = inner.valTy;
    if (tyMinus.length == 0) { tyMinus = String{byte~(&"i32"[0]), 3}; }
    var tmpName = cg_fresh_tmp(tmp);
    var sbInstr = sb_new();
    sbInstr = sb_append_string(sbInstr, inner.instr);
    sbInstr = sb_append_cstr(sbInstr, byte~(&"  "[0]));
    sbInstr = sb_append_string(sbInstr, tmpName);
    sbInstr = sb_append_cstr(sbInstr, byte~(&" = sub "[0]));
    sbInstr = sb_append_string(sbInstr, tyMinus);
    sbInstr = sb_append_byte(sbInstr, byte(32));
    sbInstr = sb_append_string(sbInstr, String{byte~(&"0"[0]), 1});
    sbInstr = sb_append_cstr(sbInstr, byte~(&", "[0]));
    sbInstr = sb_append_string(sbInstr, inner.value);
    sbInstr = sb_append_byte(sbInstr, byte(10));
    return ExprCodegenResult{sb_to_string(sbInstr), tmpName, tyMinus, 0};
  }
  if (n.kind == NODE_VARIABLE) {
    var name = cg_tok_string(pmr.tokens, pmr.src, n.a);
    // locals
    var li = cg_find_name(localNames, name);
    if (li != -1) {
      var ptr = vecstr_get(localPtrs, li);
      var lty = vecstr_get(localTypes, li);
      var tmpLd = cg_fresh_tmp(tmp);
      var sbLd = sb_new();
      sbLd = sb_append_cstr(sbLd, byte~(&"  "[0]));
      sbLd = sb_append_string(sbLd, tmpLd);
      sbLd = sb_append_cstr(sbLd, byte~(&" = load "[0]));
      sbLd = sb_append_string(sbLd, lty);
      sbLd = sb_append_cstr(sbLd, byte~(&", "[0]));
      sbLd = sb_append_string(sbLd, lty);
      sbLd = sb_append_cstr(sbLd, byte~(&"* "[0]));
      sbLd = sb_append_string(sbLd, ptr);
      sbLd = sb_append_byte(sbLd, byte(10));
      return ExprCodegenResult{sb_to_string(sbLd), tmpLd, lty, 0};
    }
    var idx = cg_match_param(paramNames, name);
    if (idx == -1) { return ExprCodegenResult{String{pmr.src, 0}, name, String{pmr.src, 0}, 1}; }
    var pty = String{byte~(&"i32"[0]), 3};
    if (idx < paramTypes.length) { pty = vecstr_get(paramTypes, idx); }
    var pslot = vecstr_get(paramSlots, idx);
    var tmpParam = cg_fresh_tmp(tmp);
    var sbParam = sb_new();
    sbParam = sb_append_cstr(sbParam, byte~(&"  "[0]));
    sbParam = sb_append_string(sbParam, tmpParam);
    sbParam = sb_append_cstr(sbParam, byte~(&" = load "[0]));
    sbParam = sb_append_string(sbParam, pty);
    sbParam = sb_append_cstr(sbParam, byte~(&", "[0]));
    sbParam = sb_append_string(sbParam, pty);
    sbParam = sb_append_cstr(sbParam, byte~(&"* "[0]));
    sbParam = sb_append_string(sbParam, pslot);
    sbParam = sb_append_byte(sbParam, byte(10));
    return ExprCodegenResult{sb_to_string(sbParam), tmpParam, pty, 0};
  }
  if (n.kind == NODE_BINARY) {
    var left = cg_expr(pmr, tm, n.a, paramNames, paramTypes, paramSlots, paramSlotTypes, localNames, localPtrs, localTypes, tmp);
    if (left.err == 1) { return left; }
    var right = cg_expr(pmr, tm, n.b, paramNames, paramTypes, paramSlots, paramSlotTypes, localNames, localPtrs, localTypes, tmp);
    if (right.err == 1) { return right; }
    var lTy = left.valTy;
    if (lTy.length == 0) { lTy = String{byte~(&"i32"[0]), 3}; }
    var rTy = right.valTy;
    if (rTy.length == 0) { rTy = String{byte~(&"i32"[0]), 3}; }
    var lInstr = left.instr;
    var rInstr = right.instr;
    var lVal = left.value;
    var rVal = right.value;
    var opTok = cg_tok_string(pmr.tokens, pmr.src, n.c);
    // Pointer-aware ops
    if (cg_is_pointer_type(lTy) == 1 || cg_is_pointer_type(rTy) == 1) {
      // pointer + int or int + pointer
      if (opTok.length == 1 && (opTok.data)~ == byte(43)) { // '+'
        var ptrVal = lVal;
        var idxVal = rVal;
        var ptrTy = lTy;
        var extra = String{pmr.src, 0};
        if (cg_is_pointer_type(lTy) == 0 && cg_is_pointer_type(rTy) == 1) {
          ptrVal = rVal;
          idxVal = lVal;
          ptrTy = rTy;
        } else if (cg_is_pointer_type(lTy) == 1 && cg_is_pointer_type(rTy) == 0) {
          // use as-is
        } else {
          return ExprCodegenResult{String{pmr.src, 0}, String{pmr.src, 0}, String{pmr.src, 0}, 1};
        }
        var sbp = sb_new();
        sbp = sb_append_string(sbp, lInstr);
        sbp = sb_append_string(sbp, rInstr);
        var tmpGep = cg_fresh_tmp(tmp);
        sbp = sb_append_cstr(sbp, byte~(&"  "[0]));
        sbp = sb_append_string(sbp, tmpGep);
        sbp = sb_append_cstr(sbp, byte~(&" = getelementptr i8, i8* "[0]));
        sbp = sb_append_string(sbp, ptrVal);
        sbp = sb_append_cstr(sbp, byte~(&", i32 "[0]));
        sbp = sb_append_string(sbp, idxVal);
        sbp = sb_append_byte(sbp, byte(10));
        return ExprCodegenResult{sb_to_string(sbp), tmpGep, ptrTy, 0};
      }
      // pointer - int
      if (opTok.length == 1 && (opTok.data)~ == byte(45) && cg_is_pointer_type(lTy) == 1 && cg_is_pointer_type(rTy) == 0) { // '-'
        var sbm = sb_new();
        sbm = sb_append_string(sbm, lInstr);
        sbm = sb_append_string(sbm, rInstr);
        var negIdx = cg_fresh_tmp(tmp);
        sbm = sb_append_cstr(sbm, byte~(&"  "[0]));
        sbm = sb_append_string(sbm, negIdx);
        sbm = sb_append_cstr(sbm, byte~(&" = sub i32 0, "[0]));
        sbm = sb_append_string(sbm, rVal);
        sbm = sb_append_byte(sbm, byte(10));
        var tmpGep2 = cg_fresh_tmp(tmp);
        sbm = sb_append_cstr(sbm, byte~(&"  "[0]));
        sbm = sb_append_string(sbm, tmpGep2);
        sbm = sb_append_cstr(sbm, byte~(&" = getelementptr i8, i8* "[0]));
        sbm = sb_append_string(sbm, lVal);
        sbm = sb_append_cstr(sbm, byte~(&", i32 "[0]));
        sbm = sb_append_string(sbm, negIdx);
        sbm = sb_append_byte(sbm, byte(10));
        return ExprCodegenResult{sb_to_string(sbm), tmpGep2, lTy, 0};
      }
      // pointer difference
      if (opTok.length == 1 && (opTok.data)~ == byte(45) && cg_is_pointer_type(lTy) == 1 && cg_is_pointer_type(rTy) == 1) {
        var sbDiff = sb_new();
        sbDiff = sb_append_string(sbDiff, lInstr);
        sbDiff = sb_append_string(sbDiff, rInstr);
        var ptoiL = cg_fresh_tmp(tmp);
        var ptoiR = cg_fresh_tmp(tmp);
