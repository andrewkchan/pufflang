// Stage1 Puffscript LLVM IR codegen (initial, minimal subset).
// Generates textual LLVM IR for:
// - function definitions (non-import) with simple return statements
// - return expressions composed of literals, groups, and unary minus
// - integer/byte/bool/void/float return types (float is mapped to 'float')
//
// Structured to expand over time with more statement/expression support.

struct FnCodegenResult { text String, err int }
struct ExprCodegenResult { instr String, value String, valTy String, err int }

// Map a type id from TypeTable to LLVM IR textual type.
def cg_llvm_type(tt TypeTable, typeId int) String {
  var t = typetable_get(tt, typeId);
  if (t.category == TYPECATEGORY_INT) { return String{byte~(&"i32"[0]), 3}; }
  if (t.category == TYPECATEGORY_BYTE) { return String{byte~(&"i8"[0]), 2}; }
  if (t.category == TYPECATEGORY_BOOL) { return String{byte~(&"i1"[0]), 2}; }
  if (t.category == TYPECATEGORY_VOID) { return String{byte~(&"void"[0]), 4}; }
  if (t.category == TYPECATEGORY_FLOAT) { return String{byte~(&"float"[0]), 5}; }
  // Fallback to i32 for unknown/unsupported types.
  return String{byte~(&"i32"[0]), 3};
}

// Render a token's lexeme to string.
def cg_tok_string(tokens Vec, src byte~, tokIdx int) String {
  return tok_string(tokens, tokIdx, src);
}

// String equality helper for small LLVM type names.
def cg_str_eq(a String, b String) int {
  if (a.length != b.length) { return 0; }
  var i = 0;
  while (i < a.length) {
    if ((a.data + i)~ != (b.data + i)~) { return 0; }
    i = i + 1;
  }
  return 1;
}

// Convert an expression result to i1 (non-short-circuit); appends icmp if needed.
def cg_to_bool(res ExprCodegenResult, tmp int~) ExprCodegenResult {
  if (res.err == 1) { return res; }
  if (res.valTy.length == 2 && (res.valTy.data)~ == byte(105) && (res.valTy.data + 1)~ == byte(49)) {
    return res;
  }
  var ty = res.valTy;
  if (ty.length == 0) { ty = String{byte~(&"i32"[0]), 3}; }
  var zero = String{byte~(&"0"[0]), 1};
  var tmpName = cg_fresh_tmp(tmp);
  var sb = sb_new();
  sb = sb_append_string(sb, res.instr);
  sb = sb_append_cstr(sb, byte~(&"  "[0]));
  sb = sb_append_string(sb, tmpName);
  sb = sb_append_cstr(sb, byte~(&" = icmp ne "[0]));
  sb = sb_append_string(sb, ty);
  sb = sb_append_byte(sb, byte(32));
  sb = sb_append_string(sb, res.value);
  sb = sb_append_cstr(sb, byte~(&", "[0]));
  sb = sb_append_string(sb, zero);
  sb = sb_append_byte(sb, byte(10));
  return ExprCodegenResult{sb_to_string(sb), tmpName, String{byte~(&"i1"[0]), 2}, 0};
}

// Collect parameter names from function tokens (best-effort).
def cg_collect_param_names(pmr ParseModuleResult, fn Node) VecStr {
  var names = vecstr_new(4);
  var idx = fn.b;
  var collected = 0;
  while (idx < pmr.tokens.length && collected < fn.d) {
    var k = token_kind_at(pmr.tokens, idx);
    if (k == TOKEN_IDENTIFIER) {
      var s = tok_string(pmr.tokens, idx, pmr.src);
      names = vecstr_push(names, s);
      collected = collected + 1;
    }
    if (k == TOKEN_RIGHT_PAREN) { break; }
    idx = idx + 1;
  }
  return names;
}

def cg_match_param(params VecStr, name String) int {
  var i = 0;
  while (i < params.length) {
    var p = vecstr_get(params, i);
    if (str_eq(p.data, p.length, name.data, name.length) == 1) { return i; }
    i = i + 1;
  }
  return -1;
}

def cg_fresh_tmp(counter int~) String {
  var sb = sb_new();
  sb = sb_append_byte(sb, byte(37)); // '%'
  sb = sb_append_cstr(sb, byte~(&"t"[0]));
  sb = sb_append_int(sb, counter~);
  counter~ = counter~ + 1;
  return sb_to_string(sb);
}

// Find function index in tm by name (first match).
def cg_find_fn_index(pmr ParseModuleResult, tm TypeModuleTypes, name String) int {
  var i = 0;
  while (i < pmr.meta.fnNodeIndex.length) {
    var fnIdx = vecint_get(pmr.meta.fnNodeIndex, i);
    var fnNode = nodearena_get(pmr.arena, fnIdx);
    var fnName = tok_string(pmr.tokens, fnNode.c, pmr.src);
    if (str_eq(fnName.data, fnName.length, name.data, name.length) == 1) { return i; }
    i = i + 1;
  }
  return -1;
}

// Emit simple expressions (literal, group, unary -, parameter variable, binary +,-,*,/, call).
// Returns accumulated instructions (in order) and the SSA value to use.
def cg_expr(pmr ParseModuleResult, tm TypeModuleTypes, exprIdx int, paramNames VecStr, paramTypes VecStr, tmp int~) ExprCodegenResult {
  if (exprIdx < 0 || exprIdx >= pmr.arena.nodes.length) { return ExprCodegenResult{String{pmr.src, 0}, String{pmr.src, 0}, String{pmr.src, 0}, 1}; }
  var n = nodearena_get(pmr.arena, exprIdx);
  if (n.kind == NODE_LITERAL) {
    var lex = cg_tok_string(pmr.tokens, pmr.src, n.a);
    var tk = token_kind_at(pmr.tokens, n.a);
    if (tk == TOKEN_TRUE) { return ExprCodegenResult{String{pmr.src, 0}, String{byte~(&"1"[0]), 1}, String{byte~(&"i1"[0]), 2}, 0}; }
    if (tk == TOKEN_FALSE) { return ExprCodegenResult{String{pmr.src, 0}, String{byte~(&"0"[0]), 1}, String{byte~(&"i1"[0]), 2}, 0}; }
    return ExprCodegenResult{String{pmr.src, 0}, lex, String{byte~(&"i32"[0]), 3}, 0};
  }
  if (n.kind == NODE_GROUP) {
    return cg_expr(pmr, tm, n.a, paramNames, paramTypes, tmp);
  }
  if (n.kind == NODE_UNARY) {
    var op = cg_tok_string(pmr.tokens, pmr.src, n.a);
    var inner = cg_expr(pmr, tm, n.b, paramNames, paramTypes, tmp);
    if (inner.err == 1) { return ExprCodegenResult{inner.instr, inner.value, inner.valTy, 1}; }
    // If operand is a literal constant, inline.
    if (inner.instr.length == 0 && (inner.value.length > 0)) {
      var sbLit = sb_new();
      sbLit = sb_append_string(sbLit, op);
      sbLit = sb_append_string(sbLit, inner.value);
      return ExprCodegenResult{inner.instr, sb_to_string(sbLit), inner.valTy, 0};
    }
    var tmpName = cg_fresh_tmp(tmp);
    var sbInstr = sb_new();
    sbInstr = sb_append_string(sbInstr, inner.instr);
    sbInstr = sb_append_cstr(sbInstr, byte~(&"  "[0]));
    sbInstr = sb_append_string(sbInstr, tmpName);
    sbInstr = sb_append_cstr(sbInstr, byte~(&" = sub i32 0, "[0]));
    sbInstr = sb_append_string(sbInstr, inner.value);
    sbInstr = sb_append_byte(sbInstr, byte(10));
    return ExprCodegenResult{sb_to_string(sbInstr), tmpName, inner.valTy, 0};
  }
  if (n.kind == NODE_VARIABLE) {
    var name = cg_tok_string(pmr.tokens, pmr.src, n.a);
    var idx = cg_match_param(paramNames, name);
    if (idx == -1) { return ExprCodegenResult{String{pmr.src, 0}, name, String{pmr.src, 0}, 1}; }
    var sbVar = sb_new();
    sbVar = sb_append_byte(sbVar, byte(37)); // '%'
    sbVar = sb_append_cstr(sbVar, byte~(&"p"[0]));
    sbVar = sb_append_int(sbVar, idx);
    var pty = String{byte~(&"i32"[0]), 3};
    if (idx < paramTypes.length) { pty = vecstr_get(paramTypes, idx); }
    return ExprCodegenResult{String{pmr.src, 0}, sb_to_string(sbVar), pty, 0};
  }
  if (n.kind == NODE_BINARY) {
    var left = cg_expr(pmr, tm, n.a, paramNames, paramTypes, tmp);
    if (left.err == 1) { return left; }
    var right = cg_expr(pmr, tm, n.b, paramNames, paramTypes, tmp);
    if (right.err == 1) { return right; }
    var opTok = cg_tok_string(pmr.tokens, pmr.src, n.c);
    var op = opTok;
    var tmpName2 = cg_fresh_tmp(tmp);
    var sbInstr2 = sb_new();
    sbInstr2 = sb_append_string(sbInstr2, left.instr);
    sbInstr2 = sb_append_string(sbInstr2, right.instr);
    sbInstr2 = sb_append_cstr(sbInstr2, byte~(&"  "[0]));
    sbInstr2 = sb_append_string(sbInstr2, tmpName2);
    // Map operator to LLVM mnemonic (limited set)
    var resultTy = left.valTy;
    if (resultTy.length == 0) { resultTy = String{byte~(&"i32"[0]), 3}; }
    // Map operator to LLVM mnemonic (extended set)
    if (op.length == 1 && (op.data)~ == byte(43)) { // '+'
      sbInstr2 = sb_append_cstr(sbInstr2, byte~(&" = add "[0]));
      sbInstr2 = sb_append_string(sbInstr2, resultTy);
      sbInstr2 = sb_append_byte(sbInstr2, byte(32));
    } else if (op.length == 1 && (op.data)~ == byte(45)) { // '-'
      sbInstr2 = sb_append_cstr(sbInstr2, byte~(&" = sub "[0]));
      sbInstr2 = sb_append_string(sbInstr2, resultTy);
      sbInstr2 = sb_append_byte(sbInstr2, byte(32));
    } else if (op.length == 1 && (op.data)~ == byte(42)) { // '*'
      sbInstr2 = sb_append_cstr(sbInstr2, byte~(&" = mul "[0]));
      sbInstr2 = sb_append_string(sbInstr2, resultTy);
      sbInstr2 = sb_append_byte(sbInstr2, byte(32));
    } else if (op.length == 1 && (op.data)~ == byte(47)) { // '/'
      sbInstr2 = sb_append_cstr(sbInstr2, byte~(&" = sdiv "[0]));
      sbInstr2 = sb_append_string(sbInstr2, resultTy);
      sbInstr2 = sb_append_byte(sbInstr2, byte(32));
    } else if (op.length == 1 && (op.data)~ == byte(37)) { // '%'
      sbInstr2 = sb_append_cstr(sbInstr2, byte~(&" = srem "[0]));
      sbInstr2 = sb_append_string(sbInstr2, resultTy);
      sbInstr2 = sb_append_byte(sbInstr2, byte(32));
    } else if (op.length == 2 && (op.data)~ == byte(60) && (op.data + 1)~ == byte(60)) { // "<<"
      sbInstr2 = sb_append_cstr(sbInstr2, byte~(&" = shl "[0]));
      sbInstr2 = sb_append_string(sbInstr2, resultTy);
      sbInstr2 = sb_append_byte(sbInstr2, byte(32));
    } else if (op.length == 2 && (op.data)~ == byte(62) && (op.data + 1)~ == byte(62)) { // ">>"
      sbInstr2 = sb_append_cstr(sbInstr2, byte~(&" = ashr "[0]));
      sbInstr2 = sb_append_string(sbInstr2, resultTy);
      sbInstr2 = sb_append_byte(sbInstr2, byte(32));
    } else if (op.length == 1 && (op.data)~ == byte(38)) { // '&'
      sbInstr2 = sb_append_cstr(sbInstr2, byte~(&" = and "[0]));
      sbInstr2 = sb_append_string(sbInstr2, resultTy);
      sbInstr2 = sb_append_byte(sbInstr2, byte(32));
    } else if (op.length == 1 && (op.data)~ == byte(124)) { // '|'
      sbInstr2 = sb_append_cstr(sbInstr2, byte~(&" = or "[0]));
      sbInstr2 = sb_append_string(sbInstr2, resultTy);
      sbInstr2 = sb_append_byte(sbInstr2, byte(32));
    } else if (op.length == 1 && (op.data)~ == byte(94)) { // '^'
      sbInstr2 = sb_append_cstr(sbInstr2, byte~(&" = xor "[0]));
      sbInstr2 = sb_append_string(sbInstr2, resultTy);
      sbInstr2 = sb_append_byte(sbInstr2, byte(32));
    } else if (op.length == 2 && (op.data)~ == byte(61) && (op.data + 1)~ == byte(61)) { // "=="
      resultTy = String{byte~(&"i1"[0]), 2};
      sbInstr2 = sb_append_cstr(sbInstr2, byte~(&" = icmp eq "[0]));
      sbInstr2 = sb_append_string(sbInstr2, left.valTy.length == 0 ? String{byte~(&"i32"[0]), 3} : left.valTy);
      sbInstr2 = sb_append_byte(sbInstr2, byte(32));
    } else if (op.length == 2 && (op.data)~ == byte(33) && (op.data + 1)~ == byte(61)) { // "!="
      resultTy = String{byte~(&"i1"[0]), 2};
      sbInstr2 = sb_append_cstr(sbInstr2, byte~(&" = icmp ne "[0]));
      sbInstr2 = sb_append_string(sbInstr2, left.valTy.length == 0 ? String{byte~(&"i32"[0]), 3} : left.valTy);
      sbInstr2 = sb_append_byte(sbInstr2, byte(32));
    } else if (op.length == 1 && (op.data)~ == byte(60)) { // '<'
      resultTy = String{byte~(&"i1"[0]), 2};
      sbInstr2 = sb_append_cstr(sbInstr2, byte~(&" = icmp slt "[0]));
      sbInstr2 = sb_append_string(sbInstr2, left.valTy.length == 0 ? String{byte~(&"i32"[0]), 3} : left.valTy);
      sbInstr2 = sb_append_byte(sbInstr2, byte(32));
    } else if (op.length == 2 && (op.data)~ == byte(60) && (op.data + 1)~ == byte(61)) { // "<="
      resultTy = String{byte~(&"i1"[0]), 2};
      sbInstr2 = sb_append_cstr(sbInstr2, byte~(&" = icmp sle "[0]));
      sbInstr2 = sb_append_string(sbInstr2, left.valTy.length == 0 ? String{byte~(&"i32"[0]), 3} : left.valTy);
      sbInstr2 = sb_append_byte(sbInstr2, byte(32));
    } else if (op.length == 1 && (op.data)~ == byte(62)) { // '>'
      resultTy = String{byte~(&"i1"[0]), 2};
      sbInstr2 = sb_append_cstr(sbInstr2, byte~(&" = icmp sgt "[0]));
      sbInstr2 = sb_append_string(sbInstr2, left.valTy.length == 0 ? String{byte~(&"i32"[0]), 3} : left.valTy);
      sbInstr2 = sb_append_byte(sbInstr2, byte(32));
    } else if (op.length == 2 && (op.data)~ == byte(62) && (op.data + 1)~ == byte(61)) { // ">="
      resultTy = String{byte~(&"i1"[0]), 2};
      sbInstr2 = sb_append_cstr(sbInstr2, byte~(&" = icmp sge "[0]));
      sbInstr2 = sb_append_string(sbInstr2, left.valTy.length == 0 ? String{byte~(&"i32"[0]), 3} : left.valTy);
      sbInstr2 = sb_append_byte(sbInstr2, byte(32));
    } else {
      return ExprCodegenResult{sb_to_string(sbInstr2), tmpName2, String{pmr.src, 0}, 1};
    }
    sbInstr2 = sb_append_string(sbInstr2, left.value);
    sbInstr2 = sb_append_cstr(sbInstr2, byte~(&", "[0]));
    sbInstr2 = sb_append_string(sbInstr2, right.value);
    sbInstr2 = sb_append_byte(sbInstr2, byte(10));
    return ExprCodegenResult{sb_to_string(sbInstr2), tmpName2, resultTy, 0};
  }
  if (n.kind == NODE_LOGICAL) {
    var left = cg_expr(pmr, tm, n.a, paramNames, paramTypes, tmp);
    var lbool = cg_to_bool(left, tmp);
    if (lbool.err == 1) { return lbool; }
    var right = cg_expr(pmr, tm, n.b, paramNames, paramTypes, tmp);
    var rbool = cg_to_bool(right, tmp);
    if (rbool.err == 1) { return rbool; }
    var opTok2 = cg_tok_string(pmr.tokens, pmr.src, n.c);
    var tmpLogic = cg_fresh_tmp(tmp);
    var sbLogic = sb_new();
    sbLogic = sb_append_string(sbLogic, lbool.instr);
    sbLogic = sb_append_string(sbLogic, rbool.instr);
    sbLogic = sb_append_cstr(sbLogic, byte~(&"  "[0]));
    sbLogic = sb_append_string(sbLogic, tmpLogic);
    if (opTok2.length == 2 && (opTok2.data)~ == byte(38) && (opTok2.data + 1)~ == byte(38)) { // &&
      sbLogic = sb_append_cstr(sbLogic, byte~(&" = and i1 "[0]));
    } else if (opTok2.length == 2 && (opTok2.data)~ == byte(124) && (opTok2.data + 1)~ == byte(124)) { // ||
      sbLogic = sb_append_cstr(sbLogic, byte~(&" = or i1 "[0]));
    } else {
      return ExprCodegenResult{sb_to_string(sbLogic), tmpLogic, String{pmr.src, 0}, 1};
    }
    sbLogic = sb_append_string(sbLogic, lbool.value);
    sbLogic = sb_append_cstr(sbLogic, byte~(&", "[0]));
    sbLogic = sb_append_string(sbLogic, rbool.value);
    sbLogic = sb_append_byte(sbLogic, byte(10));
    return ExprCodegenResult{sb_to_string(sbLogic), tmpLogic, String{byte~(&"i1"[0]), 2}, 0};
  }
  if (n.kind == NODE_TERNARY) {
    var condRes = cg_expr(pmr, tm, n.a, paramNames, paramTypes, tmp);
    var condBool = cg_to_bool(condRes, tmp);
    if (condBool.err == 1) { return condBool; }
    var thenRes = cg_expr(pmr, tm, n.b, paramNames, paramTypes, tmp);
    if (thenRes.err == 1) { return thenRes; }
    var elseRes = cg_expr(pmr, tm, n.c, paramNames, paramTypes, tmp);
    if (elseRes.err == 1) { return elseRes; }
    var tyThen = thenRes.valTy;
    var tyElse = elseRes.valTy;
    if (tyThen.length == 0) { tyThen = String{byte~(&"i32"[0]), 3}; }
    if (tyElse.length == 0) { tyElse = String{byte~(&"i32"[0]), 3}; }
    if (cg_str_eq(tyThen, tyElse) == 0) { return ExprCodegenResult{String{pmr.src, 0}, String{pmr.src, 0}, String{pmr.src, 0}, 1}; }
    var tmpTern = cg_fresh_tmp(tmp);
    var sbTern = sb_new();
    sbTern = sb_append_string(sbTern, condBool.instr);
    sbTern = sb_append_string(sbTern, thenRes.instr);
    sbTern = sb_append_string(sbTern, elseRes.instr);
    sbTern = sb_append_cstr(sbTern, byte~(&"  "[0]));
    sbTern = sb_append_string(sbTern, tmpTern);
    sbTern = sb_append_cstr(sbTern, byte~(&" = select i1 "[0]));
    sbTern = sb_append_string(sbTern, condBool.value);
    sbTern = sb_append_cstr(sbTern, byte~(&", "[0]));
    sbTern = sb_append_string(sbTern, tyThen);
    sbTern = sb_append_byte(sbTern, byte(32));
    sbTern = sb_append_string(sbTern, thenRes.value);
    sbTern = sb_append_cstr(sbTern, byte~(&", "[0]));
    sbTern = sb_append_string(sbTern, tyElse);
    sbTern = sb_append_byte(sbTern, byte(32));
    sbTern = sb_append_string(sbTern, elseRes.value);
    sbTern = sb_append_byte(sbTern, byte(10));
    return ExprCodegenResult{sb_to_string(sbTern), tmpTern, tyThen, 0};
  }
  if (n.kind == NODE_CALL) {
    // Only support direct identifier callees for now.
    var calleeNode = nodearena_get(pmr.arena, n.a);
    if (calleeNode.kind != NODE_VARIABLE) { return ExprCodegenResult{String{pmr.src, 0}, String{pmr.src, 0}, String{pmr.src, 0}, 1}; }
    var name = cg_tok_string(pmr.tokens, pmr.src, calleeNode.a);
    var fi = cg_find_fn_index(pmr, tm, name);
    if (fi == -1) { return ExprCodegenResult{String{pmr.src, 0}, name, String{pmr.src, 0}, 1}; }
    var retId = tm_fn_return_type(tm, fi);
    var retTy = cg_llvm_type(tm.env.tt, retId);
    var paramCount = tm_fn_param_count(tm, fi);
    if (paramCount != n.c) { return ExprCodegenResult{String{pmr.src, 0}, name, retTy, 1}; }
    // Evaluate arguments
    var argInstr = sb_new();
    var argVals = sb_new();
    var argCount = n.c;
    var head = n.b;
    var idx = 0;
    while (head != -1 && idx < argCount) {
      var argNode = nodearena_get(pmr.arena, head);
      var argRes = cg_expr(pmr, tm, argNode.a, paramNames, paramTypes, tmp);
      if (argRes.err == 1) { return argRes; }
      argInstr = sb_append_string(argInstr, argRes.instr);
      if (idx > 0) { argVals = sb_append_cstr(argVals, byte~(&", "[0])); }
      var paramTyId = tm_fn_param_type(tm, fi, idx);
      if (paramTyId == -1) { paramTyId = 5; } // default int
      var paramTy = cg_llvm_type(tm.env.tt, paramTyId);
      argVals = sb_append_string(argVals, paramTy);
      argVals = sb_append_byte(argVals, byte(32));
      argVals = sb_append_string(argVals, argRes.value);
      head = argNode.b;
      idx = idx + 1;
    }
    var tmpName3 = cg_fresh_tmp(tmp);
    var sbCall = sb_new();
    sbCall = sb_append_string(sbCall, sb_to_string(argInstr));
    sbCall = sb_append_cstr(sbCall, byte~(&"  "[0]));
    if (retTy.length == 4 && (retTy.data)~ == byte(118)) {
      // void return
      sbCall = sb_append_cstr(sbCall, byte~(&"call void "[0]));
      sbCall = sb_append_byte(sbCall, byte(64));
      sbCall = sb_append_string(sbCall, name);
      sbCall = sb_append_byte(sbCall, byte(40)); // (
      sbCall = sb_append_string(sbCall, sb_to_string(argVals));
      sbCall = sb_append_byte(sbCall, byte(41)); // )
      sbCall = sb_append_byte(sbCall, byte(10));
      return ExprCodegenResult{sb_to_string(sbCall), String{pmr.src, 0}, retTy, 0};
    } else {
      sbCall = sb_append_string(sbCall, tmpName3);
      sbCall = sb_append_cstr(sbCall, byte~(&" = call "[0]));
      sbCall = sb_append_string(sbCall, retTy);
      sbCall = sb_append_byte(sbCall, byte(32));
      sbCall = sb_append_byte(sbCall, byte(64));
      sbCall = sb_append_string(sbCall, name);
      sbCall = sb_append_byte(sbCall, byte(40)); // (
      sbCall = sb_append_string(sbCall, sb_to_string(argVals));
      sbCall = sb_append_byte(sbCall, byte(41)); // )
      sbCall = sb_append_byte(sbCall, byte(10));
      return ExprCodegenResult{sb_to_string(sbCall), tmpName3, retTy, 0};
    }
  }
  // Unsupported expression kinds for now.
  return ExprCodegenResult{String{pmr.src, 0}, String{pmr.src, 0}, String{pmr.src, 0}, 1};
}

// Generate LLVM IR for a single function node.
// Supports bodies with return statements containing simple expressions.
def cg_function(pmr ParseModuleResult, tm TypeModuleTypes, fn Node, fi int) FnCodegenResult {
  var retId = tm_fn_return_type(tm, fi);
  var retTy = cg_llvm_type(tm.env.tt, retId);
  var name = tok_string(pmr.tokens, fn.c, pmr.src);

  var paramNames = cg_collect_param_names(pmr, fn);
  var paramTypes = vecstr_new(4);
  var paramStartT = tm_fn_param_type_start(tm, fi);
  var paramCountT = tm_fn_param_count(tm, fi);
  var pti = 0;
  while (pti < paramCountT) {
    var pidT = vecint_get(tm.paramTypeIds, paramStartT + pti);
    var ptyT = cg_llvm_type(tm.env.tt, pidT);
    paramTypes = vecstr_push(paramTypes, ptyT);
    pti = pti + 1;
  }
  var tmp int = 0;

  var sb = sb_new();
  // Function header
  sb = sb_append_cstr(sb, byte~(&"define "[0]));
  sb = sb_append_string(sb, retTy);
  sb = sb_append_byte(sb, byte(32)); // space
  sb = sb_append_byte(sb, byte(64)); // '@'
  sb = sb_append_string(sb, name);
  sb = sb_append_byte(sb, byte(40)); // '('

  var paramStart = tm_fn_param_type_start(tm, fi);
  var paramCount = tm_fn_param_count(tm, fi);
  var pi = 0;
  while (pi < paramCount) {
    var pid = vecint_get(tm.paramTypeIds, paramStart + pi);
    var pty = cg_llvm_type(tm.env.tt, pid);
    if (pi > 0) { sb = sb_append_cstr(sb, byte~(&", "[0])); }
    sb = sb_append_string(sb, pty);
    // Name parameters as %pN
    sb = sb_append_byte(sb, byte(32));
    sb = sb_append_byte(sb, byte(37)); // '%'
    sb = sb_append_cstr(sb, byte~(&"p"[0]));
    sb = sb_append_int(sb, pi);
    pi = pi + 1;
  }
  sb = sb_append_byte(sb, byte(41)); // ')'
  sb = sb_append_byte(sb, byte(32));
  sb = sb_append_byte(sb, byte(123)); // '{'
  sb = sb_append_byte(sb, byte(10));
  sb = sb_append_cstr(sb, byte~(&"entry:"[0]));
  sb = sb_append_byte(sb, byte(10));

  // Imported functions: emit a minimal body returning zero/void.
  if (fn.typeId == 1 || fn.a == -1) {
    if (retTy.length == 4 && (retTy.data)~ == byte(118)) { // "void"
      sb = sb_append_cstr(sb, byte~(&"  ret void"[0]));
    } else {
      sb = sb_append_cstr(sb, byte~(&"  ret "[0]));
      sb = sb_append_string(sb, retTy);
      sb = sb_append_byte(sb, byte(32));
      sb = sb_append_byte(sb, byte(48)); // '0'
    }
    sb = sb_append_byte(sb, byte(10));
    sb = sb_append_byte(sb, byte(125));
    sb = sb_append_byte(sb, byte(10));
    return FnCodegenResult{sb_to_string(sb), 0};
  }

  // Body: expect a block node at fn.a
  var body = nodearena_get(pmr.arena, fn.a);
  var start = body.a;
  var end = body.a + body.b;
  var emittedRet = 0;
  var i = start;
  while (i < end) {
    var stmt = nodearena_get(pmr.arena, i);
    if (stmt.kind == NODE_RETURN) {
      if (retTy.length == 4 && (retTy.data)~ == byte(118)) { // "void"
        sb = sb_append_cstr(sb, byte~(&"  ret void"[0]));
        sb = sb_append_byte(sb, byte(10));
        emittedRet = 1;
        break;
      }
      var exprRes = cg_expr(pmr, tm, stmt.a, paramNames, paramTypes, &tmp);
      if (exprRes.err == 1) { return FnCodegenResult{sb_to_string(sb), 1}; }
      var retValName = exprRes.value;
      var retValTy = exprRes.valTy;
      // Insert widening i1 -> i32 if needed.
      if (cg_str_eq(retValTy, retTy) == 0 && retValTy.length > 0 && retTy.length > 0) {
        // Only handle i1 -> i32 conversion for now.
        if (retValTy.length == 2 && (retValTy.data)~ == byte(105) && (retValTy.data + 1)~ == byte(49) && retTy.length == 3 && (retTy.data)~ == byte(105) && (retTy.data + 1)~ == byte(51)) {
          var convTmp = cg_fresh_tmp(&tmp);
          sb = sb_append_string(sb, exprRes.instr);
          sb = sb_append_cstr(sb, byte~(&"  "[0]));
          sb = sb_append_string(sb, convTmp);
          sb = sb_append_cstr(sb, byte~(&" = zext i1 "[0]));
          sb = sb_append_string(sb, retValName);
          sb = sb_append_cstr(sb, byte~(&" to i32"[0]));
          sb = sb_append_byte(sb, byte(10));
          retValName = convTmp;
          retValTy = retTy;
        } else {
          return FnCodegenResult{sb_to_string(sb), 1};
        }
      } else {
        sb = sb_append_string(sb, exprRes.instr);
      }
      sb = sb_append_cstr(sb, byte~(&"  ret "[0]));
      sb = sb_append_string(sb, retTy);
      sb = sb_append_byte(sb, byte(32));
      sb = sb_append_string(sb, retValName);
      sb = sb_append_byte(sb, byte(10));
      emittedRet = 1;
      break;
    }
    // For now, ignore other statement kinds gracefully.
    i = i + 1;
  }
  if (emittedRet == 0) {
    if (retTy.length == 4 && (retTy.data)~ == byte(118)) {
      sb = sb_append_cstr(sb, byte~(&"  ret void"[0]));
    } else {
      sb = sb_append_cstr(sb, byte~(&"  ret "[0]));
      sb = sb_append_string(sb, retTy);
      sb = sb_append_byte(sb, byte(32));
      sb = sb_append_byte(sb, byte(48)); // '0'
    }
    sb = sb_append_byte(sb, byte(10));
  }

  sb = sb_append_byte(sb, byte(125)); // '}'
  sb = sb_append_byte(sb, byte(10));
  return FnCodegenResult{sb_to_string(sb), 0};
}

// Emit declarations for imported functions.
def cg_function_decl(pmr ParseModuleResult, tm TypeModuleTypes, fn Node, fi int) FnCodegenResult {
  var retId = tm_fn_return_type(tm, fi);
  var retTy = cg_llvm_type(tm.env.tt, retId);
  var name = tok_string(pmr.tokens, fn.c, pmr.src);
  var sb = sb_new();
  sb = sb_append_cstr(sb, byte~(&"declare "[0]));
  sb = sb_append_string(sb, retTy);
  sb = sb_append_byte(sb, byte(32));
  sb = sb_append_byte(sb, byte(64));
  sb = sb_append_string(sb, name);
  sb = sb_append_byte(sb, byte(40)); // '('
  var paramStart = tm_fn_param_type_start(tm, fi);
  var paramCount = tm_fn_param_count(tm, fi);
  var pi = 0;
  while (pi < paramCount) {
    var pid = vecint_get(tm.paramTypeIds, paramStart + pi);
    var pty = cg_llvm_type(tm.env.tt, pid);
    if (pi > 0) { sb = sb_append_cstr(sb, byte~(&", "[0])); }
    sb = sb_append_string(sb, pty);
    pi = pi + 1;
  }
  sb = sb_append_byte(sb, byte(41)); // ')'
  sb = sb_append_byte(sb, byte(10));
  return FnCodegenResult{sb_to_string(sb), 0};
}

// Module-level codegen entry.
def codegen_module(pmr ParseModuleResult, tm TypeModuleTypes) String {
  var sb = sb_new();

  // Emit imported function declarations first.
  var fi = 0;
  while (fi < pmr.meta.fnNodeIndex.length) {
    var fnIdx = vecint_get(pmr.meta.fnNodeIndex, fi);
    var fn = nodearena_get(pmr.arena, fnIdx);
    if (fn.typeId == 1 || fn.a == -1) {
      var decl = cg_function_decl(pmr, tm, fn, fi);
      if (decl.err == 1) { return String{pmr.src, 0}; }
      sb = sb_append_string(sb, decl.text);
    }
    fi = fi + 1;
  }

  // Emit definitions.
  fi = 0;
  while (fi < pmr.meta.fnNodeIndex.length) {
    var fnIdx2 = vecint_get(pmr.meta.fnNodeIndex, fi);
    var fn2 = nodearena_get(pmr.arena, fnIdx2);
    if (fn2.typeId == 1 || fn2.a == -1) {
      fi = fi + 1;
      continue;
    }
    var fnDef = cg_function(pmr, tm, fn2, fi);
    if (fnDef.err == 1) { return String{pmr.src, 0}; }
    sb = sb_append_string(sb, fnDef.text);
    fi = fi + 1;
  }

  return sb_to_string(sb);
}

// Legacy stub preserved for compatibility with existing call sites.
def codegen_simple(ok int) int {
  if (ok == 1) { return 1; }
  return 0;
}
