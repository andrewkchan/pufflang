// Type rules helpers for Stage1 (operand/result typing for binary ops).
// Depends on stage1/types.puff for TypeTable utilities.

// Operator codes (small subset aligned to arithmetic/comparison use).
var OP_ADD int = 1;
var OP_SUB int = 2;
var OP_MUL int = 3;
var OP_DIV int = 4;
var OP_MOD int = 5;
var OP_BIT_AND int = 6;
var OP_BIT_OR int = 7;
var OP_BIT_XOR int = 8;
var OP_SHL int = 9;
var OP_SHR int = 10;

var OP_EQ int = 10;
var OP_NE int = 11;
var OP_LT int = 12;
var OP_LE int = 13;
var OP_GT int = 14;
var OP_GE int = 15;
var OP_ANDAND int = 16;
var OP_OROR int = 17;

var UOP_NEG int = 20;
var UOP_NOT int = 21;
var UOP_DEREF int = 22;

def is_integral(tt TypeTable, id int) int {
  var c = typetable_get(tt, id).category;
  if (c == TYPECATEGORY_INT) { return 1; }
  if (c == TYPECATEGORY_BYTE) { return 1; }
  return 0;
}

// Arithmetic result type inference.
// Returns resulting type id, or -1 if the operand combination is invalid.
def type_binary_arith_result(tt TypeTable, left int, right int, op int) int {
  var catL = typetable_get(tt, left).category;
  var catR = typetable_get(tt, right).category;

  var isNumL = type_is_numeric(tt, left);
  var isNumR = type_is_numeric(tt, right);

  // numeric ops
  if (isNumL == 1 && isNumR == 1) {
    var res = type_lowest_common_numeric(tt, left, right);
    if (op == OP_MOD) {
      // disallow modulo on float
      if (typetable_get(tt, res).category == TYPECATEGORY_FLOAT) { return -1; }
    }
    return res;
  }

  // pointer arithmetic (add/sub with integer)
  if (catL == TYPECATEGORY_POINTER && isNumR == 1) {
    if (op == OP_ADD || op == OP_SUB) { return left; }
  }
  if (catR == TYPECATEGORY_POINTER && isNumL == 1) {
    if (op == OP_ADD) { return right; } // only addition commutes
  }

  // pointer difference -> int (only if same element)
  if (catL == TYPECATEGORY_POINTER && catR == TYPECATEGORY_POINTER && op == OP_SUB) {
    if (type_equals(tt, typetable_get(tt, left).element, typetable_get(tt, right).element) == 1) {
      return 5; // int id
    }
  }

  return -1;
}

// Bitwise (&, |, ^) result typing. Only integral operands allowed.
// Returns int/byte via lowest common numeric (default int), or -1 on invalid.
def type_binary_bitwise_result(tt TypeTable, left int, right int, op int) int {
  if (is_integral(tt, left) == 1 && is_integral(tt, right) == 1) {
    var res = type_lowest_common_numeric(tt, left, right);
    if (res == -1) { res = 5; } // default to int
    return res;
  }
  return -1;
}

// Shift (<<, >>) result typing. Only integral operands allowed; result is
// lowest common numeric (default int).
def type_binary_shift_result(tt TypeTable, left int, right int, op int) int {
  if (is_integral(tt, left) == 1 && is_integral(tt, right) == 1) {
    var res = type_lowest_common_numeric(tt, left, right);
    if (res == -1) { res = 5; }
    return res;
  }
  return -1;
}

// Logical (&&, ||) result typing. Operands must be bool or numeric (coercible
// to bool); result is bool id.
def type_binary_logical_result(tt TypeTable, left int, right int, op int) int {
  var okLeft = 0;
  if (type_is_numeric(tt, left) == 1) { okLeft = 1; }
  else if (typetable_get(tt, left).category == TYPECATEGORY_BOOL) { okLeft = 1; }
  var okRight = 0;
  if (type_is_numeric(tt, right) == 1) { okRight = 1; }
  else if (typetable_get(tt, right).category == TYPECATEGORY_BOOL) { okRight = 1; }
  if (okLeft == 1 && okRight == 1) { return 1; }
  return -1;
}

// Comparison result: returns bool type id on success, -1 on invalid.
def type_binary_compare_result(tt TypeTable, left int, right int, op int) int {
  var catL = typetable_get(tt, left).category;
  var catR = typetable_get(tt, right).category;
  var boolId = 1;

  // numeric comparisons (all ops)
  if (type_is_numeric(tt, left) == 1 && type_is_numeric(tt, right) == 1) {
    return boolId;
  }
  // pointer comparisons (eq/ne/rel)
  if (catL == TYPECATEGORY_POINTER && catR == TYPECATEGORY_POINTER) {
    return boolId;
  }
  // bool equality/inequality
  if (catL == TYPECATEGORY_BOOL && catR == TYPECATEGORY_BOOL) {
    return boolId;
  }
  return -1;
}

// Unary result typing. Returns resulting type id, or -1 on invalid.
def type_unary_result(tt TypeTable, operand int, op int) int {
  var t = typetable_get(tt, operand);
  if (op == UOP_NEG) {
    if (type_is_numeric(tt, operand) == 1) { return operand; }
    return -1;
  }
  if (op == UOP_NOT) {
    if (type_is_numeric(tt, operand) == 1) { return 1; } // bool
    if (t.category == TYPECATEGORY_BOOL) { return 1; }
    return -1;
  }
  if (op == UOP_DEREF) {
    if (t.category == TYPECATEGORY_POINTER) {
      return t.element;
    }
    return -1;
  }
  return -1;
}
